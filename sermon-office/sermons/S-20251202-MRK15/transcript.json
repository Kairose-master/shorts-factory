  {
   "text": "더 지체 말고 받으라.주의",
   "startMs": "161560",
   "endMs": "172200",
   "startTimeText": "2:41"
  },
  {
   "text": "은혜우리의 죄를 다시 선네.",
   "startMs": "169560",
