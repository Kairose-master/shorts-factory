   "endMs": "55660",
   "startTimeText": "0:47"
  },
  {
   "text": "내 구주",
   "startMs": "53600",
   "endMs": "55960",
   "startTimeText": "0:53"
  },
  {
   "text": "[박수]",
   "startMs": "55660",
   "endMs": "57680",
   "startTimeText": "0:55"
  },
  {
   "text": "[음악]",
   "startMs": "55960",
   "endMs": "60680",
   "startTimeText": "0:55"
  },
  {
   "text": "예수여 날",
