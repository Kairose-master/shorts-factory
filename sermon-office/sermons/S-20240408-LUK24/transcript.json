   "endMs": "948720",
   "startTimeText": "15:44"
  },
  {
   "text": "그분을",
   "startMs": "947120",
   "endMs": "951560",
   "startTimeText": "15:47"
  },
  {
   "text": "사랑해라라는 것을 강조하는",
