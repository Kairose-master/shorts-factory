   "endMs": "62519",
   "startTimeText": "0:57"
  },
  {
   "text": "원하신",
   "startMs": "60680",
   "endMs": "66839",
   "startTimeText": "1:00"
  },
  {
   "text": "예수를 일평생",
   "startMs": "62519",
   "endMs": "66839",
   "startTimeText": "1:02"
  },
  {
   "text": "의지하오니 날",
   "startMs": "67600",
   "endMs": "73000",
   "startTimeText": "1:07"
  },
  {
   "text": "영접하여",
   "startMs": "70720",
   "endMs": "76020",
   "startTimeText": "1:10"
  },
  {
   "text": "주소서 내 구주의",
   "startMs": "73000",
   "endMs": "77920",
   "startTimeText": "1:13"
  },
  {
   "text": "[음악]",
   "startMs": "76020",
   "endMs": "83040",
   "startTimeText": "1:16"
  },
  {
   "text": "수여 나 구주 위해",
   "startMs": "77920",
   "endMs": "85759",
   "startTimeText": "1:17"
  },
  {
   "text": "살리라 내 기쁨",
   "startMs": "83040",
