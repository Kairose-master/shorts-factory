   "endMs": "132479",
   "startTimeText": "2:01"
  },
  {
   "text": "사랑의 주사랑의 주 내 마음속에",
   "startMs": "133480",
   "endMs": "144000",
   "startTimeText": "2:13"
  },
  {
   "text": "찾아오사",
   "startMs": "141000",
