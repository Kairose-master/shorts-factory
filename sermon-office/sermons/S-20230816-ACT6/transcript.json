   "endMs": "637980",
   "startTimeText": "10:34"
  },
  {
   "text": "기다리고 뭐",
   "startMs": "636540",
   "endMs": "639899",
   "startTimeText": "10:36"
  },
  {
   "text": "그렇게 하는 거죠",
