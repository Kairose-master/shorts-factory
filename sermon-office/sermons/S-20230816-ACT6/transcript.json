   "endMs": "675600",
   "startTimeText": "11:10"
  },
  {
   "text": "방법이 선하지 않잖아요 보면은",
   "startMs": "673200",
   "endMs": "676700",
   "startTimeText": "11:13"
  },
  {
   "text": "매수하여 가지고",
