   "endMs": "764880",
   "startTimeText": "12:40"
  },
  {
   "text": "원하십니까",
   "startMs": "762899",
   "endMs": "767279",
   "startTimeText": "12:42"
  },
  {
   "text": "지혜와 성령으로 말하고",
