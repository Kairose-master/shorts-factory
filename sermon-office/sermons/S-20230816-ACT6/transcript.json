   "startTimeText": "4:54"
  },
  {
   "text": "당하지 못하여 사람들을 매수하여",
   "startMs": "296699",
   "endMs": "302460",
   "startTimeText": "4:56"
  },
  {
   "text": "말하게 하되이는 사람이이 사람이",
