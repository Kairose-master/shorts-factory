   "endMs": "739040",
   "startTimeText": "12:15"
  },
  {
   "text": "그냥",
   "startMs": "737220",
   "endMs": "742980",
   "startTimeText": "12:17"
  },
  {
   "text": "정신이 하나도 없어요 정신이",
