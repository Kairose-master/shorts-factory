 ],
 "transcript": [
  {
   "text": "오늘 새벽기도 녹화가 제대로 안 돼",
   "startMs": "2280",
   "endMs": "11360",
   "startTimeText": "0:02"
  },
  {
   "text": "가지고 어 다시 핵심 부분만 이렇게",
   "startMs": "5720",
   "endMs": "14559",
   "startTimeText": "0:05"
  },
  {
   "text": "말씀드리려고 합니다.",
   "startMs": "11360",
   "endMs": "16279",
   "startTimeText": "0:11"
  },
  {
   "text": "기도하시겠습니다. 하나님 아버지",
   "startMs": "14559",
   "endMs": "18279",
   "startTimeText": "0:14"
  },
  {
   "text": "감사합니다. 오늘 새벽도 주 앞에",
   "startMs": "16279",
   "endMs": "20880",
   "startTimeText": "0:16"
  },
  {
   "text": "나와서 기도하게 하시고 하나님께 모든",
   "startMs": "18279",
   "endMs": "22720",
   "startTimeText": "0:18"
  },
  {
   "text": "것을 맡겨 드리게 하시니",
   "startMs": "20880",
   "endMs": "24680",
   "startTimeText": "0:20"
  },
  {
   "text": "감사드립니다. 우리의 중심이 늘",
   "startMs": "22720",
   "endMs": "27240",
   "startTimeText": "0:22"
  },
  {
   "text": "하나님께 향해 있사오니 주의 크신",
   "startMs": "24680",
   "endMs": "29840",
   "startTimeText": "0:24"
  },
  {
   "text": "은혜와 긍휼를 우리 가운데 베풀어",
   "startMs": "27240",
   "endMs": "31840",
   "startTimeText": "0:27"
  },
  {
   "text": "주시옵소서. 하나님 아버지, 늘",
   "startMs": "29840",
   "endMs": "33719",
   "startTimeText": "0:29"
  },
  {
   "text": "우리의 믿음이 바른 곳을 향해",
   "startMs": "31840",
   "endMs": "36840",
   "startTimeText": "0:31"
  },
  {
   "text": "나아가길 원합니다. 하나님의 말씀과",
   "startMs": "33719",
   "endMs": "39520",
   "startTimeText": "0:33"
  },
  {
   "text": "예수 그리스도를 구원자로 고백하며",
   "startMs": "36840",
   "endMs": "42239",
   "startTimeText": "0:36"
  },
  {
   "text": "성령님의 인도하심을 따라 나아갈 때",
   "startMs": "39520",
   "endMs": "44280",
   "startTimeText": "0:39"
  },
  {
   "text": "우리의 삶 가운데 바른 믿음 가운데",
   "startMs": "42239",
   "endMs": "47480",
   "startTimeText": "0:42"
  },
  {
   "text": "서서 나아갈 수 있 있는 줄 믿사오니",
   "startMs": "44280",
   "endMs": "49760",
   "startTimeText": "0:44"
  },
  {
   "text": "이런 믿음과 진리의 경제를 잘",
   "startMs": "47480",
   "endMs": "51680",
   "startTimeText": "0:47"
  },
  {
   "text": "달려가는 복된 인생이 되게 하여",
   "startMs": "49760",
   "endMs": "54079",
   "startTimeText": "0:49"
  },
  {
   "text": "주시옵소서. 하나님 아버지이 나라",
   "startMs": "51680",
   "endMs": "56039",
   "startTimeText": "0:51"
  },
  {
   "text": "가운데 잘못된 것을 가르치는 거짓",
   "startMs": "54079",
   "endMs": "58559",
   "startTimeText": "0:54"
  },
  {
   "text": "교사들이 많이 있습니다. 이단적인",
   "startMs": "56039",
   "endMs": "60600",
   "startTimeText": "0:56"
  },
  {
   "text": "사상을 유포하며 자신이 교조와",
   "startMs": "58559",
   "endMs": "63399",
   "startTimeText": "0:58"
  },
  {
   "text": "구원자가 되어가는 사람들도 있습니다.",
   "startMs": "60600",
   "endMs": "65400",
   "startTimeText": "1:00"
  },
  {
   "text": "많은 사람들이 미혹되어 구원이 없는",
   "startMs": "63399",
   "endMs": "67759",
   "startTimeText": "1:03"
  },
  {
   "text": "길에 자신의 모든 것을 빼앗며 종되어",
   "startMs": "65400",
   "endMs": "70400",
   "startTimeText": "1:05"
  },
  {
   "text": "지내는 경우도 많이 있습니다. 이단의",
   "startMs": "67759",
   "endMs": "73080",
   "startTimeText": "1:07"
  },
  {
   "text": "실체는 밝히 드러나게 하시며 미혹된",
   "startMs": "70400",
   "endMs": "74960",
   "startTimeText": "1:10"
  },
  {
   "text": "자들은 하나님의 은혜 가운데 예수",
   "startMs": "73080",
   "endMs": "77400",
   "startTimeText": "1:13"
  },
  {
   "text": "그리스도께로 돌아와 참된 자유를 얻을",
   "startMs": "74960",
   "endMs": "81200",
   "startTimeText": "1:14"
  },
  {
   "text": "수 있도록 인도하여 주시옵소서.",
   "startMs": "77400",
   "endMs": "83119",
   "startTimeText": "1:17"
  },
  {
   "text": "가정과 일상의 삶을 파괴하는 모든",
   "startMs": "81200",
   "endMs": "85799",
   "startTimeText": "1:21"
  },
  {
   "text": "악한 세력들은 힘을 잃게 하시고 주의",
   "startMs": "83119",
   "endMs": "87720",
   "startTimeText": "1:23"
  },
  {
   "text": "말씀의 교훈만이 우리를 바른 길로",
   "startMs": "85799",
   "endMs": "90640",
   "startTimeText": "1:25"
  },
  {
   "text": "인도함을 깨닫고 하나님의 사람이 되며",
   "startMs": "87720",
   "endMs": "93079",
   "startTimeText": "1:27"
  },
  {
   "text": "사람이 주인되지 않도록 인도하여",
   "startMs": "90640",
   "endMs": "95119",
   "startTimeText": "1:30"
  },
  {
   "text": "주시옵소서. 하나님 아버지의 나라",
   "startMs": "93079",
   "endMs": "97759",
   "startTimeText": "1:33"
  },
  {
   "text": "대한민국을 불쌍히 여기시사 하나님께서",
   "startMs": "95119",
   "endMs": "100280",
   "startTimeText": "1:35"
  },
  {
   "text": "은혜를 베풀어 주시옵소서. 사람들의",
   "startMs": "97759",
   "endMs": "102520",
   "startTimeText": "1:37"
  },
  {
   "text": "헛된 일들을 경영하며 다 자기의",
   "startMs": "100280",
   "endMs": "105439",
   "startTimeText": "1:40"
  },
  {
   "text": "잘난과 뛰어남을 주장할 때 오직",
   "startMs": "102520",
   "endMs": "108240",
   "startTimeText": "1:42"
  },
  {
   "text": "묵목하게 우리에게는 지혜가 없으니",
   "startMs": "105439",
   "endMs": "110640",
   "startTimeText": "1:45"
  },
  {
   "text": "하나님 앞에 겸손하게 꺾겠습니다.",
   "startMs": "108240",
   "endMs": "113920",
   "startTimeText": "1:48"
  },
  {
   "text": "이렇게 생각하며 행동하는 지도자들이",
   "startMs": "110640",
   "endMs": "116399",
   "startTimeText": "1:50"
  },
  {
   "text": "많이 생겨날 수 있도록 인도하여",
   "startMs": "113920",
   "endMs": "118399",
   "startTimeText": "1:53"
  },
  {
   "text": "주시옵소서. 한국 교회를 붙들어",
   "startMs": "116399",
   "endMs": "120479",
   "startTimeText": "1:56"
  },
  {
   "text": "주시길 원합니다. 교회가 잘못된 길로",
   "startMs": "118399",
   "endMs": "123159",
   "startTimeText": "1:58"
  },
  {
   "text": "가지 않도록 인도하시고 세상의 빛과",
   "startMs": "120479",
   "endMs": "126000",
   "startTimeText": "2:00"
  },
  {
   "text": "소금으로서의 역할을 감당하는 교회가",
   "startMs": "123159",
   "endMs": "128479",
   "startTimeText": "2:03"
  },
  {
   "text": "될 수 있도록 인도하여 주시옵소서.",
   "startMs": "126000",
   "endMs": "130239",
   "startTimeText": "2:06"
  },
  {
   "text": "우리 예수교회를 붙들어 주시기를",
   "startMs": "128479",
   "endMs": "132840",
   "startTimeText": "2:08"
  },
  {
   "text": "원합니다. 하나님께서 기뻐하시는 교회",
   "startMs": "130239",
   "endMs": "135360",
   "startTimeText": "2:10"
  },
  {
   "text": "성령 충만한 교회 기도와 말씀으로",
   "startMs": "132840",
   "endMs": "138040",
   "startTimeText": "2:12"
  },
  {
   "text": "기본부터 바로 세워져 가는 교회",
   "startMs": "135360",
   "endMs": "140080",
   "startTimeText": "2:15"
  },
  {
   "text": "삶속에서 주의 역사를 맛보는 교회가",
   "startMs": "138040",
   "endMs": "143239",
   "startTimeText": "2:18"
  },
  {
   "text": "되도록 인도하여 주시옵소서. 성도들의",
   "startMs": "140080",
   "endMs": "145640",
   "startTimeText": "2:20"
  },
  {
   "text": "삶이 주 안에서 형통하게 하시며",
   "startMs": "143239",
   "endMs": "148120",
   "startTimeText": "2:23"
  },
  {
   "text": "믿음이 날마다 더해지는 삶이 되게",
   "startMs": "145640",
   "endMs": "150519",
   "startTimeText": "2:25"
  },
  {
   "text": "하시고 성령께서 변화를 이끄시는",
   "startMs": "148120",
   "endMs": "153400",
   "startTimeText": "2:28"
  },
  {
   "text": "성도들이 되어 평생의 주의 은혜로",
   "startMs": "150519",
   "endMs": "156239",
   "startTimeText": "2:30"
  },
  {
   "text": "넘치게 하여 주시고 믿음 가지고 진리",
   "startMs": "153400",
   "endMs": "159599",
   "startTimeText": "2:33"
  },
  {
   "text": "가운데 성장할 수 있도록 인도하여",
   "startMs": "156239",
   "endMs": "162159",
   "startTimeText": "2:36"
  },
  {
   "text": "주시옵소서. 오늘도 주님 앞에 간절한",
   "startMs": "159599",
   "endMs": "164440",
   "startTimeText": "2:39"
  },
  {
   "text": "마음으로 드리는 기도가 있습니다.",
   "startMs": "162159",
   "endMs": "167040",
   "startTimeText": "2:42"
  },
  {
   "text": "하나님 들어서 응답하여 주시옵소서.",
   "startMs": "164440",
   "endMs": "170480",
   "startTimeText": "2:44"
  },
  {
   "text": "특별히 지치고 피곤하고 마음과 모든",
   "startMs": "167040",
   "endMs": "172680",
   "startTimeText": "2:47"
  },
  {
   "text": "것이 또 힘든 어려운 상황 가운데",
   "startMs": "170480",
   "endMs": "175959",
   "startTimeText": "2:50"
  },
  {
   "text": "있는 성도들이 있습니다. 하나님께서",
   "startMs": "172680",
   "endMs": "178200",
   "startTimeText": "2:52"
  },
  {
   "text": "오른손으로 붙들어 주시고 새로운 힘을",
   "startMs": "175959",
   "endMs": "180879",
   "startTimeText": "2:55"
  },
  {
   "text": "더하여 주시고 성령 충만을 얻게 하여",
   "startMs": "178200",
   "endMs": "183840",
   "startTimeText": "2:58"
  },
  {
   "text": "주시고 오직 하나님께서 소망이 되심을",
   "startMs": "180879",
   "endMs": "186080",
   "startTimeText": "3:00"
  },
  {
   "text": "깨닫고 하나님께서 실질적으로",
   "startMs": "183840",
   "endMs": "188519",
   "startTimeText": "3:03"
  },
  {
   "text": "역사하시고 임하시는 은혜를 누리게",
   "startMs": "186080",
   "endMs": "190920",
   "startTimeText": "3:06"
  },
  {
   "text": "하여 주시옵소서. 모든 것을 주님",
   "startMs": "188519",
   "endMs": "193080",
   "startTimeText": "3:08"
  },
  {
   "text": "손에 맡겨 드려오며 예수님의 이름으로",
   "startMs": "190920",
   "endMs": "196040",
   "startTimeText": "3:10"
  },
  {
   "text": "기도드립니다. 아멘. 오늘 우리에게",
   "startMs": "193080",
   "endMs": "198440",
   "startTimeText": "3:13"
  },
  {
   "text": "주시는 하나님의 말씀은 디도서 3장",
   "startMs": "196040",
   "endMs": "201000",
   "startTimeText": "3:16"
  },
  {
   "text": "9절부터 11절까지의 말씀입니다.",
   "startMs": "198440",
   "endMs": "203720",
   "startTimeText": "3:18"
  },
  {
   "text": "디도서 3장 9절부터",
   "startMs": "201000",
   "endMs": "206599",
   "startTimeText": "3:21"
  },
  {
   "text": "11절까지 봉독하도록 하겠습니다.",
   "startMs": "203720",
   "endMs": "209480",
   "startTimeText": "3:23"
  },
  {
   "text": "그러나 어리석은 변론과 족보 이야기와",
   "startMs": "206599",
   "endMs": "212519",
   "startTimeText": "3:26"
  },
  {
   "text": "분쟁과 율법에 대한 다툼은 피하라.",
   "startMs": "209480",
   "endMs": "215200",
   "startTimeText": "3:29"
  },
  {
   "text": "이것은 무익한 것이요 헛된 것이니라.",
   "startMs": "212519",
   "endMs": "217280",
   "startTimeText": "3:32"
  },
  {
   "text": "이단을 속한 사람을 한두 번 훈계한",
   "startMs": "215200",
   "endMs": "219640",
   "startTimeText": "3:35"
  },
  {
   "text": "후에 멀리하라. 이러한 사람은 내가",
   "startMs": "217280",
   "endMs": "221640",
   "startTimeText": "3:37"
  },
  {
   "text": "아는 바와 같이 부패하여 스스로",
   "startMs": "219640",
   "endMs": "225439",
   "startTimeText": "3:39"
  },
  {
   "text": "정제한 자로서 죄를 짓느니라. 아멘.",
   "startMs": "221640",
   "endMs": "228000",
   "startTimeText": "3:41"
  },
  {
   "text": "우리가 예수님을 믿고 살 때 예수",
   "startMs": "225439",
   "endMs": "230319",
   "startTimeText": "3:45"
  },
  {
   "text": "그리스도의 은혜와 사랑이 우리 가운데",
   "startMs": "228000",
   "endMs": "233720",
   "startTimeText": "3:48"
  },
  {
   "text": "많이 부어졌는데 어 그런데 다른",
   "startMs": "230319",
   "endMs": "235599",
   "startTimeText": "3:50"
  },
  {
   "text": "사람들에 대해서도 이런 마음으로",
   "startMs": "233720",
   "endMs": "237599",
   "startTimeText": "3:53"
  },
  {
   "text": "우리가 늘 다가가려고 이야기를",
   "startMs": "235599",
   "endMs": "240959",
   "startTimeText": "3:55"
  },
  {
   "text": "합니다. 그 사람을 끝까지 품어주고",
   "startMs": "237599",
   "endMs": "243400",
   "startTimeText": "3:57"
  },
  {
   "text": "용납하고 어 그 사람 가운데 하나님의",
   "startMs": "240959",
   "endMs": "247120",
   "startTimeText": "4:00"
  },
  {
   "text": "사랑을 베풀려고 하는데 그런데 오늘",
   "startMs": "243400",
   "endMs": "251400",
   "startTimeText": "4:03"
  },
  {
   "text": "말씀에 보면은 어 그런 것과 조금",
   "startMs": "247120",
   "endMs": "253640",
   "startTimeText": "4:07"
  },
  {
   "text": "다르게 생각해야 될 사람이 있다라는",
   "startMs": "251400",
   "endMs": "254640",
   "startTimeText": "4:11"
  },
  {
   "text": "것이죠.",
   "startMs": "253640",
   "endMs": "256560",
   "startTimeText": "4:13"
  },
  {
   "text": "어, 그것은 뭐냐면 10절 말씀에",
   "startMs": "254640",
   "endMs": "258840",
   "startTimeText": "4:14"
  },
  {
   "text": "이단에 속한 사람이라는",
   "startMs": "256560",
   "endMs": "261440",
   "startTimeText": "4:16"
  },
  {
   "text": "거예요. 하나님의 말씀의 진리",
   "startMs": "258840",
   "endMs": "263720",
   "startTimeText": "4:18"
  },
  {
   "text": "그다음에 예수 그리스도 구원에 대한",
   "startMs": "261440",
   "endMs": "267440",
   "startTimeText": "4:21"
  },
  {
   "text": "그런 복음 이런 것과 상관없이",
   "startMs": "263720",
   "endMs": "271000",
   "startTimeText": "4:23"
  },
  {
   "text": "다른 경제적인 이득을 목적으로 어",
   "startMs": "267440",
   "endMs": "273240",
   "startTimeText": "4:27"
  },
  {
   "text": "그다음에 자기에게 사람들을 끌어갈",
   "startMs": "271000",
   "endMs": "275759",
   "startTimeText": "4:31"
  },
  {
   "text": "목적으로 오는 그런 사람들이 바로",
   "startMs": "273240",
   "endMs": "278759",
   "startTimeText": "4:33"
  },
  {
   "text": "이단에 속한 사람들인데 이런 사람들을",
   "startMs": "275759",
   "endMs": "282520",
   "startTimeText": "4:35"
  },
  {
   "text": "끝까지 품고 사랑하고 교재하고 이렇게",
   "startMs": "278759",
   "endMs": "284880",
   "startTimeText": "4:38"
  },
  {
   "text": "하지 말라라는 것이죠.",
   "startMs": "282520",
   "endMs": "287800",
   "startTimeText": "4:42"
  },
  {
   "text": "이단에 속한 사람이라고 생각을 하니까",
   "startMs": "284880",
   "endMs": "290960",
   "startTimeText": "4:44"
  },
  {
   "text": "좀 이렇게 마음에 많이 와닿지 않을",
   "startMs": "287800",
   "endMs": "293039",
   "startTimeText": "4:47"
  },
  {
   "text": "때가 있는데 이렇게 생각을 하시면",
   "startMs": "290960",
   "endMs": "295600",
   "startTimeText": "4:50"
  },
  {
   "text": "되겠습니다. 만약에 세상 가운데",
   "startMs": "293039",
   "endMs": "299560",
   "startTimeText": "4:53"
  },
  {
   "text": "사기꾼이 있다면 어 여러분들 사기꾼을",
   "startMs": "295600",
   "endMs": "302840",
   "startTimeText": "4:55"
  },
  {
   "text": "계속해서 품어 주고 사랑해 주고",
   "startMs": "299560",
   "endMs": "304840",
   "startTimeText": "4:59"
  },
  {
   "text": "그다음에 사기꾼과",
   "startMs": "302840",
   "endMs": "306479",
   "startTimeText": "5:02"
  },
  {
   "text": "계속해서",
   "startMs": "304840",
   "endMs": "308960",
   "startTimeText": "5:04"
  },
  {
   "text": "교재하고 어 이러면 안 되잖아요.",
   "startMs": "306479",
   "endMs": "312479",
   "startTimeText": "5:06"
  },
  {
   "text": "사기꾼의 목적은 사기를 치려는 의도를",
   "startMs": "308960",
   "endMs": "316120",
   "startTimeText": "5:08"
  },
  {
   "text": "가지고 접근을 하고 결국에는 어",
   "startMs": "312479",
   "endMs": "321120",
   "startTimeText": "5:12"
  },
  {
   "text": "나중에 어 사기칠 대상을 어 포섭을",
   "startMs": "316120",
   "endMs": "324319",
   "startTimeText": "5:16"
  },
  {
   "text": "해 가지고 어 자기 쪽으로 자기의",
   "startMs": "321120",
   "endMs": "326919",
   "startTimeText": "5:21"
  },
  {
   "text": "어떤 경제적인 목적으로 그 사람에게",
   "startMs": "324319",
   "endMs": "329440",
   "startTimeText": "5:24"
  },
  {
   "text": "피해를 줄 목적으로 다가오는 사람이",
   "startMs": "326919",
   "endMs": "331479",
   "startTimeText": "5:26"
  },
  {
   "text": "사기꾼이잖아요. 여러분들 사기꾼이",
   "startMs": "329440",
   "endMs": "333680",
   "startTimeText": "5:29"
  },
  {
   "text": "나타나면 어떻게 하겠습니까? 그",
   "startMs": "331479",
   "endMs": "336440",
   "startTimeText": "5:31"
  },
  {
   "text": "사람과 계속 교재할 거예요? 아니면은",
   "startMs": "333680",
   "endMs": "337440",
   "startTimeText": "5:33"
  },
  {
   "text": "어 몇",
   "startMs": "336440",
   "endMs": "340160",
   "startTimeText": "5:36"
  },
  {
   "text": "번을 이것은 맞지 않다라고 이야기를",
   "startMs": "337440",
   "endMs": "343360",
   "startTimeText": "5:37"
  },
  {
   "text": "하면서 멀리 할 것입니까?",
   "startMs": "340160",
   "endMs": "346319",
   "startTimeText": "5:40"
  },
  {
   "text": "그러니까 어 우리가 교회 생활을 하고",
   "startMs": "343360",
   "endMs": "348680",
   "startTimeText": "5:43"
  },
  {
   "text": "신앙생활을 할 때도 이런 사기꾼과",
   "startMs": "346319",
   "endMs": "352240",
   "startTimeText": "5:46"
  },
  {
   "text": "같은에 그런 거짓 교사들이 있을 수",
   "startMs": "348680",
   "endMs": "354319",
   "startTimeText": "5:48"
  },
  {
   "text": "있다라는 것입니다. 그런 사람들에",
   "startMs": "352240",
   "endMs": "357400",
   "startTimeText": "5:52"
  },
  {
   "text": "대해서는 조금 다른 생각을 가지고",
   "startMs": "354319",
   "endMs": "360280",
   "startTimeText": "5:54"
  },
  {
   "text": "다른 기준을 가지고 적용했으면",
   "startMs": "357400",
   "endMs": "362919",
   "startTimeText": "5:57"
  },
  {
   "text": "좋겠어라고 어 설명하고 있는 것이",
   "startMs": "360280",
   "endMs": "365600",
   "startTimeText": "6:00"
  },
  {
   "text": "바로 오늘 본문에 대한 내용입니다.",
   "startMs": "362919",
   "endMs": "367560",
   "startTimeText": "6:02"
  },
  {
   "text": "그래서 10절에 보면 이단에 속한",
   "startMs": "365600",
   "endMs": "370000",
   "startTimeText": "6:05"
  },
  {
   "text": "사람은 한두 번 훈계한 후에 어떻게",
   "startMs": "367560",
   "endMs": "371560",
   "startTimeText": "6:07"
  },
  {
   "text": "하라고요?",
   "startMs": "370000",
   "endMs": "374120",
   "startTimeText": "6:10"
  },
  {
   "text": "멀리하라라고 되어 있습니다. 한두 번",
   "startMs": "371560",
   "endMs": "376960",
   "startTimeText": "6:11"
  },
  {
   "text": "정도 어 네가 이야기하는 것이",
   "startMs": "374120",
   "endMs": "380080",
   "startTimeText": "6:14"
  },
  {
   "text": "하나님의 교훈과 잘못돼 있고 구원과",
   "startMs": "376960",
   "endMs": "383000",
   "startTimeText": "6:16"
  },
  {
   "text": "잘못되어 있기 때문에 그것은 옳지",
   "startMs": "380080",
   "endMs": "385319",
   "startTimeText": "6:20"
  },
  {
   "text": "않다라고 이야기를 하고 한두 번",
   "startMs": "383000",
   "endMs": "387360",
   "startTimeText": "6:23"
  },
  {
   "text": "훈기한 다음에 멀리하라는 거예요.",
   "startMs": "385319",
   "endMs": "390080",
   "startTimeText": "6:25"
  },
  {
   "text": "계속해서 그 사람과 만나 가지고 그",
   "startMs": "387360",
   "endMs": "392720",
   "startTimeText": "6:27"
  },
  {
   "text": "사람의 이야기를 들으면서 그 사람은",
   "startMs": "390080",
   "endMs": "395199",
   "startTimeText": "6:30"
  },
  {
   "text": "나를 잘못되게 할 목적을 가지고",
   "startMs": "392720",
   "endMs": "398280",
   "startTimeText": "6:32"
  },
  {
   "text": "계속해서 자기 어떤 사상을 전파하는데",
   "startMs": "395199",
   "endMs": "401080",
   "startTimeText": "6:35"
  },
  {
   "text": "그런 사람들을 멀리하라라는 겁니다.",
   "startMs": "398280",
   "endMs": "403440",
   "startTimeText": "6:38"
  },
  {
   "text": "11절에 이런 사람을 어떻게 생각을",
   "startMs": "401080",
   "endMs": "405720",
   "startTimeText": "6:41"
  },
  {
   "text": "해야 되냐면 이런 사람은 내가 아는",
   "startMs": "403440",
   "endMs": "408840",
   "startTimeText": "6:43"
  },
  {
   "text": "바와 같이 부패요. 마음이 온갖 나쁜",
   "startMs": "405720",
   "endMs": "411680",
   "startTimeText": "6:45"
  },
  {
   "text": "목적을 가지고 그다음에 스스로 정제한",
   "startMs": "408840",
   "endMs": "414840",
   "startTimeText": "6:48"
  },
  {
   "text": "자로서라는 것은 스스로 그게 잘못된",
   "startMs": "411680",
   "endMs": "417039",
   "startTimeText": "6:51"
  },
  {
   "text": "것임을 알면서도",
   "startMs": "414840",
   "endMs": "419680",
   "startTimeText": "6:54"
  },
  {
   "text": "그렇게 걷기로 결정한 자라는 거예요.",
   "startMs": "417039",
   "endMs": "423160",
   "startTimeText": "6:57"
  },
  {
   "text": "그래서 죄를 짓느니라 다른 사람들을",
   "startMs": "419680",
   "endMs": "425199",
   "startTimeText": "6:59"
  },
  {
   "text": "악한 길로 끌려고 하는 그런 목적을",
   "startMs": "423160",
   "endMs": "427800",
   "startTimeText": "7:03"
  },
  {
   "text": "가지고 있는 사람이라는 거예요. 그런",
   "startMs": "425199",
   "endMs": "429360",
   "startTimeText": "7:05"
  },
  {
   "text": "사람들은",
   "startMs": "427800",
   "endMs": "431039",
   "startTimeText": "7:07"
  },
  {
   "text": "멀리하라라고 이야기를 하고",
   "startMs": "429360",
   "endMs": "435599",
   "startTimeText": "7:09"
  },
  {
   "text": "있습니다.에 에 그 이때 초대교회",
   "startMs": "431039",
   "endMs": "439039",
   "startTimeText": "7:11"
  },
  {
   "text": "그레대 교회에에 이단을 속한 사람이",
   "startMs": "435599",
   "endMs": "441560",
   "startTimeText": "7:15"
  },
  {
   "text": "있었다라는 거죠. 근데 이단을 속한",
   "startMs": "439039",
   "endMs": "443319",
   "startTimeText": "7:19"
  },
  {
   "text": "사람들이 어떤 일을 했냐면 바로",
   "startMs": "441560",
   "endMs": "446400",
   "startTimeText": "7:21"
  },
  {
   "text": "9절에 대한 내용들을 했습니다.",
   "startMs": "443319",
   "endMs": "449000",
   "startTimeText": "7:23"
  },
  {
   "text": "어리석은 변론 하나님의 말씀이 아닌",
   "startMs": "446400",
   "endMs": "451680",
   "startTimeText": "7:26"
  },
  {
   "text": "것을 가지고 무언가를 세팅을 하는",
   "startMs": "449000",
   "endMs": "454599",
   "startTimeText": "7:29"
  },
  {
   "text": "거죠. 그다음에 족보 이야기.",
   "startMs": "451680",
   "endMs": "457039",
   "startTimeText": "7:31"
  },
  {
   "text": "예수 그리스도의 어떤 구원에 관련된",
   "startMs": "454599",
   "endMs": "459720",
   "startTimeText": "7:34"
  },
  {
   "text": "것, 하나님의 교훈 이런 쪽에 초점",
   "startMs": "457039",
   "endMs": "463280",
   "startTimeText": "7:37"
  },
  {
   "text": "맞추는게 아니라 뭔가 자기가 얼마나",
   "startMs": "459720",
   "endMs": "466199",
   "startTimeText": "7:39"
  },
  {
   "text": "어 권세 있고 능력 있는가 그런",
   "startMs": "463280",
   "endMs": "469440",
   "startTimeText": "7:43"
  },
  {
   "text": "것들을 어 새롭게 만들어서 나는 어떤",
   "startMs": "466199",
   "endMs": "472520",
   "startTimeText": "7:46"
  },
  {
   "text": "족보에 따라 가지고 어떤 지위를 가진",
   "startMs": "469440",
   "endMs": "475240",
   "startTimeText": "7:49"
  },
  {
   "text": "사람이다. 이런 것들을 세팅을 하고",
   "startMs": "472520",
   "endMs": "478319",
   "startTimeText": "7:52"
  },
  {
   "text": "그다음에 늘 분쟁을 일으켜 늘가",
   "startMs": "475240",
   "endMs": "480919",
   "startTimeText": "7:55"
  },
  {
   "text": "가지고 거기서 논쟁을 하려고 하고",
   "startMs": "478319",
   "endMs": "484319",
   "startTimeText": "7:58"
  },
  {
   "text": "그다음에 율법에 대한 다툼 율법주의가",
   "startMs": "480919",
   "endMs": "486639",
   "startTimeText": "8:00"
  },
  {
   "text": "되어 가지고 이런 것들을 안 지키면",
   "startMs": "484319",
   "endMs": "489759",
   "startTimeText": "8:04"
  },
  {
   "text": "구원이 없다. 이런 식으로 계속해서",
   "startMs": "486639",
   "endMs": "492080",
   "startTimeText": "8:06"
  },
  {
   "text": "이것을 이야기를 하는데 이들의 목적은",
   "startMs": "489759",
   "endMs": "494599",
   "startTimeText": "8:09"
  },
  {
   "text": "뭐냐면 다른 사람들을 포섭을 해",
   "startMs": "492080",
   "endMs": "498400",
   "startTimeText": "8:12"
  },
  {
   "text": "가지고 자기의 경제적인 이득을",
   "startMs": "494599",
   "endMs": "502080",
   "startTimeText": "8:14"
  },
  {
   "text": "취하려고 어 그 사람에게 피해를 주게",
   "startMs": "498400",
   "endMs": "504919",
   "startTimeText": "8:18"
  },
  {
   "text": "하고 자기 사람이 되게 하려고 하는",
   "startMs": "502080",
   "endMs": "507240",
   "startTimeText": "8:22"
  },
  {
   "text": "그런 목적을 가진 사람인데 이런",
   "startMs": "504919",
   "endMs": "510159",
   "startTimeText": "8:24"
  },
  {
   "text": "사람들과 계속해서 논쟁을 하거나 그런",
   "startMs": "507240",
   "endMs": "513039",
   "startTimeText": "8:27"
  },
  {
   "text": "것은 피하나 이것은 무익한 것이요",
   "startMs": "510159",
   "endMs": "516039",
   "startTimeText": "8:30"
  },
  {
   "text": "헛된 것이다라고 이야기를 합니다. 에",
   "startMs": "513039",
   "endMs": "520399",
   "startTimeText": "8:33"
  },
  {
   "text": "다시 한번 쉽게 이야기를 하려면",
   "startMs": "516039",
   "endMs": "520399",
   "startTimeText": "8:36"
  },
  {
   "text": "사기꾼들이에 있다면 어 사기꾼들과",
   "startMs": "520640",
   "endMs": "526120",
   "startTimeText": "8:40"
  },
  {
   "text": "친하게 지내지 말라라는 거예요. 어",
   "startMs": "523519",
   "endMs": "530360",
   "startTimeText": "8:43"
  },
  {
   "text": "그 사람이에 목적을 분별하고 그",
   "startMs": "526120",
   "endMs": "532720",
   "startTimeText": "8:46"
  },
  {
   "text": "사람이 말하고 있는 것이 안 맞다라는",
   "startMs": "530360",
   "endMs": "535480",
   "startTimeText": "8:50"
  },
  {
   "text": "것을 분별을 하고 몇 번 훈계한",
   "startMs": "532720",
   "endMs": "538240",
   "startTimeText": "8:52"
  },
  {
   "text": "다음에 멀리해야 우리가 넘어가지 않는",
   "startMs": "535480",
   "endMs": "541200",
   "startTimeText": "8:55"
  },
  {
   "text": "것이죠. 그러면 우리는 이단에 속한",
   "startMs": "538240",
   "endMs": "542680",
   "startTimeText": "8:58"
  },
  {
   "text": "사람들을 어떻게 분별할 수",
   "startMs": "541200",
   "endMs": "544680",
   "startTimeText": "9:01"
  },
  {
   "text": "있겠습니까?에",
   "startMs": "542680",
   "endMs": "546880",
   "startTimeText": "9:02"
  },
  {
   "text": "그런 사람들에게 어떻게 넘어가지",
   "startMs": "544680",
   "endMs": "549600",
   "startTimeText": "9:04"
  },
  {
   "text": "않겠습니까? 그것은 우리가 하나님의",
   "startMs": "546880",
   "endMs": "551640",
   "startTimeText": "9:06"
  },
  {
   "text": "말씀에 분명하게서 있고 예수",
   "startMs": "549600",
   "endMs": "553360",
   "startTimeText": "9:09"
  },
  {
   "text": "그리스도의 구원의 복음 가운데",
   "startMs": "551640",
   "endMs": "556360",
   "startTimeText": "9:11"
  },
  {
   "text": "분명하게서 있고 그다음에 말씀의",
   "startMs": "553360",
   "endMs": "559160",
   "startTimeText": "9:13"
  },
  {
   "text": "가르침 가운데 우리가 선한 행실로 늘",
   "startMs": "556360",
   "endMs": "561560",
   "startTimeText": "9:16"
  },
  {
   "text": "살아야 되는 것을 기억하고 있다면",
   "startMs": "559160",
   "endMs": "563640",
   "startTimeText": "9:19"
  },
  {
   "text": "우리 자신이 말씀 가운데",
   "startMs": "561560",
   "endMs": "565800",
   "startTimeText": "9:21"
  },
  {
   "text": "온전하게서서 있다면 사기꾼들이",
   "startMs": "563640",
   "endMs": "568440",
   "startTimeText": "9:23"
  },
  {
   "text": "다가오고 이단이 다가왔을 때 그들이",
   "startMs": "565800",
   "endMs": "571480",
   "startTimeText": "9:25"
  },
  {
   "text": "말하는 것에 대해서 한두 번 훈기하고",
   "startMs": "568440",
   "endMs": "574320",
   "startTimeText": "9:28"
  },
  {
   "text": "멀리하게 된다면 그들이 더 이상 그런",
   "startMs": "571480",
   "endMs": "576160",
   "startTimeText": "9:31"
  },
  {
   "text": "일들을 안 하게 되겠죠.이 이",
   "startMs": "574320",
   "endMs": "579120",
   "startTimeText": "9:34"
  },
  {
   "text": "성도한테 접근을 했는데도이 성도는",
   "startMs": "576160",
   "endMs": "581800",
   "startTimeText": "9:36"
  },
  {
   "text": "말씀 가운데 바로서 있고 복음 가운데",
   "startMs": "579120",
   "endMs": "584760",
   "startTimeText": "9:39"
  },
  {
   "text": "바로서 있고 그다음에 오히려 하나님의",
   "startMs": "581800",
   "endMs": "586959",
   "startTimeText": "9:41"
  },
  {
   "text": "말씀에 네가 하는 것이 맞지 않다.",
   "startMs": "584760",
   "endMs": "591200",
   "startTimeText": "9:44"
  },
  {
   "text": "몇 번 얘기하고 멀리하고 그러면 어이",
   "startMs": "586959",
   "endMs": "593800",
   "startTimeText": "9:46"
  },
  {
   "text": "이단을 속한 사람이 어 세력이 없는",
   "startMs": "591200",
   "endMs": "596079",
   "startTimeText": "9:51"
  },
  {
   "text": "거죠. 어이 사람한테 가도 안",
   "startMs": "593800",
   "endMs": "598000",
   "startTimeText": "9:53"
  },
  {
   "text": "넘어가고 저 사람한테 가도 안",
   "startMs": "596079",
   "endMs": "600160",
   "startTimeText": "9:56"
  },
  {
   "text": "넘어가고 그러면이 사람이 더 이상",
   "startMs": "598000",
   "endMs": "602519",
   "startTimeText": "9:58"
  },
  {
   "text": "그런 일을 행하지 아니하고에 그것",
   "startMs": "600160",
   "endMs": "605120",
   "startTimeText": "10:00"
  },
  {
   "text": "가운데 떠나게 되겠죠.",
   "startMs": "602519",
   "endMs": "607399",
   "startTimeText": "10:02"
  },
  {
   "text": "그래서 한국 교회 가운데 이단들이",
   "startMs": "605120",
   "endMs": "610959",
   "startTimeText": "10:05"
  },
  {
   "text": "많이 들어와 가지고 어 그 교회가",
   "startMs": "607399",
   "endMs": "614000",
   "startTimeText": "10:07"
  },
  {
   "text": "갈라지고 무너지게 되는 어 가장 큰",
   "startMs": "610959",
   "endMs": "617040",
   "startTimeText": "10:10"
  },
  {
   "text": "이유는 바로 성도들이 말씀과 구원의",
   "startMs": "614000",
   "endMs": "618920",
   "startTimeText": "10:14"
  },
  {
   "text": "복음 가운데 분명하게서 있지 않기",
   "startMs": "617040",
   "endMs": "621760",
   "startTimeText": "10:17"
  },
  {
   "text": "때문에 그들이 얘기할 때 그들과",
   "startMs": "618920",
   "endMs": "622760",
   "startTimeText": "10:18"
  },
  {
   "text": "친하게",
   "startMs": "621760",
   "endMs": "625240",
   "startTimeText": "10:21"
  },
  {
   "text": "지내고에 그들의 어떤 사상 가운데",
   "startMs": "622760",
   "endMs": "627920",
   "startTimeText": "10:22"
  },
  {
   "text": "넘어서서 넘어가 가지고 그들에게",
   "startMs": "625240",
   "endMs": "631680",
   "startTimeText": "10:25"
  },
  {
   "text": "먹이를 계속 주게 되고 어 넘어가",
   "startMs": "627920",
   "endMs": "634240",
   "startTimeText": "10:27"
  },
  {
   "text": "가지고 많은 사람들이 무너지는 는",
   "startMs": "631680",
   "endMs": "636519",
   "startTimeText": "10:31"
  },
  {
   "text": "경우를 볼 수가 있습니다. 근데",
   "startMs": "634240",
   "endMs": "639160",
   "startTimeText": "10:34"
  },
  {
   "text": "성도들 각자가 말씀 가운데 분명하게서",
   "startMs": "636519",
   "endMs": "641440",
   "startTimeText": "10:36"
  },
  {
   "text": "있다면 그들이 접근할 때 한두 번",
   "startMs": "639160",
   "endMs": "644120",
   "startTimeText": "10:39"
  },
  {
   "text": "훈기하고 멀리하고 더 이상 가까이",
   "startMs": "641440",
   "endMs": "646360",
   "startTimeText": "10:41"
  },
  {
   "text": "지내지 아니하고 그렇게 된다면 그",
   "startMs": "644120",
   "endMs": "649519",
   "startTimeText": "10:44"
  },
  {
   "text": "사기치려는 사람이 힘을 잃게 되어서",
   "startMs": "646360",
   "endMs": "651920",
   "startTimeText": "10:46"
  },
  {
   "text": "어 우리가",
   "startMs": "649519",
   "endMs": "655079",
   "startTimeText": "10:49"
  },
  {
   "text": "온전하게에 그런 교회도 아름답게 진리",
   "startMs": "651920",
   "endMs": "657120",
   "startTimeText": "10:51"
  },
  {
   "text": "가운데 성장할 수 있게 되겠죠.",
   "startMs": "655079",
   "endMs": "660600",
   "startTimeText": "10:55"
  },
  {
   "text": "결국에는 말씀을 분명히 알고 그",
   "startMs": "657120",
   "endMs": "664040",
   "startTimeText": "10:57"
  },
  {
   "text": "말씀에 비춰서 나를 비춰보고 말씀에",
   "startMs": "660600",
   "endMs": "666680",
   "startTimeText": "11:00"
  },
  {
   "text": "비춰서 다른 사람들을 분별할 수",
   "startMs": "664040",
   "endMs": "669839",
   "startTimeText": "11:04"
  },
  {
   "text": "있는에 그런 능력을 갖는 것이 바로",
   "startMs": "666680",
   "endMs": "671639",
   "startTimeText": "11:06"
  },
  {
   "text": "이단으로부터 우리를 지킬 수 있는",
   "startMs": "669839",
   "endMs": "673959",
   "startTimeText": "11:09"
  },
  {
   "text": "방법이라고 생각합니다. 그래서 꼭",
   "startMs": "671639",
   "endMs": "677720",
   "startTimeText": "11:11"
  },
  {
   "text": "기억하십시오. 어 오늘도 마귀처럼",
   "startMs": "673959",
   "endMs": "680720",
   "startTimeText": "11:13"
  },
  {
   "text": "우리를 무너뜨리려고 하는 악한 길로",
   "startMs": "677720",
   "endMs": "683360",
   "startTimeText": "11:17"
  },
  {
   "text": "끌고 가려는 그런 사람들은 분명히",
   "startMs": "680720",
   "endMs": "685880",
   "startTimeText": "11:20"
  },
  {
   "text": "존재할 수 있다라는 거죠. 너무",
   "startMs": "683360",
   "endMs": "688120",
   "startTimeText": "11:23"
  },
  {
   "text": "마음이 착해서 모든 사람들이 선한",
   "startMs": "685880",
   "endMs": "690600",
   "startTimeText": "11:25"
  },
  {
   "text": "목적을 가지고 간다라고 생각하지",
   "startMs": "688120",
   "endMs": "693000",
   "startTimeText": "11:28"
  },
  {
   "text": "마셨으면 좋겠습니다. 이단에 속한",
   "startMs": "690600",
   "endMs": "695040",
   "startTimeText": "11:30"
  },
  {
   "text": "사람 이런 사람들은",
   "startMs": "693000",
   "endMs": "697839",
   "startTimeText": "11:33"
  },
  {
   "text": "마음부터 부패하여 가지고 다른",
   "startMs": "695040",
   "endMs": "700000",
   "startTimeText": "11:35"
  },
  {
   "text": "사람들을 무너뜨리려고 하는 의도로",
   "startMs": "697839",
   "endMs": "702800",
   "startTimeText": "11:37"
  },
  {
   "text": "접근하는 사람들이 반드시 있다.",
   "startMs": "700000",
   "endMs": "703920",
   "startTimeText": "11:40"
  },
  {
   "text": "말씀에",
   "startMs": "702800",
   "endMs": "707079",
   "startTimeText": "11:42"
  },
  {
   "text": "비춰서 그런 사람들이 있다면 그런",
   "startMs": "703920",
   "endMs": "710279",
   "startTimeText": "11:43"
  },
  {
   "text": "사람들과 논쟁하지 말고 그런 사람들과",
   "startMs": "707079",
   "endMs": "713079",
   "startTimeText": "11:47"
  },
  {
   "text": "계속 친하게 지내지 말고 멀리하고",
   "startMs": "710279",
   "endMs": "715320",
   "startTimeText": "11:50"
  },
  {
   "text": "한두 번 훈기하고 멀리하면서 너",
   "startMs": "713079",
   "endMs": "717959",
   "startTimeText": "11:53"
  },
  {
   "text": "자신을 잘 지켜서 너는 오로지 말씀",
   "startMs": "715320",
   "endMs": "720279",
   "startTimeText": "11:55"
  },
  {
   "text": "가운데 굳건하게 서서 나아가라.",
   "startMs": "717959",
   "endMs": "723120",
   "startTimeText": "11:57"
  },
  {
   "text": "주님께서 그렇게 말씀하고 계십니다.",
   "startMs": "720279",
   "endMs": "725240",
   "startTimeText": "12:00"
  },
  {
   "text": "그런 여러분들이 되시기를 주님의",
   "startMs": "723120",
   "endMs": "728240",
   "startTimeText": "12:03"
  },
  {
   "text": "이름으로 축원합니다.",
   "startMs": "725240",
   "endMs": "728240",
   "startTimeText": "12:05"
  }
 ]
}