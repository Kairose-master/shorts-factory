   "startTimeText": "4:40"
  },
  {
   "text": "하여주시고 십자가에 난 하나의",
   "startMs": "282400",
   "endMs": "289840",
   "startTimeText": "4:42"
  },
  {
   "text": "사과에게 부진 없는",
