 "transcript": [
  {
   "text": "찬송가 545장 함께",
   "startMs": "1079",
   "endMs": "6279",
   "startTimeText": "0:01"
  },
  {
   "text": "찬양하시는 5월 27일 월요일",
   "startMs": "3440",
   "endMs": "9200",
   "startTimeText": "0:03"
  },
  {
   "text": "새벽기도 하나님께",
   "startMs": "6279",
   "endMs": "9200",
   "startTimeText": "0:06"
  },
  {
   "text": "[음악]",
   "startMs": "16070",
   "endMs": "19339",
   "startTimeText": "0:16"
  },
  {
   "text": "드시겠지요이 귀에 아무 소리 안이",
   "startMs": "24800",
   "endMs": "30080",
   "startTimeText": "0:24"
  },
  {
   "text": "들려도",
   "startMs": "28119",
   "endMs": "33800",
   "startTimeText": "0:28"
  },
  {
   "text": "하나님의 약속 위에",
   "startMs": "30080",
   "endMs": "36280",
   "startTimeText": "0:30"
  },
  {
   "text": "서리라",
   "startMs": "33800",
   "endMs": "41239",
   "startTimeText": "0:33"
  },
  {
   "text": "걸어가세 믿음 위에 서서 나가세",
   "startMs": "36280",
   "endMs": "43800",
   "startTimeText": "0:36"
  },
  {
   "text": "나가세 의심",
   "startMs": "41239",
   "endMs": "46320",
   "startTimeText": "0:41"
  },
  {
   "text": "버리고",
   "startMs": "43800",
   "endMs": "51120",
   "startTimeText": "0:43"
  },
  {
   "text": "걸어가세 믿음위에 서서 눈과 귀에",
   "startMs": "46320",
   "endMs": "54440",
   "startTimeText": "0:46"
  },
  {
   "text": "아무 증거",
   "startMs": "51120",
   "endMs": "58920",
   "startTimeText": "0:51"
  },
  {
   "text": "없어도이 눈에 보기에는",
   "startMs": "54440",
   "endMs": "64760",
   "startTimeText": "0:54"
  },
  {
   "text": "어떠하든지 얻은 증거대로 늘 믿으며",
   "startMs": "58920",
   "endMs": "68400",
   "startTimeText": "0:58"
  },
  {
   "text": "마음에 의심없이 살아갈",
   "startMs": "64760",
   "endMs": "73119",
   "startTimeText": "1:04"
  },
  {
   "text": "때에 우리 소원 주 안에서",
   "startMs": "68400",
   "endMs": "75600",
   "startTimeText": "1:08"
  },
  {
   "text": "이르리",
   "startMs": "73119",
   "endMs": "80479",
   "startTimeText": "1:13"
  },
  {
   "text": "걸어가세 믿음 위에 서서 나가세",
   "startMs": "75600",
   "endMs": "83000",
   "startTimeText": "1:15"
  },
  {
   "text": "나가세 의심",
   "startMs": "80479",
   "endMs": "85439",
   "startTimeText": "1:20"
  },
  {
   "text": "버리고",
   "startMs": "83000",
   "endMs": "90280",
   "startTimeText": "1:23"
  },
  {
   "text": "걸어가세 믿음 위에 서서 눈과 귀",
   "startMs": "85439",
   "endMs": "92880",
   "startTimeText": "1:25"
  },
  {
   "text": "아무 증거",
   "startMs": "90280",
   "endMs": "97759",
   "startTimeText": "1:30"
  },
  {
   "text": "없어도 주님의 거룩함을 두고",
   "startMs": "92880",
   "endMs": "102680",
   "startTimeText": "1:32"
  },
  {
   "text": "맹세한 주 하나님 아버지는 참",
   "startMs": "97759",
   "endMs": "107439",
   "startTimeText": "1:37"
  },
  {
   "text": "미쁘다 그 귀한 모든 약속 믿는",
   "startMs": "102680",
   "endMs": "112320",
   "startTimeText": "1:42"
  },
  {
   "text": "자에게 능치 못할 무슨 일이",
   "startMs": "107439",
   "endMs": "118840",
   "startTimeText": "1:47"
  },
  {
   "text": "있을까 거어 가세 믿음 위해 서서",
   "startMs": "112320",
   "endMs": "122280",
   "startTimeText": "1:52"
  },
  {
   "text": "나가세 가세 의심",
   "startMs": "118840",
   "endMs": "124840",
   "startTimeText": "1:58"
  },
  {
   "text": "버리고",
   "startMs": "122280",
   "endMs": "129599",
   "startTimeText": "2:02"
  },
  {
   "text": "걸어가세 믿음 위에 서서 눈과 귀에",
   "startMs": "124840",
   "endMs": "132720",
   "startTimeText": "2:04"
  },
  {
   "text": "아무 증거",
   "startMs": "129599",
   "endMs": "134280",
   "startTimeText": "2:09"
  },
  {
   "text": "없어도",
   "startMs": "132720",
   "endMs": "137000",
   "startTimeText": "2:12"
  },
  {
   "text": "아멘 기도하시겠습니다",
   "startMs": "134280",
   "endMs": "140400",
   "startTimeText": "2:14"
  },
  {
   "text": "살아계신 하나님 오늘도 새로운 생명을",
   "startMs": "137000",
   "endMs": "143080",
   "startTimeText": "2:17"
  },
  {
   "text": "주시고 건강을 주셔서",
   "startMs": "140400",
   "endMs": "145720",
   "startTimeText": "2:20"
  },
  {
   "text": "감사드립니다 예배당으로 불러주시고",
   "startMs": "143080",
   "endMs": "147360",
   "startTimeText": "2:23"
  },
  {
   "text": "기도할 수 있는 모든 여건들을",
   "startMs": "145720",
   "endMs": "150120",
   "startTimeText": "2:25"
  },
  {
   "text": "허락하여 주셔서 감사드립니다",
   "startMs": "147360",
   "endMs": "152879",
   "startTimeText": "2:27"
  },
  {
   "text": "하나님이 기도 시간에 우리가 간절히",
   "startMs": "150120",
   "endMs": "155640",
   "startTimeText": "2:30"
  },
  {
   "text": "기도할 수 있는 기도의 힘을 더하여",
   "startMs": "152879",
   "endMs": "157879",
   "startTimeText": "2:32"
  },
  {
   "text": "주시옵소서 하나님 우리가이 세상을",
   "startMs": "155640",
   "endMs": "160440",
   "startTimeText": "2:35"
  },
  {
   "text": "살아갈 때에 우리가 감정에 이끌리는",
   "startMs": "157879",
   "endMs": "163400",
   "startTimeText": "2:37"
  },
  {
   "text": "것이 아니라 하나님 말씀 위에 굳건히",
   "startMs": "160440",
   "endMs": "166239",
   "startTimeText": "2:40"
  },
  {
   "text": "서서 이성적으로 판단하고 이해하는",
   "startMs": "163400",
   "endMs": "168599",
   "startTimeText": "2:43"
  },
  {
   "text": "가운데에 신앙생활을 해 나갈 수",
   "startMs": "166239",
   "endMs": "171280",
   "startTimeText": "2:46"
  },
  {
   "text": "있도록 도와주시옵소서 우리가 눈에",
   "startMs": "168599",
   "endMs": "173760",
   "startTimeText": "2:48"
  },
  {
   "text": "느끼는 것이 없고 손에 잡히는 것이",
   "startMs": "171280",
   "endMs": "176640",
   "startTimeText": "2:51"
  },
  {
   "text": "없고 감정적으로 다가오는 것이",
   "startMs": "173760",
   "endMs": "179319",
   "startTimeText": "2:53"
  },
  {
   "text": "없을지라도 하나님이 이미 기록하신 그",
   "startMs": "176640",
   "endMs": "181680",
   "startTimeText": "2:56"
  },
  {
   "text": "말씀을 믿는 믿음으로 믿음 위에",
   "startMs": "179319",
   "endMs": "184319",
   "startTimeText": "2:59"
  },
  {
   "text": "굳건하게 서서 앞으로 한 발 짝씩",
   "startMs": "181680",
   "endMs": "186599",
   "startTimeText": "3:01"
  },
  {
   "text": "나아가는 우리의 신앙생활이 될 수",
   "startMs": "184319",
   "endMs": "189360",
   "startTimeText": "3:04"
  },
  {
   "text": "있도록 은혜를 베풀어 주시옵소서이",
   "startMs": "186599",
   "endMs": "191400",
   "startTimeText": "3:06"
  },
  {
   "text": "시간에도 성령님 충만하게 임하여",
   "startMs": "189360",
   "endMs": "193840",
   "startTimeText": "3:09"
  },
  {
   "text": "주셔서 말씀을 깨달을 수 있도록",
   "startMs": "191400",
   "endMs": "196280",
   "startTimeText": "3:11"
  },
  {
   "text": "도와주시고 말씀 가운데에 주님의",
   "startMs": "193840",
   "endMs": "198519",
   "startTimeText": "3:13"
  },
  {
   "text": "음성을들을 수 있도록 도와주시옵소서",
   "startMs": "196280",
   "endMs": "202239",
   "startTimeText": "3:16"
  },
  {
   "text": "예수님 이름으로 기도합니다 아멘 아멘",
   "startMs": "198519",
   "endMs": "204040",
   "startTimeText": "3:18"
  },
  {
   "text": "오늘 함께 오실 하나님 말씀은",
   "startMs": "202239",
   "endMs": "207720",
   "startTimeText": "3:22"
  },
  {
   "text": "마태복음 12장 38절 45절지",
   "startMs": "204040",
   "endMs": "210720",
   "startTimeText": "3:24"
  },
  {
   "text": "말씀입니다",
   "startMs": "207720",
   "endMs": "210720",
   "startTimeText": "3:27"
  },
  {
   "text": "마태복음 12장 38절 45절 지의",
   "startMs": "211280",
   "endMs": "219319",
   "startTimeText": "3:31"
  },
  {
   "text": "말씀 함께 찾 주시는 위에 교독",
   "startMs": "214879",
   "endMs": "219319",
   "startTimeText": "3:34"
  },
  {
   "text": "아시겠습니다만",
   "startMs": "225560",
   "endMs": "230000",
   "startTimeText": "3:45"
  },
  {
   "text": "선생님이여 우리에게 표적 보여 주시길",
   "startMs": "227360",
   "endMs": "233120",
   "startTimeText": "3:47"
  },
  {
   "text": "원하나이다 예수께서 대답하여 이르시되",
   "startMs": "230000",
   "endMs": "236159",
   "startTimeText": "3:50"
  },
  {
   "text": "악하고 음란한 세대가 표적을 구하나",
   "startMs": "233120",
   "endMs": "238480",
   "startTimeText": "3:53"
  },
  {
   "text": "선지자 요나의 표적 밖에는 보일",
   "startMs": "236159",
   "endMs": "241959",
   "startTimeText": "3:56"
  },
  {
   "text": "표적이 없느니라 요나가 밤낮 월 동안",
   "startMs": "238480",
   "endMs": "244959",
   "startTimeText": "3:58"
  },
  {
   "text": "큰 물고기 뱃속에 있었던 것 같이",
   "startMs": "241959",
   "endMs": "248480",
   "startTimeText": "4:01"
  },
  {
   "text": "인자도 밤낮 월 동안 땅속에 있으리라",
   "startMs": "244959",
   "endMs": "251200",
   "startTimeText": "4:04"
  },
  {
   "text": "심판 때에 니누 사람들이 일어나",
   "startMs": "248480",
   "endMs": "252959",
   "startTimeText": "4:08"
  },
  {
   "text": "이세대 사람을",
   "startMs": "251200",
   "endMs": "255439",
   "startTimeText": "4:11"
  },
  {
   "text": "정죄하리니이는 그들이 요나의 전도를",
   "startMs": "252959",
   "endMs": "258560",
   "startTimeText": "4:12"
  },
  {
   "text": "듣고 하였음 이거니와 요나보다 더",
   "startMs": "255439",
   "endMs": "261840",
   "startTimeText": "4:15"
  },
  {
   "text": "큰이가 여기 있으며 심판 때에 남방",
   "startMs": "258560",
   "endMs": "264880",
   "startTimeText": "4:18"
  },
  {
   "text": "여왕이 일어나이 세대 사람을",
   "startMs": "261840",
   "endMs": "267639",
   "startTimeText": "4:21"
  },
  {
   "text": "정죄하리니이는 그가 솔로몬의 지혜로운",
   "startMs": "264880",
   "endMs": "271280",
   "startTimeText": "4:24"
  },
  {
   "text": "말을 들으려고 땅끝에",
   "startMs": "267639",
   "endMs": "275520",
   "startTimeText": "4:27"
  },
  {
   "text": "솔로몬보다 더큰가 있라 더운 귀신이",
   "startMs": "271280",
   "endMs": "279280",
   "startTimeText": "4:31"
  },
  {
   "text": "람서 나갔을에 물없는 것으로 다니며",
   "startMs": "275520",
   "endMs": "282639",
   "startTimeText": "4:35"
  },
  {
   "text": "쉬기를 구하되 쉴곳을 얻지 못하고",
   "startMs": "279280",
   "endMs": "285120",
   "startTimeText": "4:39"
  },
  {
   "text": "이에 이르되 내가 나온 내 집으로",
   "startMs": "282639",
   "endMs": "288880",
   "startTimeText": "4:42"
  },
  {
   "text": "돌아가리라 하고 보니 그집이",
   "startMs": "285120",
   "endMs": "292840",
   "startTimeText": "4:45"
  },
  {
   "text": "고되고 되었거늘 이에 가서 저보다 더",
   "startMs": "288880",
   "endMs": "295479",
   "startTimeText": "4:48"
  },
  {
   "text": "악한 귀신 일곱을 데리고 들어가서",
   "startMs": "292840",
   "endMs": "301360",
   "startTimeText": "4:52"
  },
  {
   "text": "거하니 그 사람의 중편이 보다",
   "startMs": "295479",
   "endMs": "301360",
   "startTimeText": "4:55"
  },
  {
   "text": "라 아 예수님께서 38절 말씀에",
   "startMs": "304199",
   "endMs": "313639",
   "startTimeText": "5:04"
  },
  {
   "text": "39절 말씀에 예수께서 답하여 이시",
   "startMs": "309199",
   "endMs": "318520",
   "startTimeText": "5:09"
  },
  {
   "text": "악고 란한 대가 표적을 하선자 요의",
   "startMs": "313639",
   "endMs": "320240",
   "startTimeText": "5:13"
  },
  {
   "text": "밖는",
   "startMs": "318520",
   "endMs": "321880",
   "startTimeText": "5:18"
  },
  {
   "text": "적이라",
   "startMs": "320240",
   "endMs": "324880",
   "startTimeText": "5:20"
  },
  {
   "text": "말씀하셨습니다 악",
   "startMs": "321880",
   "endMs": "328639",
   "startTimeText": "5:21"
  },
  {
   "text": "란을 했다고",
   "startMs": "324880",
   "endMs": "332720",
   "startTimeText": "5:24"
  },
  {
   "text": "시 란한 세대를 이제 함축적으로",
   "startMs": "328639",
   "endMs": "336160",
   "startTimeText": "5:28"
  },
  {
   "text": "표현했을 때에 자극을 추구하는",
   "startMs": "332720",
   "endMs": "339199",
   "startTimeText": "5:32"
  },
  {
   "text": "세대라고 이해할 수 있을 것 같습니다",
   "startMs": "336160",
   "endMs": "344479",
   "startTimeText": "5:36"
  },
  {
   "text": "그래서 모든 악과 음란함은 어 모든",
   "startMs": "339199",
   "endMs": "348160",
   "startTimeText": "5:39"
  },
  {
   "text": "죄는 대부분 어떤 강렬한 감정적인",
   "startMs": "344479",
   "endMs": "350600",
   "startTimeText": "5:44"
  },
  {
   "text": "자극을 불러 일으키는 것이고요",
   "startMs": "348160",
   "endMs": "353479",
   "startTimeText": "5:48"
  },
  {
   "text": "사람들은 그 감정적인 그 자극을",
   "startMs": "350600",
   "endMs": "357720",
   "startTimeText": "5:50"
  },
  {
   "text": "충족하기 위해서 그래서 죄를 짓는",
   "startMs": "353479",
   "endMs": "360319",
   "startTimeText": "5:53"
  },
  {
   "text": "것입니다이 세대의",
   "startMs": "357720",
   "endMs": "363919",
   "startTimeText": "5:57"
  },
  {
   "text": "어 분위기 문화가 아마 대부분 그렇지",
   "startMs": "360319",
   "endMs": "367080",
   "startTimeText": "6:00"
  },
  {
