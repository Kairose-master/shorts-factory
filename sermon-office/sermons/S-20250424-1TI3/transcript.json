 ],
 "transcript": [
  {
   "text": "오늘 새벽 기도 녹음이 안 돼 가지고",
   "startMs": "1800",
   "endMs": "8080",
   "startTimeText": "0:01"
  },
  {
   "text": "오늘 간단하게 또 기도와 핵심",
   "startMs": "4080",
   "endMs": "10679",
   "startTimeText": "0:04"
  },
  {
   "text": "메시지를에 다시 이렇게",
   "startMs": "8080",
   "endMs": "13960",
   "startTimeText": "0:08"
  },
  {
   "text": "녹음해서 어 여러분들에게 전합니다.",
   "startMs": "10679",
   "endMs": "16400",
   "startTimeText": "0:10"
  },
  {
   "text": "어 양해 바랍니다.에",
   "startMs": "13960",
   "endMs": "18199",
   "startTimeText": "0:13"
  },
  {
   "text": "기도하시겠습니다. 하나님 아버지",
   "startMs": "16400",
   "endMs": "20600",
   "startTimeText": "0:16"
  },
  {
   "text": "오늘도 주 앞에 나와 기도하게 하시고",
   "startMs": "18199",
   "endMs": "22760",
   "startTimeText": "0:18"
  },
  {
   "text": "그리스도인으로 살아가게 하시니",
   "startMs": "20600",
   "endMs": "24760",
   "startTimeText": "0:20"
  },
  {
   "text": "감사드립니다. 또한 교회를 세우는",
   "startMs": "22760",
   "endMs": "27679",
   "startTimeText": "0:22"
  },
  {
   "text": "일꾼으로 세우시고 직분을 맡겨 주셔서",
   "startMs": "24760",
   "endMs": "29759",
   "startTimeText": "0:24"
  },
  {
   "text": "감사드립니다. 선한 일을 사모하는",
   "startMs": "27679",
   "endMs": "32079",
   "startTimeText": "0:27"
  },
  {
   "text": "마음을 주시고 직분을 주셨으니",
   "startMs": "29759",
   "endMs": "34239",
   "startTimeText": "0:29"
  },
  {
   "text": "하나님이 인도하심을 따라 직분을 잘",
   "startMs": "32079",
   "endMs": "36640",
   "startTimeText": "0:32"
  },
  {
   "text": "감당하는 우리 모두가 되게 하여",
   "startMs": "34239",
   "endMs": "38559",
   "startTimeText": "0:34"
  },
  {
   "text": "주시옵소서. 하나님 아버지 우리",
   "startMs": "36640",
   "endMs": "41160",
   "startTimeText": "0:36"
  },
  {
   "text": "예신교회 직분자들이 있습니다. 직분을",
   "startMs": "38559",
   "endMs": "43680",
   "startTimeText": "0:38"
  },
  {
   "text": "처음 받을 때 마음과 자세를 기억하게",
   "startMs": "41160",
   "endMs": "46480",
   "startTimeText": "0:41"
  },
  {
   "text": "하시고 교회 모든 일을 잘 감당하도록",
   "startMs": "43680",
   "endMs": "48800",
   "startTimeText": "0:43"
  },
  {
   "text": "인도하여 주시옵소서. 교회가 잘",
   "startMs": "46480",
   "endMs": "51320",
   "startTimeText": "0:46"
  },
  {
   "text": "성장할 수 있도록 하여 주시고",
   "startMs": "48800",
   "endMs": "54000",
   "startTimeText": "0:48"
  },
  {
   "text": "하나님께서 훌륭한 리더십을 허락하여",
   "startMs": "51320",
   "endMs": "56879",
   "startTimeText": "0:51"
  },
  {
   "text": "주셔서 인격에 있어서도 잘 빚어지게",
   "startMs": "54000",
   "endMs": "59399",
   "startTimeText": "0:54"
  },
  {
   "text": "하시고 성김에 있어서도 자원하는",
   "startMs": "56879",
   "endMs": "61600",
   "startTimeText": "0:56"
  },
  {
   "text": "마음으로 기쁨으로 감당하게 하여",
   "startMs": "59399",
   "endMs": "64080",
   "startTimeText": "0:59"
  },
  {
   "text": "주시옵소서. 또한 세상의 사람들에게",
   "startMs": "61600",
   "endMs": "66320",
   "startTimeText": "1:01"
  },
  {
   "text": "있어서도 늘 그리스도의 인해 선한",
   "startMs": "64080",
   "endMs": "68799",
   "startTimeText": "1:04"
  },
  {
   "text": "모습을 드러낼 수 있도록 공손하게",
   "startMs": "66320",
   "endMs": "71159",
   "startTimeText": "1:06"
  },
  {
   "text": "되며 친절함으로 나아가는 직분자들이",
   "startMs": "68799",
   "endMs": "73680",
   "startTimeText": "1:08"
  },
  {
   "text": "되도록 역사하여 주시옵소서.",
   "startMs": "71159",
   "endMs": "76280",
   "startTimeText": "1:11"
  },
  {
   "text": "하나님께서 각 목장에 목자들을",
   "startMs": "73680",
   "endMs": "78759",
   "startTimeText": "1:13"
  },
  {
   "text": "세우셨으니 사랑으로 섬기며 기도하며",
   "startMs": "76280",
   "endMs": "81439",
   "startTimeText": "1:16"
  },
  {
   "text": "격려하며 모은들의 평안과 교재함에",
   "startMs": "78759",
   "endMs": "83400",
   "startTimeText": "1:18"
  },
  {
   "text": "기쁨을 누릴 수 있도록 인도하여",
   "startMs": "81439",
   "endMs": "85840",
   "startTimeText": "1:21"
  },
  {
   "text": "주시옵소서. 하나님 아버지 나라와",
   "startMs": "83400",
   "endMs": "88079",
   "startTimeText": "1:23"
  },
  {
   "text": "민족을 위해 기도드립니다. 훌륭한",
   "startMs": "85840",
   "endMs": "90400",
   "startTimeText": "1:25"
  },
  {
   "text": "지도자들을 곳곳에 세워 주시길",
   "startMs": "88079",
   "endMs": "92759",
   "startTimeText": "1:28"
  },
  {
   "text": "원합니다. 각 사회의 영역들이",
   "startMs": "90400",
   "endMs": "95040",
   "startTimeText": "1:30"
  },
  {
   "text": "있습니다. 리더십을 발휘하면서 섬겨야",
   "startMs": "92759",
   "endMs": "98159",
   "startTimeText": "1:32"
  },
  {
   "text": "할 사람들이 많이 있는데 섬김에 본이",
   "startMs": "95040",
   "endMs": "100759",
   "startTimeText": "1:35"
  },
  {
   "text": "될 수 있는 사람들을 잘 세워 주시고",
   "startMs": "98159",
   "endMs": "104360",
   "startTimeText": "1:38"
  },
  {
   "text": "죄와 담대함과 용기를 허락하여 주셔서",
   "startMs": "100759",
   "endMs": "106880",
   "startTimeText": "1:40"
  },
  {
   "text": "또한 인내하면서 참을 수 있는 마음을",
   "startMs": "104360",
   "endMs": "109360",
   "startTimeText": "1:44"
  },
  {
   "text": "주셔서이 나라의 모든 영역을 잘",
   "startMs": "106880",
   "endMs": "110960",
   "startTimeText": "1:46"
  },
  {
   "text": "세워갈 수 있도록 인도하여",
   "startMs": "109360",
   "endMs": "113439",
   "startTimeText": "1:49"
  },
  {
   "text": "주시옵소서. 하나님 아버지 성도들을",
   "startMs": "110960",
   "endMs": "116320",
   "startTimeText": "1:50"
  },
  {
   "text": "위해서 간절히 기도드립니다. 오늘도",
   "startMs": "113439",
   "endMs": "118880",
   "startTimeText": "1:53"
  },
  {
   "text": "주의 구원과 치유를 위해서 기도드리는",
   "startMs": "116320",
   "endMs": "122000",
   "startTimeText": "1:56"
  },
  {
   "text": "성도들이 있습니다. 들으시고 응답하여",
   "startMs": "118880",
   "endMs": "124560",
   "startTimeText": "1:58"
  },
  {
   "text": "주시옵소서. 특별히 병으로 고통당하는",
   "startMs": "122000",
   "endMs": "127320",
   "startTimeText": "2:02"
  },
  {
   "text": "성도들을 돌보시고 일상의 삶이",
   "startMs": "124560",
   "endMs": "130119",
   "startTimeText": "2:04"
  },
  {
   "text": "가능하여지도록 인도하여 주시옵소서.",
   "startMs": "127320",
   "endMs": "133040",
   "startTimeText": "2:07"
  },
  {
   "text": "하나님께서 약속하심을 믿습니다. 같이",
   "startMs": "130119",
   "endMs": "136239",
   "startTimeText": "2:10"
  },
  {
   "text": "기도하고 인내하면서 주님을 바라볼 때",
   "startMs": "133040",
   "endMs": "139200",
   "startTimeText": "2:13"
  },
  {
   "text": "주님께서 치유하시고 일으키실 것이라고",
   "startMs": "136239",
   "endMs": "141840",
   "startTimeText": "2:16"
  },
  {
   "text": "말씀하신 그 말씀을 의지하면서",
   "startMs": "139200",
   "endMs": "145319",
   "startTimeText": "2:19"
  },
  {
   "text": "기도하오니 하나님의 은혜를 베풀어",
   "startMs": "141840",
   "endMs": "147519",
   "startTimeText": "2:21"
  },
  {
   "text": "주시옵소서. 또한 여러 가지 상황들",
   "startMs": "145319",
   "endMs": "149640",
   "startTimeText": "2:25"
  },
  {
   "text": "가운데 가정에 중요한 일들을 앞두고",
   "startMs": "147519",
   "endMs": "152080",
   "startTimeText": "2:27"
  },
  {
   "text": "있는 성도들이 있습니다. 모든 일에",
   "startMs": "149640",
   "endMs": "154640",
   "startTimeText": "2:29"
  },
  {
   "text": "죄를 더하여 주시고 인도하심을",
   "startMs": "152080",
   "endMs": "157120",
   "startTimeText": "2:32"
  },
  {
   "text": "허락하여 주시옵소서. 감사드리오며",
   "startMs": "154640",
   "endMs": "159280",
   "startTimeText": "2:34"
  },
  {
   "text": "예수님의 이름으로 기도드립니다.",
   "startMs": "157120",
   "endMs": "161680",
   "startTimeText": "2:37"
  },
  {
   "text": "아멘. 오늘 우리 가운데 주시는",
   "startMs": "159280",
   "endMs": "164239",
   "startTimeText": "2:39"
  },
  {
   "text": "하나님의 말씀은 디모데전서 3장",
   "startMs": "161680",
   "endMs": "167280",
   "startTimeText": "2:41"
  },
  {
   "text": "1절부터 7절까지의 말씀입니다.",
   "startMs": "164239",
   "endMs": "170159",
   "startTimeText": "2:44"
  },
  {
   "text": "디모데전서 3장 1절부터 7절까지",
   "startMs": "167280",
   "endMs": "173159",
   "startTimeText": "2:47"
  },
  {
   "text": "우리 같이 봉독하도록 하겠습니다.",
   "startMs": "170159",
   "endMs": "175800",
   "startTimeText": "2:50"
  },
  {
   "text": "미쁘다이 말이여 곧 사람이 감독의",
   "startMs": "173159",
   "endMs": "178280",
   "startTimeText": "2:53"
  },
  {
   "text": "직분을 얻으려함은 선한 일을 사모하는",
   "startMs": "175800",
   "endMs": "180959",
   "startTimeText": "2:55"
  },
  {
   "text": "것이라 함이로다. 그러므로 감독은",
   "startMs": "178280",
   "endMs": "183400",
   "startTimeText": "2:58"
  },
  {
   "text": "책망할 것이 없으며 한내의 남편이",
   "startMs": "180959",
   "endMs": "186799",
   "startTimeText": "3:00"
  },
  {
   "text": "되며 절제하며 신중하며 단정하며",
   "startMs": "183400",
   "endMs": "190000",
   "startTimeText": "3:03"
  },
  {
   "text": "나그네를 대접하며 가르치기를 잘하며",
   "startMs": "186799",
   "endMs": "192159",
   "startTimeText": "3:06"
  },
  {
   "text": "술을 즐기지 아니하며 구타하지",
   "startMs": "190000",
   "endMs": "194680",
   "startTimeText": "3:10"
  },
  {
   "text": "아니하며 오직 관용하며 다투지",
   "startMs": "192159",
   "endMs": "197560",
   "startTimeText": "3:12"
  },
  {
   "text": "아니하며 돈을 사랑하지 아니하며 자기",
   "startMs": "194680",
   "endMs": "200159",
   "startTimeText": "3:14"
  },
  {
   "text": "집을 잘 다스려 자녀들로 모든",
   "startMs": "197560",
   "endMs": "202319",
   "startTimeText": "3:17"
  },
  {
   "text": "공선함으로 복정하게 하는 자라야",
   "startMs": "200159",
   "endMs": "205280",
   "startTimeText": "3:20"
  },
  {
   "text": "할지며 사람이 자기 집을 다스릴 줄",
   "startMs": "202319",
   "endMs": "207879",
   "startTimeText": "3:22"
  },
  {
   "text": "알지 못하면 어찌 하나님의 교회를",
   "startMs": "205280",
   "endMs": "210519",
   "startTimeText": "3:25"
  },
  {
   "text": "돌보리요 새로한 자도 말지니",
   "startMs": "207879",
   "endMs": "212720",
   "startTimeText": "3:27"
  },
  {
   "text": "교만하여져서 마귀를 정제하는 그",
   "startMs": "210519",
   "endMs": "215560",
   "startTimeText": "3:30"
  },
  {
   "text": "정제에 빠질까 함이요 또한 외인에게서",
   "startMs": "212720",
   "endMs": "218720",
   "startTimeText": "3:32"
  },
  {
   "text": "선한 증거를 얻은 자라 할지니 비방과",
   "startMs": "215560",
   "endMs": "221400",
   "startTimeText": "3:35"
  },
  {
   "text": "마귀의 올무에 빠질까",
   "startMs": "218720",
   "endMs": "224360",
   "startTimeText": "3:38"
  },
  {
   "text": "염려하라. 디모데전서는 우리가 어떻게",
   "startMs": "221400",
   "endMs": "228200",
   "startTimeText": "3:41"
  },
  {
   "text": "해서 성숙한 신앙을 가질 것인가? 어",
   "startMs": "224360",
   "endMs": "230959",
   "startTimeText": "3:44"
  },
  {
   "text": "이제 교회 생활을 이제 한 10년",
   "startMs": "228200",
   "endMs": "234599",
   "startTimeText": "3:48"
  },
  {
   "text": "이상 이제 하게 될 때에 에베소",
   "startMs": "230959",
   "endMs": "236959",
   "startTimeText": "3:50"
  },
  {
   "text": "교회가 세 세워진지 10여년 이상이",
   "startMs": "234599",
   "endMs": "238640",
   "startTimeText": "3:54"
  },
  {
   "text": "되었지 않습니까?에",
   "startMs": "236959",
   "endMs": "241159",
   "startTimeText": "3:56"
  },
  {
   "text": "그러니까 그 가운데 이제 어린아이와",
   "startMs": "238640",
   "endMs": "245000",
   "startTimeText": "3:58"
  },
  {
   "text": "같은 상태를 벗어나서 이제 점점 점점",
   "startMs": "241159",
   "endMs": "248280",
   "startTimeText": "4:01"
  },
  {
   "text": "그리스도를 닮아가면서 성장하게 되고",
   "startMs": "245000",
   "endMs": "251120",
   "startTimeText": "4:05"
  },
  {
   "text": "그렇게 되면 거기에 머무르지만 말고",
   "startMs": "248280",
   "endMs": "254400",
   "startTimeText": "4:08"
  },
  {
   "text": "또한 직분을 얻어 가지고 어 섬기는",
   "startMs": "251120",
   "endMs": "257720",
   "startTimeText": "4:11"
  },
  {
   "text": "것이 얼마나 더 귀한 일이고 아름다운",
   "startMs": "254400",
   "endMs": "261959",
   "startTimeText": "4:14"
  },
  {
   "text": "일인가에 그것을에 이야기를에 하고",
   "startMs": "257720",
   "endMs": "265680",
   "startTimeText": "4:17"
  },
  {
   "text": "있습니다. 오늘 특별히 3장의 말씀은",
   "startMs": "261959",
   "endMs": "269199",
   "startTimeText": "4:21"
  },
  {
   "text": "감독과 집사를 세울 때 어떤 자격이",
   "startMs": "265680",
   "endMs": "271680",
   "startTimeText": "4:25"
  },
  {
   "text": "있었으면 좋겠느냐 이런 것들을 설명을",
   "startMs": "269199",
   "endMs": "275240",
   "startTimeText": "4:29"
  },
  {
   "text": "하고 있는데에 비단 뭐",
   "startMs": "271680",
   "endMs": "278240",
   "startTimeText": "4:31"
  },
  {
   "text": "직분을의에 초점을",
   "startMs": "275240",
   "endMs": "280880",
   "startTimeText": "4:35"
  },
  {
   "text": "맞추었다기보다는 성숙한 그리스도인으로",
   "startMs": "278240",
   "endMs": "283479",
   "startTimeText": "4:38"
  },
  {
   "text": "이렇게 성장하면서 그 과정",
   "startMs": "280880",
   "endMs": "286360",
   "startTimeText": "4:40"
  },
  {
   "text": "가운데에 우리의 마음이 변화되고",
   "startMs": "283479",
   "endMs": "289160",
   "startTimeText": "4:43"
  },
  {
   "text": "우리의 삶이 변화되어 가지고 직분을",
   "startMs": "286360",
   "endMs": "292199",
   "startTimeText": "4:46"
  },
  {
   "text": "얻으면서 섬길 수 있는 사람으로 어",
   "startMs": "289160",
   "endMs": "294639",
   "startTimeText": "4:49"
  },
  {
   "text": "이렇게 되었으면 좋겠다.에 그런",
   "startMs": "292199",
   "endMs": "299080",
   "startTimeText": "4:52"
  },
  {
   "text": "취지에서 어 적었다라고 어 생각하시면",
   "startMs": "294639",
   "endMs": "301880",
   "startTimeText": "4:54"
  },
  {
   "text": "되겠습니다. 1절에 보면 미쁘다이",
   "startMs": "299080",
   "endMs": "306440",
   "startTimeText": "4:59"
  },
  {
   "text": "말이여 이것은 정말로 어 귀한 것이고",
   "startMs": "301880",
   "endMs": "309320",
   "startTimeText": "5:01"
  },
  {
   "text": "신뢰할 만한 말이고 어 이렇게",
   "startMs": "306440",
   "endMs": "313080",
   "startTimeText": "5:06"
  },
  {
   "text": "되었으면 좋겠다. 정말로 이것은 아주",
   "startMs": "309320",
   "endMs": "315800",
   "startTimeText": "5:09"
  },
  {
   "text": "어 믿을 만한 말이다. 이것은 꼭",
   "startMs": "313080",
   "endMs": "319039",
   "startTimeText": "5:13"
  },
  {
   "text": "이렇게 되었으면 좋겠다라는 의미로 어",
   "startMs": "315800",
   "endMs": "322000",
   "startTimeText": "5:15"
  },
  {
   "text": "표현하고 있는데 곧 사람이 감독의",
   "startMs": "319039",
   "endMs": "323600",
   "startTimeText": "5:19"
  },
  {
   "text": "직분을",
   "startMs": "322000",
   "endMs": "326919",
   "startTimeText": "5:22"
  },
  {
   "text": "얻으려함은에 감독의 직분을에",
   "startMs": "323600",
   "endMs": "329919",
   "startTimeText": "5:23"
  },
  {
   "text": "얻으려고 하는 것은 정말로 귀한",
   "startMs": "326919",
   "endMs": "332440",
   "startTimeText": "5:26"
  },
  {
   "text": "일이다. 어 직분을 사모하는 것은",
   "startMs": "329919",
   "endMs": "335120",
   "startTimeText": "5:29"
  },
  {
   "text": "정말로 귀한 일이다. 그 직분을 왜",
   "startMs": "332440",
   "endMs": "338800",
   "startTimeText": "5:32"
  },
  {
   "text": "얻으려고 하느냐면 선한 일을 사모하기",
   "startMs": "335120",
   "endMs": "341479",
   "startTimeText": "5:35"
  },
  {
   "text": "때문에 감독의 직분을 얻으려고 하는",
   "startMs": "338800",
   "endMs": "345600",
   "startTimeText": "5:38"
  },
  {
   "text": "말은 어 얻으려고 한다는 것은 정말로",
   "startMs": "341479",
   "endMs": "348919",
   "startTimeText": "5:41"
  },
  {
   "text": "미쁘다. 아주 신뢰할 만하고 아주",
   "startMs": "345600",
   "endMs": "351080",
   "startTimeText": "5:45"
  },
  {
   "text": "귀한 일이다.",
   "startMs": "348919",
   "endMs": "354039",
   "startTimeText": "5:48"
  },
  {
   "text": "이렇게에 설명을 하고 있습니다.",
   "startMs": "351080",
   "endMs": "356720",
   "startTimeText": "5:51"
  },
  {
   "text": "그러니까 옛날에 초대교회 당시에는",
   "startMs": "354039",
   "endMs": "361039",
   "startTimeText": "5:54"
  },
  {
   "text": "직분이라는 것은 어 더 큰 성숙과 더",
   "startMs": "356720",
   "endMs": "365599",
   "startTimeText": "5:56"
  },
  {
   "text": "큰 희생의 자리를 누구든지 그렇게",
   "startMs": "361039",
   "endMs": "368639",
   "startTimeText": "6:01"
  },
  {
   "text": "생각하면서 그렇게 받아들였거든요.",
   "startMs": "365599",
   "endMs": "370759",
   "startTimeText": "6:05"
  },
  {
   "text": "에 그래서 정말로 내가 이제 주",
   "startMs": "368639",
   "endMs": "373880",
   "startTimeText": "6:08"
  },
  {
   "text": "안에서 성장을 했으니까 이제 직분을",
   "startMs": "370759",
   "endMs": "376479",
   "startTimeText": "6:10"
  },
  {
   "text": "맡아 가지고 더 성도들의 유익을 이해",
   "startMs": "373880",
   "endMs": "380000",
   "startTimeText": "6:13"
  },
  {
   "text": "가지고 해야 되겠다 이런 생각을에",
   "startMs": "376479",
   "endMs": "383199",
   "startTimeText": "6:16"
  },
  {
   "text": "가지면서 감독이 되려고 하는 것들은",
   "startMs": "380000",
   "endMs": "386800",
   "startTimeText": "6:20"
  },
  {
   "text": "정말로 귀한 일이다. 그러니까",
   "startMs": "383199",
   "endMs": "390440",
   "startTimeText": "6:23"
  },
  {
   "text": "오늘날에는 음은 직분을 안 맡으려고",
   "startMs": "386800",
   "endMs": "394000",
   "startTimeText": "6:26"
  },
  {
   "text": "하는 것이에 많잖아요.",
   "startMs": "390440",
   "endMs": "396680",
   "startTimeText": "6:30"
  },
  {
   "text": "근데에 사도 바울은 이렇게 이야기를",
   "startMs": "394000",
   "endMs": "400759",
   "startTimeText": "6:34"
  },
  {
   "text": "합니다. 어, 더 내가 성장하고",
   "startMs": "396680",
   "endMs": "403560",
   "startTimeText": "6:36"
  },
  {
   "text": "성숙했으니 이제 다른 사람들을 위해",
   "startMs": "400759",
   "endMs": "406440",
   "startTimeText": "6:40"
  },
  {
   "text": "가지고 더 섬기려고 해서 직분을",
   "startMs": "403560",
   "endMs": "409440",
   "startTimeText": "6:43"
  },
  {
   "text": "맡으려고 하는 것은 주 안에서 정말로",
   "startMs": "406440",
   "endMs": "412520",
   "startTimeText": "6:46"
  },
  {
   "text": "귀한 일이다. 아름다운 일이다.",
   "startMs": "409440",
   "endMs": "415440",
   "startTimeText": "6:49"
  },
  {
   "text": "교회가 이런 식으로 되는 것이",
   "startMs": "412520",
   "endMs": "418240",
   "startTimeText": "6:52"
  },
  {
   "text": "중요하다라고 이야기를 하고 있습니다.",
   "startMs": "415440",
   "endMs": "420360",
   "startTimeText": "6:55"
  },
  {
   "text": "그래서 선한 일을 사모하는 마음을",
   "startMs": "418240",
   "endMs": "423800",
   "startTimeText": "6:58"
  },
  {
   "text": "가지고 직분을 가지고 섬기려고 하는",
   "startMs": "420360",
   "endMs": "426520",
   "startTimeText": "7:00"
  },
  {
   "text": "일들이 도체 있다고 생각하면 얼마나",
   "startMs": "423800",
   "endMs": "428680",
   "startTimeText": "7:03"
  },
  {
   "text": "그 교회가 아름답게 성장할 수",
   "startMs": "426520",
   "endMs": "430400",
   "startTimeText": "7:06"
  },
  {
   "text": "있겠습니까?",
   "startMs": "428680",
   "endMs": "435240",
   "startTimeText": "7:08"
  },
  {
   "text": "그런데에 이제 감독이 되려고 했을 때",
   "startMs": "430400",
   "endMs": "437400",
   "startTimeText": "7:10"
  },
  {
   "text": "감독은",
   "startMs": "435240",
   "endMs": "440919",
   "startTimeText": "7:15"
  },
  {
   "text": "더 큰 리더십을 가지고 어 그",
   "startMs": "437400",
   "endMs": "443120",
   "startTimeText": "7:17"
  },
  {
   "text": "공동체를 섬기면서 이끌어 나가는",
   "startMs": "440919",
   "endMs": "446639",
   "startTimeText": "7:20"
  },
  {
   "text": "사람을 이야기를 하고 있는데 어 이런",
   "startMs": "443120",
   "endMs": "450199",
   "startTimeText": "7:23"
  },
  {
   "text": "사람이 감독이 되어야 된다. 그러니까",
   "startMs": "446639",
   "endMs": "453720",
   "startTimeText": "7:26"
  },
  {
   "text": "어 선한 마음을 가지고 선한 일을",
   "startMs": "450199",
   "endMs": "457039",
   "startTimeText": "7:30"
  },
  {
   "text": "잘하려고 해서에 감독이 되려고 했을",
   "startMs": "453720",
   "endMs": "459400",
   "startTimeText": "7:33"
  },
  {
   "text": "때 이런",
   "startMs": "457039",
   "endMs": "462240",
   "startTimeText": "7:37"
  },
  {
   "text": "자질이 갖춰진 사람이 되었으면",
   "startMs": "459400",
   "endMs": "465159",
   "startTimeText": "7:39"
  },
  {
   "text": "좋겠어. 이렇게 이야기를 하는 것이",
   "startMs": "462240",
   "endMs": "468000",
   "startTimeText": "7:42"
  },
  {
   "text": "이제 2절부터 나오는데",
   "startMs": "465159",
   "endMs": "471159",
   "startTimeText": "7:45"
  },
  {
   "text": "꼭 직분과 관련이 되지 않더라도",
   "startMs": "468000",
   "endMs": "473199",
   "startTimeText": "7:48"
  },
  {
   "text": "신앙에 있어서 어느 정도 성장하면",
   "startMs": "471159",
   "endMs": "477159",
   "startTimeText": "7:51"
  },
  {
   "text": "이런 모습으로 어 변화되어야 된다라는",
   "startMs": "473199",
   "endMs": "479919",
   "startTimeText": "7:53"
  },
  {
   "text": "그런 취지로 어 우리가 받아들이는",
   "startMs": "477159",
   "endMs": "482280",
   "startTimeText": "7:57"
  },
  {
   "text": "것이 더 맞는 거 같아요. 그러니까",
   "startMs": "479919",
   "endMs": "484759",
   "startTimeText": "7:59"
  },
  {
   "text": "신앙생활을 하게 되면 이런 이런",
   "startMs": "482280",
   "endMs": "488560",
   "startTimeText": "8:02"
  },
  {
   "text": "모습을 좀 가진 사람으로 성장해서",
   "startMs": "484759",
   "endMs": "491159",
   "startTimeText": "8:04"
  },
  {
   "text": "그러면서 선한 일을 하려고 하고",
   "startMs": "488560",
   "endMs": "495159",
   "startTimeText": "8:08"
  },
  {
   "text": "직분도 맡으면서 점점 점점 성숙하고",
   "startMs": "491159",
   "endMs": "498039",
   "startTimeText": "8:11"
  },
  {
   "text": "아름다운 모습을 가지고 있는 공동체가",
   "startMs": "495159",
   "endMs": "501199",
   "startTimeText": "8:15"
  },
  {
   "text": "될 수 있도록 너희들이 이런 식으로",
   "startMs": "498039",
   "endMs": "504400",
   "startTimeText": "8:18"
  },
  {
   "text": "어 먼저 변화되고 그다음에 선한 일을",
   "startMs": "501199",
   "endMs": "507080",
   "startTimeText": "8:21"
  },
  {
   "text": "하려고 하고 그다음에 직분도 맡으려고",
   "startMs": "504400",
   "endMs": "510120",
   "startTimeText": "8:24"
  },
  {
   "text": "해서 교회가 이런 것으로 가득찼으면",
   "startMs": "507080",
   "endMs": "512279",
   "startTimeText": "8:27"
  },
  {
   "text": "좋겠어 하는 사도 사도 바울의 이제",
   "startMs": "510120",
   "endMs": "516399",
   "startTimeText": "8:30"
  },
  {
   "text": "소망이 나와 있으니까 여기는 꼭",
   "startMs": "512279",
   "endMs": "519719",
   "startTimeText": "8:32"
  },
  {
   "text": "감독이 이런 모습을 가졌으면 좋겠다.",
   "startMs": "516399",
   "endMs": "521760",
   "startTimeText": "8:36"
  },
  {
   "text": "나는 감독이 될 거 아닌데요. 이렇게",
   "startMs": "519719",
   "endMs": "524800",
   "startTimeText": "8:39"
  },
  {
   "text": "생각하는게 아니라 어 감독의 어떤",
   "startMs": "521760",
   "endMs": "527800",
   "startTimeText": "8:41"
  },
  {
   "text": "자질에 대해서 어 나타나 있는 것을",
   "startMs": "524800",
   "endMs": "530720",
   "startTimeText": "8:44"
  },
  {
   "text": "보면서 나는 어떤 모습으로 변화되고",
   "startMs": "527800",
   "endMs": "534040",
   "startTimeText": "8:47"
  },
  {
   "text": "성장되고 있는가 어 성숙한 신앙인으로",
   "startMs": "530720",
   "endMs": "535640",
   "startTimeText": "8:50"
  },
  {
   "text": "이런 모습을 가지고 있는가 이런",
   "startMs": "534040",
   "endMs": "538320",
   "startTimeText": "8:54"
  },
  {
   "text": "것들을 점검하는 것이 더 중요하다라고",
   "startMs": "535640",
   "endMs": "539680",
   "startTimeText": "8:55"
  },
  {
   "text": "볼 수가",
   "startMs": "538320",
   "endMs": "542399",
   "startTimeText": "8:58"
  },
  {
   "text": "있습니다. 그래서 감독은 어떤 사람이",
   "startMs": "539680",
   "endMs": "544480",
   "startTimeText": "8:59"
  },
  {
   "text": "되었으면 좋겠느냐? 우리 신앙인이",
   "startMs": "542399",
   "endMs": "547240",
   "startTimeText": "9:02"
  },
  {
   "text": "어떤 사람으로 더 성장해야 되느냐?",
   "startMs": "544480",
   "endMs": "549640",
   "startTimeText": "9:04"
  },
  {
   "text": "첫 번째로 나온 것이 책망할 것이",
   "startMs": "547240",
   "endMs": "552560",
   "startTimeText": "9:07"
  },
  {
   "text": "없으며라고 되어 있습니다.요 책망할",
   "startMs": "549640",
   "endMs": "555320",
   "startTimeText": "9:09"
  },
  {
   "text": "것이 없다라는 말은",
   "startMs": "552560",
   "endMs": "558880",
   "startTimeText": "9:12"
  },
  {
   "text": "공격받지 않는 않는 사람이어야 된다.",
   "startMs": "555320",
   "endMs": "562320",
   "startTimeText": "9:15"
  },
  {
   "text": "그러니까 눈에 띄게 흠이 있어 가지고",
   "startMs": "558880",
   "endMs": "564920",
   "startTimeText": "9:18"
  },
  {
   "text": "계속 그 문제 때문에 공격받는 그런",
   "startMs": "562320",
   "endMs": "567519",
   "startTimeText": "9:22"
  },
  {
   "text": "사람이라면",
   "startMs": "564920",
   "endMs": "571160",
   "startTimeText": "9:24"
  },
  {
   "text": "그렇지 않도록 해야 된다. 책망할",
   "startMs": "567519",
   "endMs": "574839",
   "startTimeText": "9:27"
  },
  {
   "text": "것이 없는 사람이 되었으면 좋겠다.",
   "startMs": "571160",
   "endMs": "577360",
   "startTimeText": "9:31"
  },
  {
   "text": "그다음에 한 아내의 남편이 되며",
   "startMs": "574839",
   "endMs": "580120",
   "startTimeText": "9:34"
  },
  {
   "text": "이것은 꼭 어 아내가 있어야 된다라는",
   "startMs": "577360",
   "endMs": "582120",
   "startTimeText": "9:37"
  },
  {
   "text": "거, 배우자가 있어야 된다라는 것을",
   "startMs": "580120",
   "endMs": "585240",
   "startTimeText": "9:40"
  },
  {
   "text": "이야기를 하는게 아니라 여기 아내라고",
   "startMs": "582120",
   "endMs": "587920",
   "startTimeText": "9:42"
  },
  {
   "text": "표현을 했을 때 한 아내잖아요.",
   "startMs": "585240",
   "endMs": "590079",
   "startTimeText": "9:45"
  },
  {
   "text": "그러니까 어 여러 아내를 두지",
   "startMs": "587920",
   "endMs": "593680",
   "startTimeText": "9:47"
  },
  {
   "text": "아니하고 여러 사람에 대해서 어 그런",
   "startMs": "590079",
   "endMs": "597640",
   "startTimeText": "9:50"
  },
  {
   "text": "어떤 어 다른 대상자들이 마음에 있지",
   "startMs": "593680",
   "endMs": "601600",
   "startTimeText": "9:53"
  },
  {
   "text": "아니하고 그다음에 한 오직 나의",
   "startMs": "597640",
   "endMs": "604839",
   "startTimeText": "9:57"
  },
  {
   "text": "배우자에게에 충성을 다하고 신실한",
   "startMs": "601600",
   "endMs": "608800",
   "startTimeText": "10:01"
  },
  {
   "text": "그런 남편이 되며 어 그런 사람이",
   "startMs": "604839",
   "endMs": "611120",
   "startTimeText": "10:04"
  },
  {
   "text": "되었으면 좋겠다. 자기의 배우자를",
   "startMs": "608800",
   "endMs": "615000",
   "startTimeText": "10:08"
  },
  {
   "text": "소중히 여기면서 어 잘 어 이끌 수",
   "startMs": "611120",
   "endMs": "618640",
   "startTimeText": "10:11"
  },
  {
   "text": "있는에 한 아내의 남편이 되는 것이",
   "startMs": "615000",
   "endMs": "621920",
   "startTimeText": "10:15"
  },
  {
   "text": "중요하다. 어 이게 꼭 결혼을 해야",
   "startMs": "618640",
   "endMs": "625600",
   "startTimeText": "10:18"
  },
  {
   "text": "된다라는 의미는 아니죠. 사도 바울도",
   "startMs": "621920",
   "endMs": "628920",
   "startTimeText": "10:21"
  },
  {
   "text": "독신이었으니까요. 그러니까 한 아내를",
   "startMs": "625600",
   "endMs": "632000",
   "startTimeText": "10:25"
  },
  {
   "text": "잘 아껴 주는 그런 사람이 되는 것이",
   "startMs": "628920",
   "endMs": "634600",
   "startTimeText": "10:28"
  },
  {
   "text": "중요하다. 그다음에에",
   "startMs": "632000",
   "endMs": "636959",
   "startTimeText": "10:32"
  },
  {
   "text": "절제하며라고 나와 있는데 절제라는",
   "startMs": "634600",
   "endMs": "640519",
   "startTimeText": "10:34"
  },
  {
   "text": "것은 술과 관련된 의미로 원래는 먼저",
   "startMs": "636959",
   "endMs": "644680",
   "startTimeText": "10:36"
  },
  {
   "text": "쓰였거든요. 어 그러니까 술을 술에",
   "startMs": "640519",
   "endMs": "648440",
   "startTimeText": "10:40"
  },
  {
   "text": "너무 취해 가지고 어 욕망을 제어하지",
   "startMs": "644680",
   "endMs": "651760",
   "startTimeText": "10:44"
  },
  {
   "text": "못하는에 그런 모습이 없었으면",
   "startMs": "648440",
   "endMs": "654560",
   "startTimeText": "10:48"
  },
  {
   "text": "좋겠다. 에, 그러니까 술을 잘",
   "startMs": "651760",
   "endMs": "657079",
   "startTimeText": "10:51"
  },
  {
   "text": "제어할 수 있고 그다음에 더 넓은",
   "startMs": "654560",
   "endMs": "659720",
   "startTimeText": "10:54"
  },
  {
   "text": "의미로 보면은 세상에 많은 욕망을",
   "startMs": "657079",
   "endMs": "662680",
   "startTimeText": "10:57"
  },
  {
   "text": "제어하는에 그런 모습 그것이 바로",
   "startMs": "659720",
   "endMs": "665600",
   "startTimeText": "10:59"
  },
  {
   "text": "절제라는 것이죠. 절제했으면",
   "startMs": "662680",
   "endMs": "667959",
   "startTimeText": "11:02"
  },
  {
   "text": "좋겠다라고 이야기를 하고",
   "startMs": "665600",
   "endMs": "670839",
   "startTimeText": "11:05"
  },
  {
   "text": "있습니다. 그다음에",
   "startMs": "667959",
   "endMs": "673560",
   "startTimeText": "11:07"
  },
  {
   "text": "신중하며라는 말은 충동으로 행동하지",
   "startMs": "670839",
   "endMs": "677000",
   "startTimeText": "11:10"
  },
  {
   "text": "아니하고 매사에 분별력 있게 어",
   "startMs": "673560",
   "endMs": "680480",
   "startTimeText": "11:13"
  },
  {
   "text": "일순간의 충동으로 무언가를 결정하거나",
   "startMs": "677000",
   "endMs": "682480",
   "startTimeText": "11:17"
  },
  {
   "text": "어 충동으로 하는 것이 아니라",
   "startMs": "680480",
   "endMs": "685560",
   "startTimeText": "11:20"
  },
  {
   "text": "신중하게 생각하는 그런 모습들이",
   "startMs": "682480",
   "endMs": "687680",
   "startTimeText": "11:22"
  },
  {
   "text": "있었으면 좋겠다. 그다음에",
   "startMs": "685560",
   "endMs": "690760",
   "startTimeText": "11:25"
  },
  {
   "text": "단정하다라는 것은 행동이 선하고",
   "startMs": "687680",
   "endMs": "693079",
   "startTimeText": "11:27"
  },
  {
   "text": "무리하지 않게",
   "startMs": "690760",
   "endMs": "696279",
   "startTimeText": "11:30"
  },
  {
   "text": "진중하게 행하는 그런 모습.",
   "startMs": "693079",
   "endMs": "699360",
   "startTimeText": "11:33"
  },
  {
   "text": "그다음에 나그네를 대접하며 가르치기를",
   "startMs": "696279",
   "endMs": "703240",
   "startTimeText": "11:36"
  },
  {
   "text": "잘하면 나그네라는 것은 이제",
   "startMs": "699360",
   "endMs": "705320",
   "startTimeText": "11:39"
  },
  {
   "text": "그리스도인들이 그때 당시에 다른",
   "startMs": "703240",
   "endMs": "708560",
   "startTimeText": "11:43"
  },
  {
   "text": "지역들로 이렇게 방문을 하게 될 때",
   "startMs": "705320",
   "endMs": "711320",
   "startTimeText": "11:45"
  },
  {
   "text": "어 세상 사람들이 머무르던 곳에서",
   "startMs": "708560",
   "endMs": "715320",
   "startTimeText": "11:48"
  },
  {
   "text": "이제 있게 되면에 거기에 참 평안이",
   "startMs": "711320",
   "endMs": "716560",
   "startTimeText": "11:51"
  },
  {
   "text": "있지",
   "startMs": "715320",
   "endMs": "720760",
   "startTimeText": "11:55"
  },
  {
   "text": "아니하고에 그런 삶 생활이 좀",
   "startMs": "716560",
   "endMs": "723040",
   "startTimeText": "11:56"
  },
  {
   "text": "불편해지잖아요. 그래서 그때 당시에",
   "startMs": "720760",
   "endMs": "726720",
   "startTimeText": "12:00"
  },
  {
   "text": "이제 나그네를 그리스도인의 집에 잘",
   "startMs": "723040",
   "endMs": "729600",
   "startTimeText": "12:03"
  },
  {
   "text": "이렇게 영접해서 머무르게 하고 이렇게",
   "startMs": "726720",
   "endMs": "733079",
   "startTimeText": "12:06"
  },
  {
   "text": "환대해 주고 어 이랬던 것이 참으로",
   "startMs": "729600",
   "endMs": "735720",
   "startTimeText": "12:09"
  },
  {
   "text": "사람들에게 많은 안정감을 주고",
   "startMs": "733079",
   "endMs": "738760",
   "startTimeText": "12:13"
  },
  {
   "text": "편안함을 줬는데 이런 식으로 다른",
   "startMs": "735720",
   "endMs": "741720",
   "startTimeText": "12:15"
  },
  {
   "text": "사람들에 대해서 좀 이렇게 잘 환대해",
   "startMs": "738760",
   "endMs": "744399",
   "startTimeText": "12:18"
  },
  {
   "text": "줄 수 있고 대접해 줄 수 있는 사람",
   "startMs": "741720",
   "endMs": "747279",
   "startTimeText": "12:21"
  },
  {
   "text": "이런 사람이었으면 좋겠다라고 이야기를",
   "startMs": "744399",
   "endMs": "749440",
   "startTimeText": "12:24"
  },
  {
   "text": "하고 있습니다. 그다음에 가르치기를",
   "startMs": "747279",
   "endMs": "753519",
   "startTimeText": "12:27"
  },
  {
   "text": "잘해야 하고 이것은 말씀에 대해서 어",
   "startMs": "749440",
   "endMs": "756040",
   "startTimeText": "12:29"
  },
  {
   "text": "깨달음이 있고 말씀대로 다시",
   "startMs": "753519",
   "endMs": "758600",
   "startTimeText": "12:33"
  },
  {
   "text": "실천하면서 그것을 전달해 줄 수 있는",
   "startMs": "756040",
   "endMs": "761800",
   "startTimeText": "12:36"
  },
  {
   "text": "사람 어 그것을 이야기를",
   "startMs": "758600",
   "endMs": "764199",
   "startTimeText": "12:38"
  },
  {
   "text": "합니다. 어 그다음에 3절에 보면",
   "startMs": "761800",
   "endMs": "766880",
   "startTimeText": "12:41"
  },
  {
   "text": "술을 즐기지 아니하며 이거는 원으로",
   "startMs": "764199",
   "endMs": "768560",
   "startTimeText": "12:44"
  },
  {
   "text": "보면 술 곁에 오래 앉아 있는",
   "startMs": "766880",
   "endMs": "771880",
   "startTimeText": "12:46"
  },
  {
   "text": "사람이라는 뜻인데 어 늘 술을 옆에",
   "startMs": "768560",
   "endMs": "775160",
   "startTimeText": "12:48"
  },
  {
   "text": "두는 사람이 아니어야 되고 구타하지",
   "startMs": "771880",
   "endMs": "778399",
   "startTimeText": "12:51"
  },
  {
   "text": "아니하고 이것은 성질이 급하여서 어",
   "startMs": "775160",
   "endMs": "781720",
   "startTimeText": "12:55"
  },
  {
   "text": "폭력을 쓰는 행동을 이야기를 하는데",
   "startMs": "778399",
   "endMs": "784320",
   "startTimeText": "12:58"
  },
  {
   "text": "그뿐만 아니라 자기 주장만 내세우면서",
   "startMs": "781720",
   "endMs": "787440",
   "startTimeText": "13:01"
  },
  {
   "text": "언어 폭력까지 하고 그다음에 화를 잘",
   "startMs": "784320",
   "endMs": "789560",
   "startTimeText": "13:04"
  },
  {
   "text": "내고 이런 것들을 이야기를 합니다.",
   "startMs": "787440",
   "endMs": "792800",
   "startTimeText": "13:07"
  },
  {
   "text": "이런 것들을 안 하는 사람이었으면",
   "startMs": "789560",
   "endMs": "795000",
   "startTimeText": "13:09"
  },
  {
   "text": "좋겠다. 그다음에 오직",
   "startMs": "792800",
   "endMs": "798519",
   "startTimeText": "13:12"
  },
  {
   "text": "관용하며 관용이라는 것은 다른 사람의",
   "startMs": "795000",
   "endMs": "801760",
   "startTimeText": "13:15"
  },
  {
   "text": "입장에서 어 생각을 하면서 참을성",
   "startMs": "798519",
   "endMs": "804160",
   "startTimeText": "13:18"
  },
  {
   "text": "있고 호위적으로 대하는 것을 이야기를",
   "startMs": "801760",
   "endMs": "805800",
   "startTimeText": "13:21"
  },
  {
   "text": "합니다.",
   "startMs": "804160",
   "endMs": "808120",
   "startTimeText": "13:24"
  },
  {
   "text": "다투지 아니하면서 불필요한 것을",
   "startMs": "805800",
   "endMs": "811040",
   "startTimeText": "13:25"
  },
  {
   "text": "가지고 논쟁하지 않는다는 거죠.",
   "startMs": "808120",
   "endMs": "813680",
   "startTimeText": "13:28"
  },
  {
   "text": "별로 그렇게 진리의 문제도 아닌데이",
   "startMs": "811040",
   "endMs": "816000",
   "startTimeText": "13:31"
  },
  {
   "text": "방법 저 방법 이런 걸 가지고",
   "startMs": "813680",
   "endMs": "818839",
   "startTimeText": "13:33"
  },
  {
   "text": "엄청나게 이렇게",
   "startMs": "816000",
   "endMs": "820880",
   "startTimeText": "13:36"
  },
  {
   "text": "티격태격하면서 나중에는 서로의",
   "startMs": "818839",
   "endMs": "823600",
   "startTimeText": "13:38"
  },
  {
   "text": "감정상하고 이런 일들을 하지 않았으면",
   "startMs": "820880",
   "endMs": "826800",
   "startTimeText": "13:40"
  },
  {
   "text": "좋겠다. 한쪽이 좀 양보를 하면",
   "startMs": "823600",
   "endMs": "829560",
   "startTimeText": "13:43"
  },
  {
   "text": "다투지 않겠죠. 양보를 잘하는 사람이",
   "startMs": "826800",
   "endMs": "831920",
   "startTimeText": "13:46"
  },
  {
   "text": "되었으면 좋겠다. 그다음에 돈을",
   "startMs": "829560",
   "endMs": "834360",
   "startTimeText": "13:49"
  },
  {
   "text": "사랑하지 아니하며 여기 돈을 인생에",
   "startMs": "831920",
   "endMs": "836800",
   "startTimeText": "13:51"
  },
  {
   "text": "가장 큰 목적으로 삼지 않는 것을",
   "startMs": "834360",
   "endMs": "839519",
   "startTimeText": "13:54"
  },
  {
   "text": "이야기합니다. 돈이 필요한데 돈을",
   "startMs": "836800",
   "endMs": "841880",
   "startTimeText": "13:56"
  },
  {
   "text": "가장 중요한 목적으로 삼지 아니하고",
   "startMs": "839519",
   "endMs": "844079",
   "startTimeText": "13:59"
  },
  {
   "text": "좀 나눌 수 있는 사람이 되었으면",
   "startMs": "841880",
   "endMs": "846399",
   "startTimeText": "14:01"
  },
  {
   "text": "좋겠다. 그다음에 4절 말씀에 자기",
   "startMs": "844079",
   "endMs": "850040",
   "startTimeText": "14:04"
  },
  {
   "text": "집을 잘 다스려 자녀들로 하여금 모든",
   "startMs": "846399",
   "endMs": "852360",
   "startTimeText": "14:06"
  },
  {
   "text": "공손함으로 복종하게 하는 자라",
   "startMs": "850040",
   "endMs": "855120",
   "startTimeText": "14:10"
  },
  {
   "text": "할지라고 이야기를 하는데 자기 집을",
   "startMs": "852360",
   "endMs": "859199",
   "startTimeText": "14:12"
  },
  {
   "text": "잘 다스리다 다스리다라는 말은 앞에서",
   "startMs": "855120",
   "endMs": "861959",
   "startTimeText": "14:15"
  },
  {
   "text": "행하다라는 뜻이에요. 그러니까 뭐",
   "startMs": "859199",
   "endMs": "865480",
   "startTimeText": "14:19"
  },
  {
   "text": "자기 집을 그냥 잘 막 이렇게 사람들",
   "startMs": "861959",
   "endMs": "869399",
   "startTimeText": "14:21"
  },
  {
   "text": "막 순종하도록 막 이렇게 어 막 어",
   "startMs": "865480",
   "endMs": "872079",
   "startTimeText": "14:25"
  },
  {
   "text": "이렇게 이끌고 가는 그런 모습이",
   "startMs": "869399",
   "endMs": "875519",
   "startTimeText": "14:29"
  },
  {
   "text": "아니라 자기가 먼저 집에서도 어",
   "startMs": "872079",
   "endMs": "879440",
   "startTimeText": "14:32"
  },
  {
   "text": "앞서서 본을 행해 가지고 어 가족들이",
   "startMs": "875519",
   "endMs": "883000",
   "startTimeText": "14:35"
  },
  {
   "text": "참 어 좋은 모습을 가지고 있다.",
   "startMs": "879440",
   "endMs": "884680",
   "startTimeText": "14:39"
  },
  {
   "text": "우리 아빠는 좋은 모습을 가지고",
   "startMs": "883000",
   "endMs": "886560",
   "startTimeText": "14:43"
  },
  {
   "text": "있다. 엄마는 좋은 모습을 가지고",
   "startMs": "884680",
   "endMs": "889720",
   "startTimeText": "14:44"
  },
  {
   "text": "있다. 어, 이런 것이 집을 잘",
   "startMs": "886560",
   "endMs": "892000",
   "startTimeText": "14:46"
  },
  {
   "text": "다스린다라는 의미입니다. 그래서",
   "startMs": "889720",
   "endMs": "895519",
   "startTimeText": "14:49"
  },
  {
   "text": "자녀들에게 모범이 되는 그런 모습을",
   "startMs": "892000",
   "endMs": "899519",
   "startTimeText": "14:52"
  },
  {
   "text": "보여줘서 자녀들이 뭐 요새 자녀들 뭐",
   "startMs": "895519",
   "endMs": "901959",
   "startTimeText": "14:55"
  },
  {
   "text": "어, 잘 따르지 않는 모습들이 많이",
   "startMs": "899519",
   "endMs": "904440",
   "startTimeText": "14:59"
  },
  {
   "text": "있지만 그래도 자녀들의 마음속에 우리",
   "startMs": "901959",
   "endMs": "908000",
   "startTimeText": "15:01"
  },
  {
   "text": "아빠, 엄마는 참 훌륭하다. 참 본이",
   "startMs": "904440",
   "endMs": "910839",
   "startTimeText": "15:04"
  },
  {
   "text": "된다. 이런 식으로 어 생각할 수",
   "startMs": "908000",
   "endMs": "913399",
   "startTimeText": "15:08"
  },
  {
   "text": "있는 그런 사람이",
   "startMs": "910839",
   "endMs": "915480",
   "startTimeText": "15:10"
  },
  {
   "text": "되는에 그랬으면",
   "startMs": "913399",
   "endMs": "919000",
   "startTimeText": "15:13"
  },
  {
   "text": "좋겠다라고 설명을 하고 있는 거죠.",
   "startMs": "915480",
   "endMs": "921399",
   "startTimeText": "15:15"
  },
  {
   "text": "그리고 5절 말씀에 괄호가 있는 것은",
   "startMs": "919000",
   "endMs": "923600",
   "startTimeText": "15:19"
  },
  {
   "text": "어 이것을 필사했던",
   "startMs": "921399",
   "endMs": "925839",
   "startTimeText": "15:21"
  },
  {
   "text": "사람이이이 부분을",
   "startMs": "923600",
   "endMs": "928600",
   "startTimeText": "15:23"
  },
  {
   "text": "참고하면이이 4절의 말씀을 더 잘",
   "startMs": "925839",
   "endMs": "930600",
   "startTimeText": "15:25"
  },
  {
   "text": "이해한다. 이래서 추가적으로 적어",
   "startMs": "928600",
   "endMs": "932279",
   "startTimeText": "15:28"
  },
  {
   "text": "놓은 것이죠.",
   "startMs": "930600",
   "endMs": "934639",
   "startTimeText": "15:30"
  },
  {
   "text": "그래서 괄호가 있습니다. 사람이 자기",
   "startMs": "932279",
   "endMs": "937079",
   "startTimeText": "15:32"
  },
  {
   "text": "집을 다스릴 줄 알지 못하면 어찌",
   "startMs": "934639",
   "endMs": "941040",
   "startTimeText": "15:34"
  },
  {
   "text": "하나님의 교회를 돌보리 자기 집을 잘",
   "startMs": "937079",
   "endMs": "942199",
   "startTimeText": "15:37"
  },
  {
   "text": "다스리는",
   "startMs": "941040",
   "endMs": "945759",
   "startTimeText": "15:41"
  },
  {
   "text": "원리가 하나님의 교회에서도 어 그대로",
   "startMs": "942199",
   "endMs": "948319",
   "startTimeText": "15:42"
  },
  {
   "text": "드러나게 된다라는 겁니다. 그래서",
   "startMs": "945759",
   "endMs": "950480",
   "startTimeText": "15:45"
  },
  {
   "text": "자기 집에서",
   "startMs": "948319",
   "endMs": "954240",
   "startTimeText": "15:48"
  },
  {
   "text": "모범이 되는 것. 그럴 때 하나님의",
   "startMs": "950480",
   "endMs": "956839",
   "startTimeText": "15:50"
  },
  {
   "text": "그런 교회에서도 모범이 되어서 잘할",
   "startMs": "954240",
   "endMs": "960519",
   "startTimeText": "15:54"
  },
  {
   "text": "수 있으니까 자기 집 맡겨 준 곳에서",
   "startMs": "956839",
   "endMs": "963079",
   "startTimeText": "15:56"
  },
  {
   "text": "어 좀 본이 되는 그런 모습으로",
   "startMs": "960519",
   "endMs": "966639",
   "startTimeText": "16:00"
  },
  {
   "text": "자기가 성장될 때 교회도 똑같은",
   "startMs": "963079",
   "endMs": "970839",
   "startTimeText": "16:03"
  },
  {
   "text": "원리로 잘 이렇게 어 돌보고 어",
   "startMs": "966639",
   "endMs": "974240",
   "startTimeText": "16:06"
  },
  {
   "text": "인도할 수 있다라는 얘기죠.",
   "startMs": "970839",
   "endMs": "976839",
   "startTimeText": "16:10"
  },
  {
   "text": "그다음에 5절 말씀에 보면 6절",
   "startMs": "974240",
   "endMs": "980399",
   "startTimeText": "16:14"
  },
  {
   "text": "말씀에 보면 새로 입교한 자도 말지니",
   "startMs": "976839",
   "endMs": "982560",
   "startTimeText": "16:16"
  },
  {
   "text": "그러니까 교회에 등록간지 얼마 안 된",
   "startMs": "980399",
   "endMs": "984480",
   "startTimeText": "16:20"
  },
  {
   "text": "사람을 높은 자리에 세우지 말라는",
   "startMs": "982560",
   "endMs": "987920",
   "startTimeText": "16:22"
  },
  {
   "text": "얘기예요. 왜냐면 어 처음에는",
   "startMs": "984480",
   "endMs": "991160",
   "startTimeText": "16:24"
  },
  {
   "text": "뭐 좋은 모습을 보이지 않습니까?",
   "startMs": "987920",
   "endMs": "993680",
   "startTimeText": "16:27"
  },
  {
   "text": "근데 시간이 지나면 어려운 일들이",
   "startMs": "991160",
   "endMs": "996079",
   "startTimeText": "16:31"
  },
  {
   "text": "다가올 텐데 어려운 일들을 잘",
   "startMs": "993680",
   "endMs": "998639",
   "startTimeText": "16:33"
  },
  {
   "text": "통과하면서 사람이 성장하게 되고",
   "startMs": "996079",
   "endMs": "1002920",
   "startTimeText": "16:36"
  },
  {
   "text": "성숙하게 되고 어 겸손하게 되고 잘",
   "startMs": "998639",
   "endMs": "1004759",
   "startTimeText": "16:38"
  },
  {
   "text": "섬길 수 있는 사람으로",
   "startMs": "1002920",
   "endMs": "1007800",
   "startTimeText": "16:42"
  },
  {
   "text": "되는데에 그냥 겉모습만 보고 빨리",
   "startMs": "1004759",
   "endMs": "1010279",
   "startTimeText": "16:44"
  },
  {
   "text": "세우지 말라라는 겁니다. 에, 그런",
   "startMs": "1007800",
   "endMs": "1013199",
   "startTimeText": "16:47"
  },
  {
   "text": "사람들을 세웠을 때는 나중에 교만해져",
   "startMs": "1010279",
   "endMs": "1017800",
   "startTimeText": "16:50"
  },
  {
   "text": "가지고 자기가 뭔가 대단한 어, 그런",
   "startMs": "1013199",
   "endMs": "1019839",
   "startTimeText": "16:53"
  },
  {
   "text": "사람이어 가지고 직분을 맡은 것처럼",
   "startMs": "1017800",
   "endMs": "1022920",
   "startTimeText": "16:57"
  },
  {
   "text": "생각을 해 가지고 어, 잘못된 판단을",
   "startMs": "1019839",
   "endMs": "1026360",
   "startTimeText": "16:59"
  },
  {
   "text": "하고 사람을 잘 섬기지 못해 가지고",
   "startMs": "1022920",
   "endMs": "1028720",
   "startTimeText": "17:02"
  },
  {
   "text": "오히려 심판의 대상이 될 수 있다라는",
   "startMs": "1026360",
   "endMs": "1031039",
   "startTimeText": "17:06"
  },
  {
   "text": "거죠. 마귀가 그런 거 아닙니까?",
   "startMs": "1028720",
   "endMs": "1034280",
   "startTimeText": "17:08"
  },
  {
   "text": "마귀가 교만하여져 가지고 어 그래서",
   "startMs": "1031039",
   "endMs": "1036799",
   "startTimeText": "17:11"
  },
  {
   "text": "하나님을 대적하고 그래서 나중에",
   "startMs": "1034280",
   "endMs": "1040720",
   "startTimeText": "17:14"
  },
  {
   "text": "정제받게 되는 거잖아요. 그런 식으로",
   "startMs": "1036799",
   "endMs": "1043880",
   "startTimeText": "17:16"
  },
  {
   "text": "빠져들 수도 있게 된다라는 거죠.",
   "startMs": "1040720",
   "endMs": "1047039",
   "startTimeText": "17:20"
  },
  {
   "text": "그래서 새로 입귀한 자를 바로 어떤",
   "startMs": "1043880",
   "endMs": "1050280",
   "startTimeText": "17:23"
  },
  {
   "text": "지위에 세우지 말고 지켜보고 어려움도",
   "startMs": "1047039",
   "endMs": "1053400",
   "startTimeText": "17:27"
  },
  {
   "text": "통과해 보고 그러면서 성숙할 수 있는",
   "startMs": "1050280",
   "endMs": "1056440",
   "startTimeText": "17:30"
  },
  {
   "text": "시간을 갖게 됐을 때 그런 사람들에게",
   "startMs": "1053400",
   "endMs": "1059880",
   "startTimeText": "17:33"
  },
  {
   "text": "직분에 맡겨서 하게 하는 것이 주님의",
   "startMs": "1056440",
   "endMs": "1062360",
   "startTimeText": "17:36"
  },
  {
   "text": "뜻이다라고 말하고 있습니다. 그다음에",
   "startMs": "1059880",
   "endMs": "1064840",
   "startTimeText": "17:39"
  },
  {
   "text": "마지막으로 7절에 보면 외인에게서",
   "startMs": "1062360",
   "endMs": "1067840",
   "startTimeText": "17:42"
  },
  {
   "text": "선한 증거를 받은 자라야 할지니",
   "startMs": "1064840",
   "endMs": "1070280",
   "startTimeText": "17:44"
  },
  {
   "text": "외인이라는 것은 예수님을 안 믿는",
   "startMs": "1067840",
   "endMs": "1073640",
   "startTimeText": "17:47"
  },
  {
   "text": "사람인데에 그런 사람에게 또 선한",
   "startMs": "1070280",
   "endMs": "1076360",
   "startTimeText": "17:50"
  },
  {
   "text": "증거를 받은 사람이어야 된다라는",
   "startMs": "1073640",
   "endMs": "1078400",
   "startTimeText": "17:53"
  },
  {
   "text": "거예요. 그러니까 세상",
   "startMs": "1076360",
   "endMs": "1081080",
   "startTimeText": "17:56"
  },
  {
   "text": "사람들에게 좋은 사람이라는 평판을",
   "startMs": "1078400",
   "endMs": "1084960",
   "startTimeText": "17:58"
  },
  {
   "text": "듣는 사람이 교회의 일꾼이 되어야",
   "startMs": "1081080",
   "endMs": "1088360",
   "startTimeText": "18:01"
  },
  {
   "text": "교회가 어려움에 처하지 않잖아요.",
   "startMs": "1084960",
   "endMs": "1091039",
   "startTimeText": "18:04"
  },
  {
   "text": "기방받지도 아니하고 그다음에 마귀는",
   "startMs": "1088360",
   "endMs": "1093360",
   "startTimeText": "18:08"
  },
  {
   "text": "항상 교회를 무너뜨리려고 하는 그런",
   "startMs": "1091039",
   "endMs": "1096679",
   "startTimeText": "18:11"
  },
  {
   "text": "계획을 가지고 있으니까 그런 올무에에",
   "startMs": "1093360",
   "endMs": "1100400",
   "startTimeText": "18:13"
  },
  {
   "text": "빠지지 않게 된다라는 것이죠. 오늘이",
   "startMs": "1096679",
   "endMs": "1104559",
   "startTimeText": "18:16"
  },
  {
   "text": "말씀을 보면서 우리 모두가 한번 나는",
   "startMs": "1100400",
   "endMs": "1107679",
   "startTimeText": "18:20"
  },
  {
   "text": "어떤 사람인가 어 어떤 모습을",
   "startMs": "1104559",
   "endMs": "1109679",
   "startTimeText": "18:24"
  },
  {
   "text": "추구해야 되는가 이런 것들을 점검을",
   "startMs": "1107679",
   "endMs": "1112120",
   "startTimeText": "18:27"
  },
  {
   "text": "해 봤으면 좋겠습니다. 책망할 것이",
   "startMs": "1109679",
   "endMs": "1115400",
   "startTimeText": "18:29"
  },
  {
   "text": "없고 한내의 남편이 되고 절제하고",
   "startMs": "1112120",
   "endMs": "1118960",
   "startTimeText": "18:32"
  },
  {
   "text": "신중하고 단정하고 나그네를 대접하고",
   "startMs": "1115400",
   "endMs": "1121400",
   "startTimeText": "18:35"
  },
  {
   "text": "가르치기를 잘하고 술을 즐기지",
   "startMs": "1118960",
   "endMs": "1123799",
   "startTimeText": "18:38"
  },
  {
   "text": "아니하고 구타하지 아니하고 오직",
   "startMs": "1121400",
   "endMs": "1126000",
   "startTimeText": "18:41"
  },
  {
   "text": "관용하며 다투지 아니하고 돈을",
   "startMs": "1123799",
   "endMs": "1128840",
   "startTimeText": "18:43"
  },
  {
   "text": "사랑하지 아니하고 자기 집에서 잘",
   "startMs": "1126000",
   "endMs": "1132600",
   "startTimeText": "18:46"
  },
  {
   "text": "본이 되고 그다음에 새로 어 입교한",
   "startMs": "1128840",
   "endMs": "1134320",
   "startTimeText": "18:48"
  },
  {
   "text": "자가",
   "startMs": "1132600",
   "endMs": "1137880",
   "startTimeText": "18:52"
  },
  {
   "text": "어로서 그냥 쓰임받으려고 하는 것보다",
   "startMs": "1134320",
   "endMs": "1140559",
   "startTimeText": "18:54"
  },
  {
   "text": "이제 신앙생활을 같이 해 나가면서",
   "startMs": "1137880",
   "endMs": "1143760",
   "startTimeText": "18:57"
  },
  {
   "text": "어성 성장하면서 많은 것들을 배우고",
   "startMs": "1140559",
   "endMs": "1147000",
   "startTimeText": "19:00"
  },
  {
   "text": "겸손해지고 외인에게도 선한 증거를",
   "startMs": "1143760",
   "endMs": "1150360",
   "startTimeText": "19:03"
  },
  {
   "text": "받는 사람으로 우리 모두가 성장한다면",
   "startMs": "1147000",
   "endMs": "1152480",
   "startTimeText": "19:07"
  },
  {
   "text": "어이 공동체가 얼마나",
   "startMs": "1150360",
   "endMs": "1154720",
   "startTimeText": "19:10"
  },
  {
   "text": "아름다운에 그런 하나님의 모습을",
   "startMs": "1152480",
   "endMs": "1157640",
   "startTimeText": "19:12"
  },
  {
   "text": "보여주는 그런 교회로 어 성장할 수",
   "startMs": "1154720",
   "endMs": "1160320",
   "startTimeText": "19:14"
  },
  {
   "text": "있겠습니까? 이런 모습을 우리 모두가",
   "startMs": "1157640",
   "endMs": "1163600",
   "startTimeText": "19:17"
  },
  {
   "text": "다 같이에 가지면서 노력하는 우리",
   "startMs": "1160320",
   "endMs": "1167400",
   "startTimeText": "19:20"
  },
  {
   "text": "모두가 되기를 주님의 이름으로",
   "startMs": "1163600",
   "endMs": "1171360",
   "startTimeText": "19:23"
  },
  {
   "text": "축원합니다. 예. 오늘 여기까지",
   "startMs": "1167400",
   "endMs": "1174000",
   "startTimeText": "19:27"
  },
  {
   "text": "이렇게 우리 나누게 되었습니다. 우리",
   "startMs": "1171360",
   "endMs": "1176679",
   "startTimeText": "19:31"
  },
  {
   "text": "각자 또이 모습을 가질 수 있도록",
   "startMs": "1174000",
   "endMs": "1179120",
   "startTimeText": "19:34"
  },
  {
   "text": "노력하시고 또 기도하시는 여러분들이",
   "startMs": "1176679",
   "endMs": "1181000",
   "startTimeText": "19:36"
  },
  {
   "text": "되시기를 주님의 이름으로 축원합니다.",
   "startMs": "1179120",
   "endMs": "1184000",
   "startTimeText": "19:39"
  },
  {
   "text": "합니다.",
   "startMs": "1181000",
   "endMs": "1184000",
   "startTimeText": "19:41"
  }
 ]
}