  {
   "text": "있는가 그대 몸은 거룩한 곳",
   "startMs": "100119",
   "endMs": "109759",
   "startTimeText": "1:40"
  },
  {
   "text": "천국에 들어갈 준비가",
   "startMs": "105040",
   "endMs": "111920",
   "startTimeText": "1:45"
  },
  {
   "text": "됐는가",
   "startMs": "109759",
