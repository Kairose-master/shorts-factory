   "endMs": "295520",
   "startTimeText": "4:49"
  },
  {
   "text": "아멘 오늘함께 실 하나님 말씀은",
   "startMs": "292680",
   "endMs": "297240",
   "startTimeText": "4:52"
  },
  {
   "text": "마태복음 10장",
   "startMs": "295520",
   "endMs": "300800",
   "startTimeText": "4:55"
  },
  {
