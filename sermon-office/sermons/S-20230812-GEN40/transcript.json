   "startTimeText": "1:00"
  },
  {
   "text": "[음악]",
   "startMs": "62650",
   "endMs": "68580",
   "startTimeText": "1:02"
  },
  {
   "text": "우리를 잘",
   "startMs": "64580",
   "endMs": "68580",
   "startTimeText": "1:04"
  },
  {
   "text": "인도하게 하소서",
   "startMs": "69380",
   "endMs": "73380",
   "startTimeText": "1:09"
  },
  {
   "text": "구주의",
   "startMs": "74939",
   "endMs": "79160",
   "startTimeText": "1:14"
  },
  {
   "text": "귀하니",
