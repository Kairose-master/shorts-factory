   "startTimeText": "1:19"
  },
  {
   "text": "깨달",
   "startMs": "82979",
   "endMs": "87470",
   "startTimeText": "1:22"
  },
  {
   "text": "아 알게 하시고",
   "startMs": "84119",
   "endMs": "89939",
   "startTimeText": "1:24"
  },
  {
   "text": "[음악]",
   "startMs": "87470",
