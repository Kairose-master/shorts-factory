  },
  {
   "text": "얼마나 그것이 성령 이게 모독이 되고",
   "startMs": "1017759",
   "endMs": "1024760",
   "startTimeText": "16:57"
  },
  {
   "text": "그리고 어 깊은 슬픔이 되셨을지",
   "startMs": "1020959",
   "endMs": "1026240",
   "startTimeText": "17:00"
  },
  {
   "text": "우리가 한번 생각을 해 봤으면",
   "startMs": "1024760",
   "endMs": "1028520",
   "startTimeText": "17:04"
  },
  {
   "text": "좋겠습니다 그렇기 때문에 예수님께서는",
   "startMs": "1026240",
   "endMs": "1032679",
   "startTimeText": "17:06"
  },
  {
   "text": "특별히 어 예수님을",
   "startMs": "1028520",
   "endMs": "1032679",
   "startTimeText": "17:08"
  },
  {
   "text": "거역하거나 다른 사람에게 상처를",
   "startMs": "1034039",
   "endMs": "1038799",
   "startTimeText": "17:14"
  },
  {
   "text": "주더라도 우리가 회개하면 용서를 받을",
   "startMs": "1036679",
   "endMs": "1042000",
   "startTimeText": "17:16"
  },
  {
   "text": "수 있지만 성령을 거역하고 성령을",
   "startMs": "1038799",
   "endMs": "1044919",
   "startTimeText": "17:18"
  },
  {
   "text": "목욕하면 용서받을 수 없다라고 하고",
   "startMs": "1042000",
   "endMs": "1047400",
   "startTimeText": "17:22"
  },
  {
   "text": "아주 이렇게 강하게 말씀을 하신",
   "startMs": "1044919",
   "endMs": "1052039",
   "startTimeText": "17:24"
  },
  {
   "text": "거라고 우이 있 그만큼 우리는",
   "startMs": "1047400",
   "endMs": "1055400",
   "startTimeText": "17:27"
  },
  {
   "text": "성령님께 민감하게 반응할 필요가 있고",
   "startMs": "1052039",
   "endMs": "1058840",
   "startTimeText": "17:32"
  },
  {
   "text": "어 우리 이제 하나님의 마음 그",
   "startMs": "1055400",
   "endMs": "1061440",
   "startTimeText": "17:35"
  },
  {
   "text": "자체이신 거룩한 성령님을 우리가",
   "startMs": "1058840",
   "endMs": "1065760",
   "startTimeText": "17:38"
  },
  {
   "text": "소중하게 여기고 어 그분을 우리가",
   "startMs": "1061440",
   "endMs": "1069679",
   "startTimeText": "17:41"
  },
  {
   "text": "존중하고 어 그래서 그분의 어떤",
   "startMs": "1065760",
   "endMs": "1071840",
   "startTimeText": "17:45"
  },
  {
   "text": "거룩함과 그런",
   "startMs": "1069679",
   "endMs": "1074200",
   "startTimeText": "17:49"
  },
  {
   "text": "순수함에 우리가 부합하는 그런",
   "startMs": "1071840",
   "endMs": "1077039",
   "startTimeText": "17:51"
  },
  {
   "text": "신앙생활을 살아가고자 힘쓸 필요가",
   "startMs": "1074200",
   "endMs": "1079000",
   "startTimeText": "17:54"
  },
  {
   "text": "있을 것 같습니다 그래서 이제",
   "startMs": "1077039",
   "endMs": "1081880",
   "startTimeText": "17:57"
  },
  {
   "text": "돌아오는 주일이 오순절 성령 강림 예",
   "startMs": "1079000",
   "endMs": "1082919",
   "startTimeText": "17:59"
  },
  {
   "text": "주일입니다",
   "startMs": "1081880",
   "endMs": "1085559",
   "startTimeText": "18:01"
  },
  {
   "text": "성령께서는 우리에게 능력으로 임하시기",
   "startMs": "1082919",
   "endMs": "1087200",
   "startTimeText": "18:02"
  },
  {
   "text": "하지만 우리 안에 이미 계신",
   "startMs": "1085559",
   "endMs": "1090120",
   "startTimeText": "18:05"
  },
  {
   "text": "성령께서는 날마다 우리와 호흡하기",
   "startMs": "1087200",
   "endMs": "1092520",
   "startTimeText": "18:07"
  },
  {
   "text": "위하여서 우리를 어떻게든 더 하나님",
   "startMs": "1090120",
   "endMs": "1094400",
   "startTimeText": "18:10"
  },
  {
   "text": "뜻대로 살아갈 수 있도록 우리",
   "startMs": "1092520",
   "endMs": "1096919",
   "startTimeText": "18:12"
  },
  {
   "text": "인도하시기 위해서 오늘도 열심히",
   "startMs": "1094400",
   "endMs": "1099400",
   "startTimeText": "18:14"
  },
  {
   "text": "일하시고 그리고 말할 수 없는",
   "startMs": "1096919",
   "endMs": "1101480",
   "startTimeText": "18:16"
  },
  {
   "text": "탄식으로 우리를 위해서 친히",
   "startMs": "1099400",
   "endMs": "1104039",
   "startTimeText": "18:19"
  },
  {
   "text": "간구하시는 그런 분입니다 아 그런",
   "startMs": "1101480",
   "endMs": "1106679",
   "startTimeText": "18:21"
  },
  {
   "text": "성령님의 마음을 우리가 알아들었으면",
   "startMs": "1104039",
   "endMs": "1110080",
   "startTimeText": "18:24"
  },
  {
   "text": "좋겠습니다 그래서 어 성령께 더 귀를",
   "startMs": "1106679",
   "endMs": "1113320",
   "startTimeText": "18:26"
  },
  {
   "text": "기울이고 오늘 하루의 삶도 어떻게",
   "startMs": "1110080",
   "endMs": "1117240",
   "startTimeText": "18:30"
  },
  {
   "text": "성령님과 더 협력하여 어 동해 갈 수",
   "startMs": "1113320",
   "endMs": "1122280",
   "startTimeText": "18:33"
  },
  {
   "text": "있는지 함께 기도함으로써 어 성령을",
   "startMs": "1117240",
   "endMs": "1122280",
   "startTimeText": "18:37"
  },
  {
   "text": "근심지무 예수님의 성도분들이 되시기",
   "startMs": "1124880",
   "endMs": "1131159",
   "startTimeText": "18:44"
  },
  {
   "text": "예수님의 이름으로 축복합니다 아",
   "startMs": "1127559",
   "endMs": "1133200",
   "startTimeText": "18:47"
  },
  {
   "text": "기도하겠습니다 하늘에 계신 우리",
   "startMs": "1131159",
   "endMs": "1135120",
   "startTimeText": "18:51"
  },
  {
   "text": "아버지 아버지의 이름을 거룩하게",
   "startMs": "1133200",
   "endMs": "1137799",
   "startTimeText": "18:53"
  },
  {
   "text": "하시며 아버지의 나라가 오게 하시며",
   "startMs": "1135120",
   "endMs": "1140200",
   "startTimeText": "18:55"
  },
  {
   "text": "아버지의 뜻이 하 와 같이 땅에서도",
   "startMs": "1137799",
   "endMs": "1142159",
   "startTimeText": "18:57"
  },
  {
   "text": "이루어지게 하소서 오늘 우리에게",
   "startMs": "1140200",
   "endMs": "1144440",
   "startTimeText": "19:00"
  },
  {
   "text": "이용할 양식을 주시고 우리가 우리에게",
   "startMs": "1142159",
   "endMs": "1146919",
   "startTimeText": "19:02"
  },
  {
   "text": "잘못한 사람을 용서하여 준 것같이",
   "startMs": "1144440",
   "endMs": "1149159",
   "startTimeText": "19:04"
  },
  {
   "text": "우리 죄를 용서하여 주시고 우리를",
   "startMs": "1146919",
   "endMs": "1151120",
   "startTimeText": "19:06"
  },
  {
   "text": "시험에 빠지지 않게 하시고 악에서",
   "startMs": "1149159",
   "endMs": "1154039",
   "startTimeText": "19:09"
  },
  {
   "text": "구하소서 나라와 권능과 영광이 영원히",
   "startMs": "1151120",
   "endMs": "1158520",
   "startTimeText": "19:11"
  },
  {
   "text": "아버지의 것입니다 아멘",
   "startMs": "1154039",
   "endMs": "1158520",
   "startTimeText": "19:14"
  }
 ]
}