   "startTimeText": "17:50"
  },
  {
   "text": "하나님께서 우리를 심판하지",
   "startMs": "1073600",
   "endMs": "1078600",
   "startTimeText": "17:53"
  },
  {
   "text": "않으시고도 기회를 주시고 그리고",
