   "startTimeText": "5:06"
  },
  {
   "text": "기도합니다 아멘 오늘 함께 보신",
   "startMs": "307000",
   "endMs": "312960",
   "startTimeText": "5:07"
  },
  {
   "text": "하나님 말씀은 마태복음 10장",
   "startMs": "310080",
   "endMs": "316600",
   "startTimeText": "5:10"
  },
  {
   "text": "9절부터 15절의",
   "startMs": "312960",
   "endMs": "320000",
   "startTimeText": "5:12"
  },
  {
   "text": "말씀입니다 마태복음 10장 9절부터",
   "startMs": "316600",
   "endMs": "321600",
   "startTimeText": "5:16"
  },
  {
   "text": "15절",
   "startMs": "320000",
   "endMs": "325000",
   "startTimeText": "5:20"
  },
  {
   "text": "말씀 같이",
   "startMs": "321600",
   "endMs": "325000",
   "startTimeText": "5:21"
  },
  {
   "text": "독하 너",
   "startMs": "326400",
   "endMs": "330840",
   "startTimeText": "5:26"
  },
  {
   "text": "전대",
   "startMs": "328479",
