   "endMs": "349039",
   "startTimeText": "5:40"
  },
  {
   "text": "를가 떠나기까지 기서라 또 그에",
   "startMs": "344960",
   "endMs": "351440",
   "startTimeText": "5:44"
  },
  {
   "text": "들어면서",
   "startMs": "349039",
   "endMs": "354240",
   "startTimeText": "5:49"
  },
  {
   "text": "빌라 당",
   "startMs": "351440",
   "endMs": "357240",
   "startTimeText": "5:51"
  },
  {
   "text": "너이",
