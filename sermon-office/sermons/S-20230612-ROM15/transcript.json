   "text": "[음악]",
   "startMs": "118420",
   "endMs": "125880",
   "startTimeText": "1:58"
  },
  {
   "text": "천국의 기쁨 일생 우리",
   "startMs": "120060",
   "endMs": "125880",
   "startTimeText": "2:00"
  },
  {
   "text": "갈길",
   "startMs": "126180",
   "endMs": "130619",
   "startTimeText": "2:06"
  },
  {
   "text": "다가구에 보좌",
   "startMs": "127280",
   "endMs": "133080",
   "startTimeText": "2:07"
  },
  {
   "text": "앞에 나",
