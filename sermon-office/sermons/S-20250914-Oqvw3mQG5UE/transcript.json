 ],
 "transcript": [
  {
   "text": "천국 백성 기도하고 예배",
   "startMs": "5600",
   "endMs": "11840",
   "startTimeText": "0:05"
  },
  {
   "text": "시작하겠습니다. 네. 2025년 9월",
   "startMs": "7759",
   "endMs": "14000",
   "startTimeText": "0:07"
  },
  {
   "text": "14일에 우리 유치하던부 예배를",
   "startMs": "11840",
   "endMs": "16240",
   "startTimeText": "0:11"
  },
  {
   "text": "시작하도록 하겠습니다. 네. 제",
   "startMs": "14000",
   "endMs": "18119",
   "startTimeText": "0:14"
  },
  {
   "text": "기도하고 시작하겠습니다. 은혜와",
   "startMs": "16240",
   "endMs": "20439",
   "startTimeText": "0:16"
  },
  {
   "text": "사랑이 풍성하신 하나님 아버지 오늘도",
   "startMs": "18119",
   "endMs": "22400",
   "startTimeText": "0:18"
  },
  {
   "text": "주님께 예배를 드립니다. 예배 가운데",
   "startMs": "20439",
   "endMs": "25080",
   "startTimeText": "0:20"
  },
  {
   "text": "은혜 주시고 성경 충만한 시간 행복",
   "startMs": "22400",
   "endMs": "26439",
   "startTimeText": "0:22"
  },
  {
   "text": "충만한 시간 될 수 있도록 인도해",
   "startMs": "25080",
   "endMs": "28160",
   "startTimeText": "0:25"
  },
  {
   "text": "주세요. 예수님의 이름으로",
   "startMs": "26439",
   "endMs": "30320",
   "startTimeText": "0:26"
  },
  {
   "text": "기도드립니다. 아멘.",
   "startMs": "28160",
   "endMs": "34400",
   "startTimeText": "0:28"
  },
  {
   "text": "자, 중국하도록 할게요.",
   "startMs": "30320",
   "endMs": "34400",
   "startTimeText": "0:30"
  },
  {
   "text": "[음악]",
   "startMs": "35790",
   "endMs": "38850",
   "startTimeText": "0:35"
  },
  {
   "text": "이처럼 날고",
   "startMs": "40200",
   "endMs": "45840",
   "startTimeText": "0:40"
  },
  {
   "text": "성기롭고",
   "startMs": "43920",
   "endMs": "47840",
   "startTimeText": "0:43"
  },
  {
   "text": "높게",
   "startMs": "45840",
   "endMs": "50160",
   "startTimeText": "0:45"
  },
  {
   "text": "떠나는이",
   "startMs": "47840",
   "endMs": "54600",
   "startTimeText": "0:47"
  },
  {
   "text": "사는 그",
   "startMs": "50160",
   "endMs": "54600",
   "startTimeText": "0:50"
  },
  {
   "text": "선물",
   "startMs": "55440",
   "endMs": "59359",
   "startTimeText": "0:55"
  },
  {
   "text": "십자가니",
   "startMs": "57359",
   "endMs": "63079",
   "startTimeText": "0:57"
  },
  {
   "text": "불고 나한길",
   "startMs": "59359",
   "endMs": "63079",
   "startTimeText": "0:59"
  },
  {
   "text": "사랑의 모든",
   "startMs": "63239",
   "endMs": "66920",
   "startTimeText": "1:03"
  },
  {
   "text": "예수믿는",
   "startMs": "67040",
   "endMs": "70040",
   "startTimeText": "1:07"
  },
  {
   "text": "세상 없는 노래",
   "startMs": "70960",
   "endMs": "78680",
   "startTimeText": "1:10"
  },
  {
   "text": "예수 믿는 찬양",
   "startMs": "74799",
   "endMs": "82160",
   "startTimeText": "1:14"
  },
  {
   "text": "너 주님 사네",
   "startMs": "78680",
   "endMs": "88960",
   "startTimeText": "1:18"
  },
  {
   "text": "[음악]",
   "startMs": "82160",
   "endMs": "92759",
   "startTimeText": "1:22"
  },
  {
   "text": "자 오늘은 예배가 살짝 추약해서네",
   "startMs": "88960",
   "endMs": "95479",
   "startTimeText": "1:28"
  },
  {
   "text": "자네",
   "startMs": "92759",
   "endMs": "97799",
   "startTimeText": "1:32"
  },
  {
   "text": "어 시 묵상하고 이런 좀 제외하고요.",
   "startMs": "95479",
   "endMs": "100200",
   "startTimeText": "1:35"
  },
  {
   "text": "제가 본문 봉독부터 하도록 할게요.",
   "startMs": "97799",
   "endMs": "103560",
   "startTimeText": "1:37"
  },
  {
   "text": "네. 자, 오늘 말씀은 신명기",
   "startMs": "100200",
   "endMs": "106840",
   "startTimeText": "1:40"
  },
  {
   "text": "11장. 네.",
   "startMs": "103560",
   "endMs": "110040",
   "startTimeText": "1:43"
  },
  {
   "text": "네. 네. 조금 치면 되겠습니다.",
   "startMs": "106840",
   "endMs": "116119",
   "startTimeText": "1:46"
  },
  {
   "text": "네. 네. 신명기 11장 어 1절부터",
   "startMs": "110040",
   "endMs": "119240",
   "startTimeText": "1:50"
  },
  {
   "text": "아, 절인데 신명기 11장 17절",
   "startMs": "116119",
   "endMs": "122439",
   "startTimeText": "1:56"
  },
  {
   "text": "읽도록 할게요. 네. 자, 지각해서",
   "startMs": "119240",
   "endMs": "124920",
   "startTimeText": "1:59"
  },
  {
   "text": "하도록 하겠습니다. 네. 함께",
   "startMs": "122439",
   "endMs": "127320",
   "startTimeText": "2:02"
  },
  {
   "text": "읽겠습니다. 시작. 여호와께서",
   "startMs": "124920",
   "endMs": "129920",
   "startTimeText": "2:04"
  },
  {
   "text": "너희에게 진노하사 하늘을 닫아 귀를",
   "startMs": "127320",
   "endMs": "132560",
   "startTimeText": "2:07"
  },
  {
   "text": "데리지 아니하여 땅이 소산을 내지",
   "startMs": "129920",
   "endMs": "135120",
   "startTimeText": "2:09"
  },
  {
   "text": "않게 하심으로 너희가 여호와께서 주신",
   "startMs": "132560",
   "endMs": "138920",
   "startTimeText": "2:12"
  },
  {
   "text": "아름다운 땅에서 속히 멸망할까 하라.",
   "startMs": "135120",
   "endMs": "141480",
   "startTimeText": "2:15"
  },
  {
   "text": "아멘. 네.",
   "startMs": "138920",
   "endMs": "143560",
   "startTimeText": "2:18"
  },
  {
   "text": ">> 하나님의 말씀을 지켜라는 제목으로",
   "startMs": "141480",
   "endMs": "147160",
   "startTimeText": "2:21"
  },
  {
   "text": "하나님 말씀 들어가다가",
   "startMs": "143560",
   "endMs": "147160",
   "startTimeText": "2:23"
  },
  {
   "text": "여러분 집에서 똑같은 얘기를 많이",
   "startMs": "150000",
   "endMs": "154120",
   "startTimeText": "2:30"
  },
  {
   "text": "하실 때가 있죠. 그죠? 가끔 똑같은",
   "startMs": "151680",
   "endMs": "156480",
   "startTimeText": "2:31"
  },
  {
   "text": "얘기를 계속 들으면 짜증도 나고",
   "startMs": "154120",
   "endMs": "158280",
   "startTimeText": "2:34"
  },
  {
   "text": "그리고 귀찮을 때도 있어요. 그것을",
   "startMs": "156480",
   "endMs": "160319",
   "startTimeText": "2:36"
  },
  {
   "text": "보통 우리는 잔소리라고 하죠.",
   "startMs": "158280",
   "endMs": "162640",
   "startTimeText": "2:38"
  },
  {
   "text": "그렇다면 어른들이 잔소리와 같은",
   "startMs": "160319",
   "endMs": "164239",
   "startTimeText": "2:40"
  },
  {
   "text": "똑같은 말씀들을 왜 계속 우리에게",
   "startMs": "162640",
   "endMs": "167480",
   "startTimeText": "2:42"
  },
  {
   "text": "하시는 걸까요? 그것은 우리가 아주",
   "startMs": "164239",
   "endMs": "169480",
   "startTimeText": "2:44"
  },
  {
   "text": "중요한 그 이야기가 우리에게 아주",
   "startMs": "167480",
   "endMs": "171760",
   "startTimeText": "2:47"
  },
  {
   "text": "중요한 이야기 때문에 그래요. 나중에",
   "startMs": "169480",
   "endMs": "173519",
   "startTimeText": "2:49"
  },
  {
   "text": "우리 친구들이 다 크면 공감하게",
   "startMs": "171760",
   "endMs": "176519",
   "startTimeText": "2:51"
  },
  {
   "text": "됩니다. 자, 마찬가지로 우리가 성경",
   "startMs": "173519",
   "endMs": "179680",
   "startTimeText": "2:53"
  },
  {
   "text": "말씀을 읽다가 뭔가 비슷한 사건이나",
   "startMs": "176519",
   "endMs": "182120",
   "startTimeText": "2:56"
  },
  {
   "text": "교훈 그리고 비슷한 공고의 말씀들이",
   "startMs": "179680",
   "endMs": "183959",
   "startTimeText": "2:59"
  },
  {
   "text": "자주 나오는 걸 우리가 보게 돼요.",
   "startMs": "182120",
   "endMs": "186560",
   "startTimeText": "3:02"
  },
  {
   "text": "그걸 왜 그럴까요? 그것도 그 말씀이",
   "startMs": "183959",
   "endMs": "188799",
   "startTimeText": "3:03"
  },
  {
   "text": "정말 중요하기 때문에 그러는 거예요.",
   "startMs": "186560",
   "endMs": "190599",
   "startTimeText": "3:06"
  },
  {
   "text": "오늘 말씀도 그런 반복되는 말씀 중에",
   "startMs": "188799",
   "endMs": "192959",
   "startTimeText": "3:08"
  },
  {
   "text": "하나입니다. 어떤 내용이냐면은",
   "startMs": "190599",
   "endMs": "194959",
   "startTimeText": "3:10"
  },
  {
   "text": "하나님의 말씀을 지키라고 모세가",
   "startMs": "192959",
   "endMs": "196959",
   "startTimeText": "3:12"
  },
  {
   "text": "신명기 말씀을 통해서 계속 얘기하고",
   "startMs": "194959",
   "endMs": "199120",
   "startTimeText": "3:14"
  },
  {
   "text": "있어요. 자, 그렇다면 우리는 왜",
   "startMs": "196959",
   "endMs": "201400",
   "startTimeText": "3:16"
  },
  {
   "text": "하나님의 말씀을 지켜야 될까요? 첫",
   "startMs": "199120",
   "endMs": "204799",
   "startTimeText": "3:19"
  },
  {
   "text": "번째 그거는 하나님이 우리를 선하시고",
   "startMs": "201400",
   "endMs": "207080",
   "startTimeText": "3:21"
  },
  {
   "text": "신실하게 인도하시는 하나님이시기",
   "startMs": "204799",
   "endMs": "210080",
   "startTimeText": "3:24"
  },
  {
   "text": "때문에 그렇습니다. 오늘 말씀 신명기",
   "startMs": "207080",
   "endMs": "212200",
   "startTimeText": "3:27"
  },
  {
   "text": "11장 2절에서 5절 말씀에 보면",
   "startMs": "210080",
   "endMs": "214280",
   "startTimeText": "3:30"
  },
  {
   "text": "모세가 이스라엘 백성들에게 하나님이",
   "startMs": "212200",
   "endMs": "215959",
   "startTimeText": "3:32"
  },
  {
   "text": "어떤 분이신지 얘기하고 있어요.",
   "startMs": "214280",
   "endMs": "218159",
   "startTimeText": "3:34"
  },
  {
   "text": "하나님이 어떤 분이시냐면은 이스라엘",
   "startMs": "215959",
   "endMs": "220680",
   "startTimeText": "3:35"
  },
  {
   "text": "백성들을 애굽에서 구해내게 하시고",
   "startMs": "218159",
   "endMs": "222560",
   "startTimeText": "3:38"
  },
  {
   "text": "광야에서 돌보신 분이 바로",
   "startMs": "220680",
   "endMs": "225480",
   "startTimeText": "3:40"
  },
  {
   "text": "하나님이시다라고 얘기하고 있어요. 자",
   "startMs": "222560",
   "endMs": "227200",
   "startTimeText": "3:42"
  },
  {
   "text": "하나님은 이스라엘 백성들을 애굽을",
   "startMs": "225480",
   "endMs": "229640",
   "startTimeText": "3:45"
  },
  {
   "text": "기운드시면서 열 가지 제앙으로 치시고",
   "startMs": "227200",
   "endMs": "231760",
   "startTimeText": "3:47"
  },
  {
   "text": "그리고 애굽인의 보물들까지 들고",
   "startMs": "229640",
   "endMs": "234280",
   "startTimeText": "3:49"
  },
  {
   "text": "나셨어요. 그리고 홍해에서는 자",
   "startMs": "231760",
   "endMs": "236079",
   "startTimeText": "3:51"
  },
  {
   "text": "추격하는 예국 군대를 막으시고 홍해",
   "startMs": "234280",
   "endMs": "238239",
   "startTimeText": "3:54"
  },
  {
   "text": "바다를 쫙 가르셔 가지고 맨 땅을",
   "startMs": "236079",
   "endMs": "240360",
   "startTimeText": "3:56"
  },
  {
   "text": "건너가셨어요. 그리고 그 군대를",
   "startMs": "238239",
   "endMs": "242599",
   "startTimeText": "3:58"
  },
  {
   "text": "바다에 후장시키셨어요.",
   "startMs": "240360",
   "endMs": "244159",
   "startTimeText": "4:00"
  },
  {
   "text": "그리고 광야에서는 만나와 매출하게",
   "startMs": "242599",
   "endMs": "246200",
   "startTimeText": "4:02"
  },
  {
   "text": "주시면서 먹이시고 돌보신 분이 바로",
   "startMs": "244159",
   "endMs": "248560",
   "startTimeText": "4:04"
  },
  {
   "text": "하나님이세요. 모세가 이스라엘",
   "startMs": "246200",
   "endMs": "250360",
   "startTimeText": "4:06"
  },
  {
   "text": "백성들에게 하나님의 역사들을 쫙",
   "startMs": "248560",
   "endMs": "252879",
   "startTimeText": "4:08"
  },
  {
   "text": "설명하면서 뭐라고 얘기하고 했어요?",
   "startMs": "250360",
   "endMs": "255519",
   "startTimeText": "4:10"
  },
  {
   "text": "그러한 하나님의 명령을 지켜라.",
   "startMs": "252879",
   "endMs": "257880",
   "startTimeText": "4:12"
  },
  {
   "text": "그러한 하나님의 말씀을 네가",
   "startMs": "255519",
   "endMs": "260120",
   "startTimeText": "4:15"
  },
  {
   "text": "지켜라라고 얘기하고 있는 거예요.",
   "startMs": "257880",
   "endMs": "262560",
   "startTimeText": "4:17"
  },
  {
   "text": "자, 우리가 누군가의 명령을 따르기",
   "startMs": "260120",
   "endMs": "264479",
   "startTimeText": "4:20"
  },
  {
   "text": "위해서 뭐가 필요해요? 그 대상에",
   "startMs": "262560",
   "endMs": "266120",
   "startTimeText": "4:22"
  },
  {
   "text": "대한 믿음이 필요해요. 제가",
   "startMs": "264479",
   "endMs": "267800",
   "startTimeText": "4:24"
  },
  {
   "text": "승경이에게 신부름을 시켰던 생각이",
   "startMs": "266120",
   "endMs": "269360",
   "startTimeText": "4:26"
  },
  {
   "text": "했어요. 승경하고 저기 롯데",
   "startMs": "267800",
   "endMs": "271280",
   "startTimeText": "4:27"
  },
  {
   "text": "슈퍼와가지고 새우깡 좀 사하면서 제가",
   "startMs": "269360",
   "endMs": "273160",
   "startTimeText": "4:29"
  },
  {
   "text": "체크 카드를 딱 줬어요. 근데 그",
   "startMs": "271280",
   "endMs": "274880",
   "startTimeText": "4:31"
  },
  {
   "text": "체크 카드에 승개비가 의심하는",
   "startMs": "273160",
   "endMs": "275840",
   "startTimeText": "4:33"
  },
  {
   "text": "거예요. 여기 돈이 들어 있을까",
   "startMs": "274880",
   "endMs": "278320",
   "startTimeText": "4:34"
  },
  {
   "text": "없을까? 이렇게 의심할까요? 아니죠.",
   "startMs": "275840",
   "endMs": "280080",
   "startTimeText": "4:35"
  },
  {
   "text": "우리 승비는 아예 알았어 하면서",
   "startMs": "278320",
   "endMs": "282240",
   "startTimeText": "4:38"
  },
  {
   "text": "세우깡을 사올 거예요. 왜냐? 체크",
   "startMs": "280080",
   "endMs": "283960",
   "startTimeText": "4:40"
  },
  {
   "text": "카드에 세우깡을 살면한 돈이 있다는",
   "startMs": "282240",
   "endMs": "286320",
   "startTimeText": "4:42"
  },
  {
   "text": "것을 믿기 때문에 그런 거죠. 왜냐?",
   "startMs": "283960",
   "endMs": "288880",
   "startTimeText": "4:43"
  },
  {
   "text": "제가 그만큼 승경이에게 그렇게 신부름",
   "startMs": "286320",
   "endMs": "290880",
   "startTimeText": "4:46"
  },
  {
   "text": "시켰을 때는 그만큼 돈이 있기 때문에",
   "startMs": "288880",
   "endMs": "292440",
   "startTimeText": "4:48"
  },
  {
   "text": "시킨 것을 승경이가 알고 있는",
   "startMs": "290880",
   "endMs": "294360",
   "startTimeText": "4:50"
  },
  {
   "text": "거예요. 자, 승경이긴 저에 대한",
   "startMs": "292440",
   "endMs": "297240",
   "startTimeText": "4:52"
  },
  {
   "text": "믿음이기 때문 만약에 돈도 없는데 그",
   "startMs": "294360",
   "endMs": "298960",
   "startTimeText": "4:54"
  },
  {
   "text": "은행에 통장에 빵원 있는데 체크",
   "startMs": "297240",
   "endMs": "301039",
   "startTimeText": "4:57"
  },
  {
   "text": "카드를 쓰면서 승아 새육감 사와",
   "startMs": "298960",
   "endMs": "303120",
   "startTimeText": "4:58"
  },
  {
   "text": "이러면 승비가 새육관 사울까요?",
   "startMs": "301039",
   "endMs": "305160",
   "startTimeText": "5:01"
  },
  {
   "text": "얼굴이 확 굳어지면서 아유 또 내도",
   "startMs": "303120",
   "endMs": "308680",
   "startTimeText": "5:03"
  },
  {
   "text": "사야겠죠. 그렇죠? 그러면은이 말씀이",
   "startMs": "305160",
   "endMs": "310199",
   "startTimeText": "5:05"
  },
  {
   "text": "명령을 지키기가 싫겠죠. 그죠?",
   "startMs": "308680",
   "endMs": "312039",
   "startTimeText": "5:08"
  },
  {
   "text": "침부를 하기가 싫겠했죠. 마찬가지인",
   "startMs": "310199",
   "endMs": "314600",
   "startTimeText": "5:10"
  },
  {
   "text": "거예요. 우리가 우리에게 말씀하시는",
   "startMs": "312039",
   "endMs": "316440",
   "startTimeText": "5:12"
  },
  {
   "text": "분, 우리에게 명령하시는 분이 어떤",
   "startMs": "314600",
   "endMs": "318720",
   "startTimeText": "5:14"
  },
  {
   "text": "분이라는 믿음이 있을 때 우리는 그",
   "startMs": "316440",
   "endMs": "320919",
   "startTimeText": "5:16"
  },
  {
   "text": "믿음을 가지고 그 말씀을 따를 수가",
   "startMs": "318720",
   "endMs": "322759",
   "startTimeText": "5:18"
  },
  {
   "text": "있는 거예요. 사랑하는 우리 차동",
   "startMs": "320919",
   "endMs": "324400",
   "startTimeText": "5:20"
  },
  {
   "text": "친구들 우리에게 말씀을 주신 분,",
   "startMs": "322759",
   "endMs": "325840",
   "startTimeText": "5:22"
  },
  {
   "text": "명령을 주신 분은 누구예요?",
   "startMs": "324400",
   "endMs": "327520",
   "startTimeText": "5:24"
  },
  {
   "text": "하나님이어요. 우리를 사랑하셔서",
   "startMs": "325840",
   "endMs": "329759",
   "startTimeText": "5:25"
  },
  {
   "text": "우리를 구원하시고 우리를 창조하신",
   "startMs": "327520",
   "endMs": "332280",
   "startTimeText": "5:27"
  },
  {
   "text": "분이 바로 하나님이세요. 이러분의",
   "startMs": "329759",
   "endMs": "333680",
   "startTimeText": "5:29"
  },
  {
   "text": "말씀을 우리가 잘 따라야 돼요, 안",
   "startMs": "332280",
   "endMs": "335919",
   "startTimeText": "5:32"
  },
  {
   "text": "따라야 돼요? 따라야 되는 거예요.",
   "startMs": "333680",
   "endMs": "338199",
   "startTimeText": "5:33"
  },
  {
   "text": "이것을 기억하고 하나님을 알고 하나님",
   "startMs": "335919",
   "endMs": "339520",
   "startTimeText": "5:35"
  },
  {
   "text": "말씀을 따르는 우리 친구들 되기",
   "startMs": "338199",
   "endMs": "341880",
   "startTimeText": "5:38"
  },
  {
   "text": "바래요. 두 번째 우리는 왜 하나님",
   "startMs": "339520",
   "endMs": "343840",
   "startTimeText": "5:39"
  },
  {
   "text": "말씀을 지켜야 될까요? 그것은",
   "startMs": "341880",
   "endMs": "346240",
   "startTimeText": "5:41"
  },
  {
   "text": "하나님의 말씀을 어기고 죄를 지은",
   "startMs": "343840",
   "endMs": "348600",
   "startTimeText": "5:43"
  },
  {
   "text": "벌을 받기 때문에 그래요. 오늘 말씀",
   "startMs": "346240",
   "endMs": "351319",
   "startTimeText": "5:46"
  },
  {
   "text": "6절을 보세요. 이스라엘 백성들이",
   "startMs": "348600",
   "endMs": "353600",
   "startTimeText": "5:48"
  },
  {
   "text": "광야에서 잘못된 행동을 해 가지고",
   "startMs": "351319",
   "endMs": "355400",
   "startTimeText": "5:51"
  },
  {
   "text": "벌받은 내용이 나와 있어요. 땅이 쫙",
   "startMs": "353600",
   "endMs": "357160",
   "startTimeText": "5:53"
  },
  {
   "text": "갈라져 가지고 잘못된 행동을 한",
   "startMs": "355400",
   "endMs": "359840",
   "startTimeText": "5:55"
  },
  {
   "text": "사람들을 다 땅에서 그냥 넣었대요.",
   "startMs": "357160",
   "endMs": "362039",
   "startTimeText": "5:57"
  },
  {
   "text": "그리고 이후에 16장 17절 말씀",
   "startMs": "359840",
   "endMs": "364440",
   "startTimeText": "5:59"
  },
  {
   "text": "28절 말씀 보면은 다른 신들을",
   "startMs": "362039",
   "endMs": "366160",
   "startTimeText": "6:02"
  },
  {
   "text": "섬기고 하나님 말씀 듣지 않으면은",
   "startMs": "364440",
   "endMs": "369639",
   "startTimeText": "6:04"
  },
  {
   "text": "멸망당한다고 경고하고 있어요. 모세는",
   "startMs": "366160",
   "endMs": "371840",
   "startTimeText": "6:06"
  },
  {
   "text": "이스라엘 백성들의 과거에 이러한 죄에",
   "startMs": "369639",
   "endMs": "373919",
   "startTimeText": "6:09"
  },
  {
   "text": "대한 하나님의 저주와 심판이 있었음을",
   "startMs": "371840",
   "endMs": "376440",
   "startTimeText": "6:11"
  },
  {
   "text": "알려주고 또한 이러한 죄를 또 짓게",
   "startMs": "373919",
   "endMs": "378759",
   "startTimeText": "6:13"
  },
  {
   "text": "되면은 심판과 저주가 있을 것임을",
   "startMs": "376440",
   "endMs": "381280",
   "startTimeText": "6:16"
  },
  {
   "text": "분명히 강고하고 있어요. 자, 근데",
   "startMs": "378759",
   "endMs": "383240",
   "startTimeText": "6:18"
  },
  {
   "text": "우리는 악한 세상 속에서 살아가면서",
   "startMs": "381280",
   "endMs": "385240",
   "startTimeText": "6:21"
  },
  {
   "text": "많은 유혹들을 받게 되죠. 그리고 죄",
   "startMs": "383240",
   "endMs": "387960",
   "startTimeText": "6:23"
  },
  {
   "text": "넘어지기도 해요. 이것은 죄악이",
   "startMs": "385240",
   "endMs": "389680",
   "startTimeText": "6:25"
  },
  {
   "text": "가득한 가나안 땅에 들어간 이스라엘",
   "startMs": "387960",
   "endMs": "391800",
   "startTimeText": "6:27"
  },
  {
   "text": "백성들에게도 마찬가지였어요.",
   "startMs": "389680",
   "endMs": "393520",
   "startTimeText": "6:29"
  },
  {
   "text": "가나안 종교의 유혹에 넘어가 가지고",
   "startMs": "391800",
   "endMs": "395319",
   "startTimeText": "6:31"
  },
  {
   "text": "이스라엘 백성들이 우상을 섬기기",
   "startMs": "393520",
   "endMs": "397599",
   "startTimeText": "6:33"
  },
  {
   "text": "시작했어요. 죄에 빠지기 시작했어요.",
   "startMs": "395319",
   "endMs": "399440",
   "startTimeText": "6:35"
  },
  {
   "text": "사사기나 열왕기 이런 말씀들 보면 다",
   "startMs": "397599",
   "endMs": "401199",
   "startTimeText": "6:37"
  },
  {
   "text": "이런 내용들이에요. 네. 사랑하는",
   "startMs": "399440",
   "endMs": "403720",
   "startTimeText": "6:39"
  },
  {
   "text": "의동구 친구들 하나님의 말씀을 따르는",
   "startMs": "401199",
   "endMs": "406560",
   "startTimeText": "6:41"
  },
  {
   "text": "것은 우리가 뭐예요? 선택이 아니라",
   "startMs": "403720",
   "endMs": "409240",
   "startTimeText": "6:43"
  },
  {
   "text": "필수예요. 무엇에 대한 죄에 빠지지",
   "startMs": "406560",
   "endMs": "411720",
   "startTimeText": "6:46"
  },
  {
   "text": "않기. 하나님의 말씀을 따를 때 우리",
   "startMs": "409240",
   "endMs": "413680",
   "startTimeText": "6:49"
  },
  {
   "text": "어떻게 돼요? 죄에서 점점점 멀어지게",
   "startMs": "411720",
   "endMs": "415319",
   "startTimeText": "6:51"
  },
  {
   "text": "되는 거예요. 그리고 하나님 말씀을",
   "startMs": "413680",
   "endMs": "417479",
   "startTimeText": "6:53"
  },
  {
   "text": "지킬 때 우리는 하나님의 심판에서도",
   "startMs": "415319",
   "endMs": "419840",
   "startTimeText": "6:55"
  },
  {
   "text": "멀어지게 되는 거예요. 우리의 삶이",
   "startMs": "417479",
   "endMs": "422039",
   "startTimeText": "6:57"
  },
  {
   "text": "하나님의 말씀을 지킴으로 죄와서",
   "startMs": "419840",
   "endMs": "424000",
   "startTimeText": "6:59"
  },
  {
   "text": "멀어진다는 것을 기억하면서 하나님",
   "startMs": "422039",
   "endMs": "425280",
   "startTimeText": "7:02"
  },
  {
   "text": "말씀 지키는 우리 친구들 되길",
   "startMs": "424000",
   "endMs": "428120",
   "startTimeText": "7:04"
  },
  {
   "text": "바래요. 자, 마지막 우리는 왜",
   "startMs": "425280",
   "endMs": "430520",
   "startTimeText": "7:05"
  },
  {
   "text": "하나님 말씀을 지켜야 될까요? 그것은",
   "startMs": "428120",
   "endMs": "432360",
   "startTimeText": "7:08"
  },
  {
   "text": "하나님 말씀을 지킬 때 복을 받기",
   "startMs": "430520",
   "endMs": "434479",
   "startTimeText": "7:10"
  },
  {
   "text": "때문에 그래요. 오늘 말씀 14절",
   "startMs": "432360",
   "endMs": "435919",
   "startTimeText": "7:12"
  },
  {
   "text": "15절 말씀을 보면 이런 내용이 나와",
   "startMs": "434479",
   "endMs": "438039",
   "startTimeText": "7:14"
  },
  {
   "text": "있어요. 하나님이 우리에게 이름비와",
   "startMs": "435919",
   "endMs": "440599",
   "startTimeText": "7:15"
  },
  {
   "text": "늦은비를 내려 주신 자 비를",
   "startMs": "438039",
   "endMs": "443560",
   "startTimeText": "7:18"
  },
  {
   "text": "내려준다는 건 뭔 얘기예요? 우리에게",
   "startMs": "440599",
   "endMs": "445759",
   "startTimeText": "7:20"
  },
  {
   "text": "필요한 것들을 채워 주신다는 거예요.",
   "startMs": "443560",
   "endMs": "448520",
   "startTimeText": "7:23"
  },
  {
   "text": "자, 여기서 성경 퀴즈. 이스라엘",
   "startMs": "445759",
   "endMs": "450360",
   "startTimeText": "7:25"
  },
  {
   "text": "백성들이 가는 가나안 땅이 정말 좋은",
   "startMs": "448520",
   "endMs": "452000",
   "startTimeText": "7:28"
  },
  {
   "text": "땅이었을까?",
   "startMs": "450360",
   "endMs": "453199",
   "startTimeText": "7:30"
  },
  {
   "text": "객관적으로 너무 살기 좋은",
   "startMs": "452000",
   "endMs": "454919",
   "startTimeText": "7:32"
  },
  {
   "text": "것이었을까요?",
   "startMs": "453199",
   "endMs": "457479",
   "startTimeText": "7:33"
  },
  {
   "text": "적당은 그렇죠. 우리 승경입니다.",
   "startMs": "454919",
   "endMs": "459639",
   "startTimeText": "7:34"
  },
  {
   "text": "그렇죠. 가나안 땅은 솔직히 말하면",
   "startMs": "457479",
   "endMs": "461520",
   "startTimeText": "7:37"
  },
  {
   "text": "척박한 곳이에요. 비가 느리지",
   "startMs": "459639",
   "endMs": "463599",
   "startTimeText": "7:39"
  },
  {
   "text": "않으면은 농사도 지을 수 없고 가축도",
   "startMs": "461520",
   "endMs": "465319",
   "startTimeText": "7:41"
  },
  {
   "text": "칠 수 없는 아주 척박한 곳이 바로",
   "startMs": "463599",
   "endMs": "468440",
   "startTimeText": "7:43"
  },
  {
   "text": "가나안 땅이에요. 그런데 그에 비해서",
   "startMs": "465319",
   "endMs": "470639",
   "startTimeText": "7:45"
  },
  {
   "text": "애국 땅은 나이강에 있어 가지고 어",
   "startMs": "468440",
   "endMs": "472840",
   "startTimeText": "7:48"
  },
  {
   "text": "농사도 지키지고 땅도 비하고 너무",
   "startMs": "470639",
   "endMs": "475039",
   "startTimeText": "7:50"
  },
  {
   "text": "먹을 것도 많고 좋은 거예요. 비가",
   "startMs": "472840",
   "endMs": "476879",
   "startTimeText": "7:52"
  },
  {
   "text": "오지 않아도 나강이기 때문에 가능한",
   "startMs": "475039",
   "endMs": "479120",
   "startTimeText": "7:55"
  },
  {
   "text": "거예요. 그런데 가나안 땅은 비가",
   "startMs": "476879",
   "endMs": "481440",
   "startTimeText": "7:56"
  },
  {
   "text": "내리지 않으면은 죽을 수도 있는 그런",
   "startMs": "479120",
   "endMs": "484039",
   "startTimeText": "7:59"
  },
  {
   "text": "땅인 거예요. 자, 그래서 바 그",
   "startMs": "481440",
   "endMs": "486159",
   "startTimeText": "8:01"
  },
  {
   "text": "가나안 땅에는 비를 내려준다고",
   "startMs": "484039",
   "endMs": "488120",
   "startTimeText": "8:04"
  },
  {
   "text": "얘기하고 있는 바알 신앙이 엄청나게",
   "startMs": "486159",
   "endMs": "491039",
   "startTimeText": "8:06"
  },
  {
   "text": "인기 정말 웃긴 거 뭔지 아세요? 바",
   "startMs": "488120",
   "endMs": "493680",
   "startTimeText": "8:08"
  },
  {
   "text": "신앙의 가장 최전성기이던 아악과",
   "startMs": "491039",
   "endMs": "496680",
   "startTimeText": "8:11"
  },
  {
   "text": "이세벨의 시대 비가 내리잖아요.",
   "startMs": "493680",
   "endMs": "498720",
   "startTimeText": "8:13"
  },
  {
   "text": "바알은 비를 내려 주는 신인데 그런",
   "startMs": "496680",
   "endMs": "500400",
   "startTimeText": "8:16"
  },
  {
   "text": "신을 막 승상하는데 비가",
   "startMs": "498720",
   "endMs": "502520",
   "startTimeText": "8:18"
  },
  {
   "text": "내리잖아요.이 얘기 뭐예요? 비를",
   "startMs": "500400",
   "endMs": "505039",
   "startTimeText": "8:20"
  },
  {
   "text": "내리시는 분이 하느님이라는 거예요.",
   "startMs": "502520",
   "endMs": "507240",
   "startTimeText": "8:22"
  },
  {
   "text": "자, 모세는 얘기합니다. 가나안 땅이",
   "startMs": "505039",
   "endMs": "509000",
   "startTimeText": "8:25"
  },
  {
   "text": "애굽 땅과는 달라도 하나님이 비를",
   "startMs": "507240",
   "endMs": "510680",
   "startTimeText": "8:27"
  },
  {
   "text": "주실 것이기 때문에 너희가 그 땅",
   "startMs": "509000",
   "endMs": "512760",
   "startTimeText": "8:29"
  },
  {
   "text": "가서 풍족하게 살 수 있다. 그러기",
   "startMs": "510680",
   "endMs": "514839",
   "startTimeText": "8:30"
  },
  {
   "text": "때문에 비를 내려 주시는 그 하나님을",
   "startMs": "512760",
   "endMs": "517360",
   "startTimeText": "8:32"
  },
  {
   "text": "의지하고 믿는다면 그분의 말씀을 잘",
   "startMs": "514839",
   "endMs": "518800",
   "startTimeText": "8:34"
  },
  {
   "text": "따라야 된다라고 얘기하고 있는",
   "startMs": "517360",
   "endMs": "521440",
   "startTimeText": "8:37"
  },
  {
   "text": "거예요. 사랑하는 유사동 친구들.",
   "startMs": "518800",
   "endMs": "524120",
   "startTimeText": "8:38"
  },
  {
   "text": "하나님이 솔직히 우리들을 좋은 학교,",
   "startMs": "521440",
   "endMs": "526080",
   "startTimeText": "8:41"
  },
  {
   "text": "좋은 회사, 좋은 지역으로",
   "startMs": "524120",
   "endMs": "527720",
   "startTimeText": "8:44"
  },
  {
   "text": "부르실까요?",
   "startMs": "526080",
   "endMs": "530519",
   "startTimeText": "8:46"
  },
  {
   "text": "그럴 수도 있고 아닐 수도 있어요.",
   "startMs": "527720",
   "endMs": "532760",
   "startTimeText": "8:47"
  },
  {
   "text": "가장 좋은 장소에 보내시지 않을 수도",
   "startMs": "530519",
   "endMs": "536200",
   "startTimeText": "8:50"
  },
  {
   "text": "있어요. 하지만 우리가 그 지역에서",
   "startMs": "532760",
   "endMs": "538560",
   "startTimeText": "8:52"
  },
  {
   "text": "그 땅에서 하나님의 말씀을 잘 따르고",
   "startMs": "536200",
   "endMs": "540880",
   "startTimeText": "8:56"
  },
  {
   "text": "잘 살아간다면 하나님께서 복을 내려",
   "startMs": "538560",
   "endMs": "543360",
   "startTimeText": "8:58"
  },
  {
   "text": "주셔서 그곳을 가장 아름다운 곳으로",
   "startMs": "540880",
   "endMs": "544959",
   "startTimeText": "9:00"
  },
  {
   "text": "가장 축복된 곳으로 만들어 주실",
   "startMs": "543360",
   "endMs": "546839",
   "startTimeText": "9:03"
  },
  {
   "text": "거예요. 우리 친구들이이 말씀을",
   "startMs": "544959",
   "endMs": "548920",
   "startTimeText": "9:04"
  },
  {
   "text": "기억하고 하나님을 사랑하며 하나님의",
   "startMs": "546839",
   "endMs": "551200",
   "startTimeText": "9:06"
  },
  {
   "text": "말씀을 지켜서 복을 받고 우리가 있는",
   "startMs": "548920",
   "endMs": "552839",
   "startTimeText": "9:08"
  },
  {
   "text": "곳을 놀라운 축복의 땅으로 만드는",
   "startMs": "551200",
   "endMs": "555200",
   "startTimeText": "9:11"
  },
  {
   "text": "우리 친구들 되길 바래요. 그러면",
   "startMs": "552839",
   "endMs": "557680",
   "startTimeText": "9:12"
  },
  {
   "text": "기도하겠습니다.",
   "startMs": "555200",
   "endMs": "560160",
   "startTimeText": "9:15"
  },
  {
   "text": "은혜와 사랑이 풍성하신 아버지.",
   "startMs": "557680",
   "endMs": "562279",
   "startTimeText": "9:17"
  },
  {
   "text": "오늘도 사랑하는 유치하던부 친구들과",
   "startMs": "560160",
   "endMs": "564680",
   "startTimeText": "9:20"
  },
  {
   "text": "말씀들 나누게 하시니 감사드립니다.",
   "startMs": "562279",
   "endMs": "566720",
   "startTimeText": "9:22"
  },
  {
   "text": "주님 혹시라도 우리가 하나님 말씀을",
   "startMs": "564680",
   "endMs": "569399",
   "startTimeText": "9:24"
  },
  {
   "text": "안된 것이 있다면 용서해 주세요.",
   "startMs": "566720",
   "endMs": "571200",
   "startTimeText": "9:26"
  },
  {
   "text": "이제는 우리에게 말씀을 주신 분이",
   "startMs": "569399",
   "endMs": "572959",
   "startTimeText": "9:29"
  },
  {
   "text": "우리를 사랑하시는 하나님이심을",
   "startMs": "571200",
   "endMs": "576079",
   "startTimeText": "9:31"
  },
  {
   "text": "기억하고 그 말씀을 즐거는 우리가",
   "startMs": "572959",
   "endMs": "578800",
   "startTimeText": "9:32"
  },
  {
   "text": "되게 해 주세요. 주님 하나님 말씀은",
   "startMs": "576079",
   "endMs": "581480",
   "startTimeText": "9:36"
  },
  {
   "text": "우리를 죄에서 지키시고 죄에서",
   "startMs": "578800",
   "endMs": "583839",
   "startTimeText": "9:38"
  },
  {
   "text": "벗어나게 하는 안전한 길이 됩니다.",
   "startMs": "581480",
   "endMs": "586560",
   "startTimeText": "9:41"
  },
  {
   "text": "늘 감사하면서 하나님의 말씀을 지키며",
   "startMs": "583839",
   "endMs": "588480",
   "startTimeText": "9:43"
  },
  {
   "text": "죄와 벌을 멀리하는 우리 친구들 되게",
   "startMs": "586560",
   "endMs": "590680",
   "startTimeText": "9:46"
  },
  {
   "text": "해 주세요. 주님 하나님 말씀은",
   "startMs": "588480",
   "endMs": "592720",
   "startTimeText": "9:48"
  },
  {
   "text": "우리에게 놀라운 축복입니다. 하나님의",
   "startMs": "590680",
   "endMs": "595000",
   "startTimeText": "9:50"
  },
  {
   "text": "말씀을 지킴으로 복을 받게 하시고",
   "startMs": "592720",
   "endMs": "596640",
   "startTimeText": "9:52"
  },
  {
   "text": "우리가 있는 곳을 축복의 땅으로",
   "startMs": "595000",
   "endMs": "598600",
   "startTimeText": "9:55"
  },
  {
   "text": "바꾸는 축복의 통로들이 되게 해",
   "startMs": "596640",
   "endMs": "601000",
   "startTimeText": "9:56"
  },
  {
   "text": "주세요. 우리를 생명과 축복의 길로",
   "startMs": "598600",
   "endMs": "603200",
   "startTimeText": "9:58"
  },
  {
   "text": "인도하시는 예수 그리스도의 이름으로",
   "startMs": "601000",
   "endMs": "607640",
   "startTimeText": "10:01"
  },
  {
   "text": "기도드립니다. 아멘. 축도하겠습니다.",
   "startMs": "603200",
   "endMs": "609680",
   "startTimeText": "10:03"
  },
  {
   "text": "지금은 우리 구주 예수 그리스도의",
   "startMs": "607640",
   "endMs": "612320",
   "startTimeText": "10:07"
  },
  {
   "text": "은혜와 하나님 아버지의 사랑하심과",
   "startMs": "609680",
   "endMs": "615000",
   "startTimeText": "10:09"
  },
  {
   "text": "성령의 교통하심과 함께 하심이 우리",
   "startMs": "612320",
   "endMs": "617000",
   "startTimeText": "10:12"
  },
  {
   "text": "친구들 가운데 하나님의 말씀을 더욱더",
   "startMs": "615000",
   "endMs": "619200",
   "startTimeText": "10:15"
  },
  {
   "text": "지키기를 결정하는 우리 모든 사람들",
   "startMs": "617000",
   "endMs": "622279",
   "startTimeText": "10:17"
  },
  {
   "text": "가운데 영원히 함께 하시기를 간절히",
   "startMs": "619200",
   "endMs": "625120",
   "startTimeText": "10:19"
  },
  {
   "text": "축원합니다. 아멘.",
   "startMs": "622279",
   "endMs": "627440",
   "startTimeText": "10:22"
  },
  {
   "text": "네. 수고하셨습니다.",
   "startMs": "625120",
   "endMs": "629360",
   "startTimeText": "10:25"
  },
  {
   "text": "네. 광고하도록 하겠습니다. 자,",
   "startMs": "627440",
   "endMs": "631279",
   "startTimeText": "10:27"
  },
  {
   "text": "예배 못 오는 친구들은 예배 영상으로",
   "startMs": "629360",
   "endMs": "633880",
   "startTimeText": "10:29"
  },
  {
   "text": "꼭 예배드리시길 바래요. 그리고 우리",
   "startMs": "631279",
   "endMs": "636000",
   "startTimeText": "10:31"
  },
  {
   "text": "친구들 예배 일찍 오시고요. 네.",
   "startMs": "633880",
   "endMs": "637720",
   "startTimeText": "10:33"
  },
  {
   "text": "다음 주 일찍 일어날 거지. 그래.",
   "startMs": "636000",
   "endMs": "639760",
   "startTimeText": "10:36"
  },
  {
   "text": "와. 와줘서 너무 고마워. 사랑해.",
   "startMs": "637720",
   "endMs": "644760",
   "startTimeText": "10:37"
  },
  {
   "text": "네. 자, 다른 친구들도 와야 돼.",
   "startMs": "639760",
   "endMs": "646920",
   "startTimeText": "10:39"
  },
  {
   "text": "자, 이학 때는 친구들을 좀 전도해서",
   "startMs": "644760",
   "endMs": "649079",
   "startTimeText": "10:44"
  },
  {
   "text": "교회 내려오도록 합시다. 그리고 우리",
   "startMs": "646920",
   "endMs": "650800",
   "startTimeText": "10:46"
  },
  {
   "text": "친구들 다음 주부터 교회 오면은 우리",
   "startMs": "649079",
   "endMs": "652399",
   "startTimeText": "10:49"
  },
  {
   "text": "선생님들이 맛있는 간식들을 준비해",
   "startMs": "650800",
   "endMs": "655079",
   "startTimeText": "10:50"
  },
  {
   "text": "놓으실 거예요. 자, 준비하실 거죠?",
   "startMs": "652399",
   "endMs": "656880",
   "startTimeText": "10:52"
  },
  {
   "text": "네. 그렇죠? 네. 시 기대하시기",
   "startMs": "655079",
   "endMs": "658880",
   "startTimeText": "10:55"
  },
  {
   "text": "바요. 아, 그리고 다음 주는 9월",
   "startMs": "656880",
   "endMs": "660800",
   "startTimeText": "10:56"
  },
  {
   "text": "생일 날치도록 하겠습니다. 건물 꼭",
   "startMs": "658880",
   "endMs": "662560",
   "startTimeText": "10:58"
  },
  {
   "text": "와야 돼.",
   "startMs": "660800",
   "endMs": "666160",
   "startTimeText": "11:00"
  },
  {
   "text": "자 그러면은 어머 광고를 안 볼 건데",
   "startMs": "662560",
   "endMs": "669480",
   "startTimeText": "11:02"
  },
  {
   "text": "지난지 광고데 죄송합니다. 자 그러면",
   "startMs": "666160",
   "endMs": "671240",
   "startTimeText": "11:06"
  },
  {
   "text": "다음 주에 봐요. 감사합니다.",
   "startMs": "669480",
   "endMs": "672200",
   "startTimeText": "11:09"
  },
  {
   "text": "고맙습니다.",
   "startMs": "671240",
   "endMs": "675459",
   "startTimeText": "11:11"
  },
  {
   "text": "[박수]",
   "startMs": "672200",
   "endMs": "675459",
   "startTimeText": "11:12"
  }
 ]
}