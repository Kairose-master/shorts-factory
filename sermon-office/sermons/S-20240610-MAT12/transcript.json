   "startTimeText": "0:33"
  },
  {
   "text": "[음악]",
   "startMs": "34750",
   "endMs": "38480",
   "startTimeText": "0:34"
  },
  {
   "text": "들어주소서 예수의",
   "startMs": "36040",
   "endMs": "40920",
   "startTimeText": "0:36"
  },
  {
   "text": "사랑 예수의",
   "startMs": "38480",
   "endMs": "43520",
   "startTimeText": "0:38"
  },
  {
   "text": "사랑 바다",
   "startMs": "40920",
   "endMs": "45879",
   "startTimeText": "0:40"
  },
  {
   "text": "물결같이 내게",
   "startMs": "43520",
   "endMs": "48399",
   "startTimeText": "0:43"
  },
  {
   "text": "임하니 영광의",
   "startMs": "45879",
   "endMs": "51239",
   "startTimeText": "0:45"
