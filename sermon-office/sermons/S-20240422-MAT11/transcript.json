 ],
 "transcript": [
  {
   "text": "찬송가",
   "startMs": "1599",
   "endMs": "6240",
   "startTimeText": "0:01"
  },
  {
   "text": "542장 함께 찬양하시는 4월 22일",
   "startMs": "3040",
   "endMs": "8519",
   "startTimeText": "0:03"
  },
  {
   "text": "월요일 새벽기도 하나님께",
   "startMs": "6240",
   "endMs": "13480",
   "startTimeText": "0:06"
  },
  {
   "text": "드리겠습니다 찬송가 542장",
   "startMs": "8519",
   "endMs": "13480",
   "startTimeText": "0:08"
  },
  {
   "text": "있니다 구 구주 예수",
   "startMs": "14160",
   "endMs": "24840",
   "startTimeText": "0:14"
  },
  {
   "text": "의지함이 심히 기쁜",
   "startMs": "20400",
   "endMs": "30400",
   "startTimeText": "0:20"
  },
  {
   "text": "이일세 영생 허락 받았으니",
   "startMs": "24840",
   "endMs": "33680",
   "startTimeText": "0:24"
  },
  {
   "text": "의심 아주",
   "startMs": "30400",
   "endMs": "40200",
   "startTimeText": "0:30"
  },
  {
   "text": "없도다 예수 예수 믿는 것은 받은",
   "startMs": "33680",
   "endMs": "42399",
   "startTimeText": "0:33"
  },
  {
   "text": "증거",
   "startMs": "40200",
   "endMs": "48879",
   "startTimeText": "0:40"
  },
  {
   "text": "많도다 예수 예수 귀한 예수 믿음",
   "startMs": "42399",
   "endMs": "51039",
   "startTimeText": "0:42"
  },
  {
   "text": "더욱",
   "startMs": "48879",
   "endMs": "55600",
   "startTimeText": "0:48"
  },
  {
   "text": "주소서 구주 예수",
   "startMs": "51039",
   "endMs": "61039",
   "startTimeText": "0:51"
  },
  {
   "text": "의지함이 심히 기쁜 일일",
   "startMs": "55600",
   "endMs": "68759",
   "startTimeText": "0:55"
  },
  {
   "text": "주를 믿는 나의 마음 그의 피해",
   "startMs": "61039",
   "endMs": "75159",
   "startTimeText": "1:01"
  },
  {
   "text": "적시네 예수 예수 믿는 것은 받은",
   "startMs": "68759",
   "endMs": "77400",
   "startTimeText": "1:08"
  },
  {
   "text": "증거",
   "startMs": "75159",
   "endMs": "84040",
   "startTimeText": "1:15"
  },
  {
   "text": "많도다 예수 예수 귀한 예수 믿음",
   "startMs": "77400",
   "endMs": "86280",
   "startTimeText": "1:17"
  },
  {
   "text": "더욱",
   "startMs": "84040",
   "endMs": "90720",
   "startTimeText": "1:24"
  },
  {
   "text": "주소서 구주 예수의",
   "startMs": "86280",
   "endMs": "94920",
   "startTimeText": "1:26"
  },
  {
   "text": "지하여 죄악 벗어",
   "startMs": "90720",
   "endMs": "99000",
   "startTimeText": "1:30"
  },
  {
   "text": "버리네 아니 받고",
   "startMs": "94920",
   "endMs": "100759",
   "startTimeText": "1:34"
  },
  {
   "text": "영생함을",
   "startMs": "99000",
   "endMs": "104079",
   "startTimeText": "1:39"
  },
  {
   "text": "주께 모두",
   "startMs": "100759",
   "endMs": "110640",
   "startTimeText": "1:40"
  },
  {
   "text": "얻었네 예수 예수 믿는 것은 받은",
   "startMs": "104079",
   "endMs": "112880",
   "startTimeText": "1:44"
  },
  {
   "text": "증거",
   "startMs": "110640",
   "endMs": "119920",
   "startTimeText": "1:50"
  },
  {
   "text": "많도다 예수 예수 귀한 예수 믿음 더",
   "startMs": "112880",
   "endMs": "121680",
   "startTimeText": "1:52"
  },
  {
   "text": "더욱",
   "startMs": "119920",
   "endMs": "126240",
   "startTimeText": "1:59"
  },
  {
   "text": "주소서 구주 예수",
   "startMs": "121680",
   "endMs": "128479",
   "startTimeText": "2:01"
  },
  {
   "text": "의지하여",
   "startMs": "126240",
   "endMs": "130599",
   "startTimeText": "2:06"
  },
  {
   "text": "구원함을",
   "startMs": "128479",
   "endMs": "135080",
   "startTimeText": "2:08"
  },
  {
   "text": "얻었네 영원 무궁",
   "startMs": "130599",
   "endMs": "139599",
   "startTimeText": "2:10"
  },
  {
   "text": "지나도록 주여 함께",
   "startMs": "135080",
   "endMs": "146160",
   "startTimeText": "2:15"
  },
  {
   "text": "하소서 예수 예수 믿는 것은 받은",
   "startMs": "139599",
   "endMs": "149959",
   "startTimeText": "2:19"
  },
  {
   "text": "증거 많도다",
   "startMs": "146160",
   "endMs": "157760",
   "startTimeText": "2:26"
  },
  {
   "text": "주 예수 귀한 예수 믿음 더욱",
   "startMs": "149959",
   "endMs": "160760",
   "startTimeText": "2:29"
  },
  {
   "text": "주소서",
   "startMs": "157760",
   "endMs": "160760",
   "startTimeText": "2:37"
  },
  {
   "text": "아멘 기도하시겠습니다",
   "startMs": "162239",
   "endMs": "165840",
   "startTimeText": "2:42"
  },
  {
   "text": "살아계신 하나님 오늘도 새로운 생명을",
   "startMs": "167200",
   "endMs": "173560",
   "startTimeText": "2:47"
  },
  {
   "text": "주셔서 감사합니다 오늘도 새로이",
   "startMs": "170560",
   "endMs": "176519",
   "startTimeText": "2:50"
  },
  {
   "text": "새벽을 깨워 주시고 이렇게 예배할 수",
   "startMs": "173560",
   "endMs": "179400",
   "startTimeText": "2:53"
  },
  {
   "text": "있는 예배당을 주셔서 이곳으로 불러",
   "startMs": "176519",
   "endMs": "182120",
   "startTimeText": "2:56"
  },
  {
   "text": "주시고 기도할 수 있는들을 허락하여",
   "startMs": "179400",
   "endMs": "184799",
   "startTimeText": "2:59"
  },
  {
   "text": "주셔서 감사합니다 하나님이 시간에도",
   "startMs": "182120",
   "endMs": "187720",
   "startTimeText": "3:02"
  },
  {
   "text": "우리가 마음속 깊이 간식하고 있는",
   "startMs": "184799",
   "endMs": "190599",
   "startTimeText": "3:04"
  },
  {
   "text": "간절한 기도의 제목들을 가지고",
   "startMs": "187720",
   "endMs": "193879",
   "startTimeText": "3:07"
  },
  {
   "text": "나왔습니다 하나님 우리가 하나님을",
   "startMs": "190599",
   "endMs": "196680",
   "startTimeText": "3:10"
  },
  {
   "text": "믿는 믿음으로 기도할 수 있도록",
   "startMs": "193879",
   "endMs": "199400",
   "startTimeText": "3:13"
  },
  {
   "text": "도와주시옵소서 하나님 없는 것을 있는",
   "startMs": "196680",
   "endMs": "201879",
   "startTimeText": "3:16"
  },
  {
   "text": "것으로 부르시는 분이시고 죽은 자를",
   "startMs": "199400",
   "endMs": "204879",
   "startTimeText": "3:19"
  },
  {
   "text": "살리시는 그 전능하신 하나님이십니다",
   "startMs": "201879",
   "endMs": "206799",
   "startTimeText": "3:21"
  },
  {
   "text": "하나님 우리 모든 기도제목을",
   "startMs": "204879",
   "endMs": "209840",
   "startTimeText": "3:24"
  },
  {
   "text": "하나님께서 아시오니이 시간도 우리가",
   "startMs": "206799",
   "endMs": "212519",
   "startTimeText": "3:26"
  },
  {
   "text": "인내로서 믿음으로 기도할 때에 하나님",
   "startMs": "209840",
   "endMs": "215159",
   "startTimeText": "3:29"
  },
  {
   "text": "모든 것 들어 역사하여 주시옵소서",
   "startMs": "212519",
   "endMs": "217200",
   "startTimeText": "3:32"
  },
  {
   "text": "하나님 우리가 참으로 하나님을",
   "startMs": "215159",
   "endMs": "220319",
   "startTimeText": "3:35"
  },
  {
   "text": "의지하는 가운데에서 우리 마음과 우리",
   "startMs": "217200",
   "endMs": "223239",
   "startTimeText": "3:37"
  },
  {
   "text": "영혼에 진정한 안식과 쉼을 누릴 수",
   "startMs": "220319",
   "endMs": "225519",
   "startTimeText": "3:40"
  },
  {
   "text": "있도록 은혜를 베풀어 주시옵소서",
   "startMs": "223239",
   "endMs": "227799",
   "startTimeText": "3:43"
  },
  {
   "text": "하나님의 선하심이 지금도 우리를",
   "startMs": "225519",
   "endMs": "230319",
   "startTimeText": "3:45"
  },
  {
   "text": "따라하고 있으며 앞으로도 하나님께서는",
   "startMs": "227799",
   "endMs": "232319",
   "startTimeText": "3:47"
  },
  {
   "text": "우리를 가장 선한 곳으로 인도하실",
   "startMs": "230319",
   "endMs": "235760",
   "startTimeText": "3:50"
  },
  {
   "text": "것입니다 그 하나님을 우리가 믿습니다",
   "startMs": "232319",
   "endMs": "240000",
   "startTimeText": "3:52"
  },
  {
   "text": "신뢰합니다 나의 삶가운데 하나님의 신",
   "startMs": "235760",
   "endMs": "242280",
   "startTimeText": "3:55"
  },
  {
   "text": "계획이 지금도 이루어지고 있는 줄을",
   "startMs": "240000",
   "endMs": "245000",
   "startTimeText": "4:00"
  },
  {
   "text": "믿습니다 우리들의 가정 가운데에",
   "startMs": "242280",
   "endMs": "247360",
   "startTimeText": "4:02"
  },
  {
   "text": "하나님의 가장 좋은 뜻이 지금도",
   "startMs": "245000",
   "endMs": "249680",
   "startTimeText": "4:05"
  },
  {
   "text": "역사하고 있는 줄 믿습니다 그것을",
   "startMs": "247360",
   "endMs": "251879",
   "startTimeText": "4:07"
  },
  {
   "text": "믿는 믿음으로 더 하나님께 감사하는",
   "startMs": "249680",
   "endMs": "253560",
   "startTimeText": "4:09"
  },
  {
   "text": "삶을 살 수 있도록",
   "startMs": "251879",
   "endMs": "255560",
   "startTimeText": "4:11"
  },
  {
   "text": "도와주시옵소서이 시간에도 말씀 앞으로",
   "startMs": "253560",
   "endMs": "258239",
   "startTimeText": "4:13"
  },
  {
   "text": "나아갈 때에 주님의 성령으로 충만하게",
   "startMs": "255560",
   "endMs": "260479",
   "startTimeText": "4:15"
  },
  {
   "text": "하여 주시고 말씀 가운데 주님의",
   "startMs": "258239",
   "endMs": "262560",
   "startTimeText": "4:18"
  },
  {
   "text": "음성을들을 수 있도록 도와주시옵소서",
   "startMs": "260479",
   "endMs": "266240",
   "startTimeText": "4:20"
  },
  {
   "text": "예수님 이름으로 기도합니다 아멘",
   "startMs": "262560",
   "endMs": "270160",
   "startTimeText": "4:22"
  },
  {
   "text": "아멘 오늘 함께 오신 하나님 말씀은",
   "startMs": "266240",
   "endMs": "275440",
   "startTimeText": "4:26"
  },
  {
   "text": "마태복음 11장 25절 30절 지의",
   "startMs": "270160",
   "endMs": "275440",
   "startTimeText": "4:30"
  },
  {
   "text": "말씀입니다 마태복음 11장 25절",
   "startMs": "280880",
   "endMs": "290639",
   "startTimeText": "4:40"
  },
  {
   "text": "30절 지의 말씀께 찾으신 후에 합독",
   "startMs": "284759",
   "endMs": "290639",
   "startTimeText": "4:44"
  },
  {
   "text": "아시겠습니다만 주이신 아버지여 이것을",
   "startMs": "298639",
   "endMs": "304320",
   "startTimeText": "4:58"
  },
  {
   "text": "지혜롭고 슬기 있는 자들에게는",
   "startMs": "302000",
   "endMs": "307360",
   "startTimeText": "5:02"
  },
  {
   "text": "숨기시고 어린아이들에게는 나타내심을",
   "startMs": "304320",
   "endMs": "310600",
   "startTimeText": "5:04"
  },
  {
   "text": "감사하나이다 소이다 이렇게 된 것이",
   "startMs": "307360",
   "endMs": "313720",
   "startTimeText": "5:07"
  },
  {
   "text": "아버지의 뜻이다 내 아버지께서 모든",
   "startMs": "310600",
   "endMs": "316440",
   "startTimeText": "5:10"
  },
  {
   "text": "것을 내게 주셨으니 아버지 외에는",
   "startMs": "313720",
   "endMs": "319039",
   "startTimeText": "5:13"
  },
  {
   "text": "아들을 아는 자가 없고 아들과 또",
   "startMs": "316440",
   "endMs": "322280",
   "startTimeText": "5:16"
  },
  {
   "text": "아들의 소원대로 시를 받는 자 외에는",
   "startMs": "319039",
   "endMs": "325319",
   "startTimeText": "5:19"
  },
  {
   "text": "아버지를 아는 자가 없느니라 수호하고",
   "startMs": "322280",
   "endMs": "328280",
   "startTimeText": "5:22"
  },
  {
   "text": "무거운 짐진자들아 다 내게로 오라",
   "startMs": "325319",
   "endMs": "330319",
   "startTimeText": "5:25"
  },
  {
   "text": "내가 너희를 쉬",
   "startMs": "328280",
   "endMs": "333000",
   "startTimeText": "5:28"
  },
  {
   "text": "는",
   "startMs": "330319",
   "endMs": "333000",
   "startTimeText": "5:30"
  },
  {
   "text": "니의를고게라 그리면 너 마음이을",
   "startMs": "334360",
   "endMs": "340880",
   "startTimeText": "5:34"
  },
  {
   "text": "얻으리니이는 내 멍 쉽고 내짐은",
   "startMs": "337680",
   "endMs": "342319",
   "startTimeText": "5:37"
  },
  {
   "text": "가벼움이라",
   "startMs": "340880",
   "endMs": "345319",
   "startTimeText": "5:40"
  },
  {
   "text": "하시니라",
   "startMs": "342319",
   "endMs": "345319",
   "startTimeText": "5:42"
  },
  {
   "text": "아 예수님께서 25절에 하신",
   "startMs": "345400",
   "endMs": "355440",
   "startTimeText": "5:45"
  },
  {
   "text": "말씀이 천지 주지이신 아버지여 이것을",
   "startMs": "350000",
   "endMs": "356550",
   "startTimeText": "5:50"
  },
  {
   "text": "지혜는들에는",
   "startMs": "355440",
   "endMs": "358639",
   "startTimeText": "5:55"
  },
  {
   "text": "[음악]",
   "startMs": "356550",
   "endMs": "361440",
   "startTimeText": "5:56"
  },
  {
   "text": "숨어들",
   "startMs": "358639",
   "endMs": "364120",
   "startTimeText": "5:58"
  },
  {
   "text": "사하 이것이 무엇인가에 대해서한번",
   "startMs": "361440",
   "endMs": "367039",
   "startTimeText": "6:01"
  },
  {
   "text": "상을 해봤습니다",
   "startMs": "364120",
   "endMs": "370840",
   "startTimeText": "6:04"
  },
  {
   "text": "27절에 아버지께서든 것을게 주셨으니",
   "startMs": "367039",
   "endMs": "374400",
   "startTimeText": "6:07"
  },
  {
   "text": "아지에는 아들을 아는 자가 없 아들과",
   "startMs": "370840",
   "endMs": "377479",
   "startTimeText": "6:10"
  },
  {
   "text": "아들의 소원대로 를받는 자에는",
   "startMs": "374400",
   "endMs": "380319",
   "startTimeText": "6:14"
  },
  {
   "text": "아버지를 아는 자가라",
   "startMs": "377479",
   "endMs": "383280",
   "startTimeText": "6:17"
  },
  {
   "text": "말씀을 예수님께서 하나님께",
   "startMs": "380319",
   "endMs": "385280",
   "startTimeText": "6:20"
  },
  {
   "text": "사것",
   "startMs": "383280",
   "endMs": "386880",
   "startTimeText": "6:23"
  },
  {
   "text": "지혜는들에는",
   "startMs": "385280",
   "endMs": "388560",
   "startTimeText": "6:25"
  },
  {
   "text": "추지만",
   "startMs": "386880",
   "endMs": "390240",
   "startTimeText": "6:26"
  },
  {
   "text": "린들",
   "startMs": "388560",
   "endMs": "392759",
   "startTimeText": "6:28"
  },
  {
   "text": "신 그것이",
   "startMs": "390240",
   "endMs": "394280",
   "startTimeText": "6:30"
  },
  {
   "text": "무엇이냐면",
   "startMs": "392759",
   "endMs": "396919",
   "startTimeText": "6:32"
  },
  {
   "text": "어 하나님의",
   "startMs": "394280",
   "endMs": "400160",
   "startTimeText": "6:34"
  },
  {
   "text": "은혜로 아들이신 예수님을 아는 것",
   "startMs": "396919",
   "endMs": "403199",
   "startTimeText": "6:36"
  },
  {
   "text": "그리고 아들의 소원대로 하나님을",
   "startMs": "400160",
   "endMs": "405360",
   "startTimeText": "6:40"
  },
  {
   "text": "아버지를 아는 것 바로",
   "startMs": "403199",
   "endMs": "407759",
   "startTimeText": "6:43"
  },
  {
   "text": "그것을 본문을 통해서 볼 수가",
   "startMs": "405360",
   "endMs": "411120",
   "startTimeText": "6:45"
  },
  {
   "text": "있습니다 여러분은 예수님과 하나님을",
   "startMs": "407759",
   "endMs": "414520",
   "startTimeText": "6:47"
  },
  {
   "text": "알고 계신다고",
   "startMs": "411120",
   "endMs": "418160",
   "startTimeText": "6:51"
  },
  {
   "text": "믿습니다지를 신",
   "startMs": "414520",
   "endMs": "418160",
   "startTimeText": "6:54"
  },
  {
   "text": "분이 은 우리의 모든 죄를 대속하시고",
   "startMs": "418520",
   "endMs": "425479",
   "startTimeText": "6:58"
  },
  {
   "text": "지금도 성령으로 우리를 인도하시는",
   "startMs": "423000",
   "endMs": "426560",
   "startTimeText": "7:03"
  },
  {
   "text": "그런",
   "startMs": "425479",
   "endMs": "428440",
   "startTimeText": "7:05"
  },
  {
   "text": "분이십니다 우리가",
   "startMs": "426560",
   "endMs": "431919",
   "startTimeText": "7:06"
  },
  {
   "text": "그분을 진심으로 안다면 우리 마음이",
   "startMs": "428440",
   "endMs": "435520",
   "startTimeText": "7:08"
  },
  {
   "text": "쉼을 얻을 수 있을 것입니다 많은",
   "startMs": "431919",
   "endMs": "437800",
   "startTimeText": "7:11"
  },
  {
   "text": "사람들이 여러 가지 상황 가운데서",
   "startMs": "435520",
   "endMs": "440360",
   "startTimeText": "7:15"
  },
  {
   "text": "믿음이 연약해지는 이유는",
   "startMs": "437800",
   "endMs": "442800",
   "startTimeText": "7:17"
  },
  {
   "text": "어 그 상황보다 하나님이 작게",
   "startMs": "440360",
   "endMs": "445240",
   "startTimeText": "7:20"
  },
  {
   "text": "느껴지기 때문인 것입니다 그리고",
   "startMs": "442800",
   "endMs": "447479",
   "startTimeText": "7:22"
  },
  {
   "text": "우리가 살면서 여러 가지 걱정과",
   "startMs": "445240",
   "endMs": "450599",
   "startTimeText": "7:25"
  },
  {
   "text": "근심과 염려 가운데에서",
   "startMs": "447479",
   "endMs": "453599",
   "startTimeText": "7:27"
  },
  {
   "text": "두려워하는 것들",
   "startMs": "450599",
   "endMs": "457000",
   "startTimeText": "7:30"
  },
  {
   "text": "것도 그러한 상황들이 예수님보다 더",
   "startMs": "453599",
   "endMs": "460240",
   "startTimeText": "7:33"
  },
  {
   "text": "크게 느껴지기 때문인 것입니다 하지만",
   "startMs": "457000",
   "endMs": "462319",
   "startTimeText": "7:37"
  },
  {
   "text": "우리가 느끼는 그 어떤 것보다 우리",
   "startMs": "460240",
   "endMs": "465039",
   "startTimeText": "7:40"
  },
  {
   "text": "갖고 있는 그 어떠 걱정과 근심보다",
   "startMs": "462319",
   "endMs": "468440",
   "startTimeText": "7:42"
  },
  {
   "text": "하나님은 크신 분이시고",
   "startMs": "465039",
   "endMs": "471080",
   "startTimeText": "7:45"
  },
  {
   "text": "예수님은 그 모든 것을 주관하고",
   "startMs": "468440",
   "endMs": "475000",
   "startTimeText": "7:48"
  },
  {
   "text": "계시는 주권자 이십니다 이것을",
   "startMs": "471080",
   "endMs": "476960",
   "startTimeText": "7:51"
  },
  {
   "text": "지혜롭고 슬기 있는 자들에게는",
   "startMs": "475000",
   "endMs": "478440",
   "startTimeText": "7:55"
  },
  {
   "text": "하나님께서",
   "startMs": "476960",
   "endMs": "482479",
   "startTimeText": "7:56"
  },
  {
   "text": "숨기고 같이 겸손한 자들에게는",
   "startMs": "478440",
   "endMs": "485120",
   "startTimeText": "7:58"
  },
  {
   "text": "나타내셨다 그런 예수님의 말씀입니다",
   "startMs": "482479",
   "endMs": "488319",
   "startTimeText": "8:02"
  },
  {
   "text": "어이 말씀이 오늘 우리에게 다시 한번",
   "startMs": "485120",
   "endMs": "490680",
   "startTimeText": "8:05"
  },
  {
   "text": "어 성령께서 계시로 깨닫게 해",
   "startMs": "488319",
   "endMs": "493159",
   "startTimeText": "8:08"
  },
  {
   "text": "주셨으면 좋겠습니다 우리가 지금 갖고",
   "startMs": "490680",
   "endMs": "495479",
   "startTimeText": "8:10"
  },
  {
   "text": "있는 여러 가지 우리를 두렵게 하는",
   "startMs": "493159",
   "endMs": "497919",
   "startTimeText": "8:13"
  },
  {
   "text": "그것들보다 하나님의 더 크심을 우리가",
   "startMs": "495479",
   "endMs": "500319",
   "startTimeText": "8:15"
  },
  {
   "text": "바라볼 수 있는 그 믿음이 열렸으면",
   "startMs": "497919",
   "endMs": "502039",
   "startTimeText": "8:17"
  },
  {
   "text": "좋겠고",
   "startMs": "500319",
   "endMs": "505560",
   "startTimeText": "8:20"
  },
  {
   "text": "어 막막하게 느껴질지라도 어 예수님은",
   "startMs": "502039",
   "endMs": "507759",
   "startTimeText": "8:22"
  },
  {
   "text": "우리의 목자가 되어 주셔서 지금도",
   "startMs": "505560",
   "endMs": "510479",
   "startTimeText": "8:25"
  },
  {
   "text": "우리를 가장 선한 곳으로 인도하고",
   "startMs": "507759",
   "endMs": "514360",
   "startTimeText": "8:27"
  },
  {
   "text": "신다는 그 예수님을 향한 믿음의 눈이",
   "startMs": "510479",
   "endMs": "519080",
   "startTimeText": "8:30"
  },
  {
   "text": "열렸으면 좋겠습니다 아 편 25편",
   "startMs": "514360",
   "endMs": "522200",
   "startTimeText": "8:34"
  },
  {
   "text": "1절에이 말씀",
   "startMs": "519080",
   "endMs": "522200",
   "startTimeText": "8:39"
  },
  {
   "text": "있습니다의 영혼이 주를",
   "startMs": "522680",
   "endMs": "528240",
   "startTimeText": "8:42"
  },
  {
   "text": "나이의 하나이가",
   "startMs": "525480",
   "endMs": "530360",
   "startTimeText": "8:45"
  },
  {
   "text": "니를 럽지",
   "startMs": "528240",
   "endMs": "531880",
   "startTimeText": "8:48"
  },
  {
   "text": "않의",
   "startMs": "530360",
   "endMs": "534360",
   "startTimeText": "8:50"
  },
  {
   "text": "들이를 부르",
   "startMs": "531880",
   "endMs": "536280",
   "startTimeText": "8:51"
  },
  {
   "text": "하서",
   "startMs": "534360",
   "endMs": "538440",
   "startTimeText": "8:54"
  },
  {
   "text": "[음악]",
   "startMs": "536280",
   "endMs": "541279",
   "startTimeText": "8:56"
  },
  {
   "text": "편입니다 이야기하고 있습니다 나의",
   "startMs": "538440",
   "endMs": "544240",
   "startTimeText": "8:58"
  },
  {
   "text": "하나님이여 내가 주께 의지하였사오니",
   "startMs": "541279",
   "endMs": "547160",
   "startTimeText": "9:01"
  },
  {
   "text": "나를 부끄럽지 않게",
   "startMs": "544240",
   "endMs": "549920",
   "startTimeText": "9:04"
  },
  {
   "text": "하시고라고 고백을 하고 있습니다",
   "startMs": "547160",
   "endMs": "552720",
   "startTimeText": "9:07"
  },
  {
   "text": "의지하고 있다라는",
   "startMs": "549920",
   "endMs": "556000",
   "startTimeText": "9:09"
  },
  {
   "text": "말은 영어 성경으로 좀 더 이해하기가",
   "startMs": "552720",
   "endMs": "559200",
   "startTimeText": "9:12"
  },
  {
   "text": "편한데 기대고 있다라는 그런 뜻입니다",
   "startMs": "556000",
   "endMs": "562519",
   "startTimeText": "9:16"
  },
  {
   "text": "어 다윗은 여기서 하나님이여 내가",
   "startMs": "559200",
   "endMs": "565560",
   "startTimeText": "9:19"
  },
  {
   "text": "하나님께 기대고 있습니다 그러므로",
   "startMs": "562519",
   "endMs": "567760",
   "startTimeText": "9:22"
  },
  {
   "text": "나를 부끄럽지 않게 하시고 나의",
   "startMs": "565560",
   "endMs": "571320",
   "startTimeText": "9:25"
  },
  {
   "text": "원수들이 나를 이겨 승리 승전가를",
   "startMs": "567760",
   "endMs": "574279",
   "startTimeText": "9:27"
  },
  {
   "text": "부르지 못하게 하소서라고 하나님 앞에",
   "startMs": "571320",
   "endMs": "575959",
   "startTimeText": "9:31"
  },
  {
   "text": "기도하고 있는",
   "startMs": "574279",
   "endMs": "579240",
   "startTimeText": "9:34"
  },
  {
   "text": "것입니다 다윗은 하나님께 기대는 삶을",
   "startMs": "575959",
   "endMs": "581200",
   "startTimeText": "9:35"
  },
  {
   "text": "살고 있습니다 우리가 무언가에",
   "startMs": "579240",
   "endMs": "584720",
   "startTimeText": "9:39"
  },
  {
   "text": "기다라는 것은 우리 스스로의 힘으로",
   "startMs": "581200",
   "endMs": "588800",
   "startTimeText": "9:41"
  },
  {
   "text": "서지 않고 어 무언가의 의지해 우리가",
   "startMs": "584720",
   "endMs": "592920",
   "startTimeText": "9:44"
  },
  {
   "text": "기대서 다라는 것입니다 어 우리가",
   "startMs": "588800",
   "endMs": "594920",
   "startTimeText": "9:48"
  },
  {
   "text": "이제 뭐 예를 들어서 벽 이라든지",
   "startMs": "592920",
   "endMs": "598640",
   "startTimeText": "9:52"
  },
  {
   "text": "어떤 튼튼한 물건에 기대에 섰을 때에",
   "startMs": "594920",
   "endMs": "602240",
   "startTimeText": "9:54"
  },
  {
   "text": "중력이 아래로 끌어당기는 힘 때문에",
   "startMs": "598640",
   "endMs": "604800",
   "startTimeText": "9:58"
  },
  {
   "text": "우리가 쓰러질 듯 하지만은 우리를",
   "startMs": "602240",
   "endMs": "607760",
   "startTimeText": "10:02"
  },
  {
   "text": "지탱하고 있는이 튼튼한 벽 때문에",
   "startMs": "604800",
   "endMs": "610279",
   "startTimeText": "10:04"
  },
  {
   "text": "우리는 절대로 쓰러지지 않는 것입니다",
   "startMs": "607760",
   "endMs": "613120",
   "startTimeText": "10:07"
  },
  {
   "text": "하지만 우리가 우리 스스로의 힘으로서",
   "startMs": "610279",
   "endMs": "615600",
   "startTimeText": "10:10"
  },
  {
   "text": "있다라고 했을 때에 우리 힘이",
   "startMs": "613120",
   "endMs": "617839",
   "startTimeText": "10:13"
  },
  {
   "text": "약해지거나 우리의 마음이 약해지거나",
   "startMs": "615600",
   "endMs": "619040",
   "startTimeText": "10:15"
  },
  {
   "text": "했을",
   "startMs": "617839",
   "endMs": "621720",
   "startTimeText": "10:17"
  },
  {
   "text": "때에는 우리를 아래로 끌어당기는 그",
   "startMs": "619040",
   "endMs": "623839",
   "startTimeText": "10:19"
  },
  {
   "text": "여러 가지 힘들에 의해서 우리는 주저",
   "startMs": "621720",
   "endMs": "626880",
   "startTimeText": "10:21"
  },
  {
   "text": "함께 되는 것입니다 하지만 우리가",
   "startMs": "623839",
   "endMs": "629279",
   "startTimeText": "10:23"
  },
  {
   "text": "벽을 된다거나 어떤 튼튼한 물건을",
   "startMs": "626880",
   "endMs": "631519",
   "startTimeText": "10:26"
  },
  {
   "text": "기대고 있으면 우리의 마음이",
   "startMs": "629279",
   "endMs": "635440",
   "startTimeText": "10:29"
  },
  {
   "text": "약해지더라도 우리는 어 주저하지 못할",
   "startMs": "631519",
   "endMs": "637760",
   "startTimeText": "10:31"
  },
  {
   "text": "수가 있는 것입니다 그것이 바로",
   "startMs": "635440",
   "endMs": "640200",
   "startTimeText": "10:35"
  },
  {
   "text": "하나님을 의지하고 있기 그런 때문인",
   "startMs": "637760",
   "endMs": "643279",
   "startTimeText": "10:37"
  },
  {
   "text": "것입니다 다윗은 바로이 시편에서",
   "startMs": "640200",
   "endMs": "645920",
   "startTimeText": "10:40"
  },
  {
   "text": "하나님을 그렇게 의지하고 있사오니",
   "startMs": "643279",
   "endMs": "648920",
   "startTimeText": "10:43"
  },
  {
   "text": "부끄럽지 않게 하시고 원수들이 어",
   "startMs": "645920",
   "endMs": "651120",
   "startTimeText": "10:45"
  },
  {
   "text": "이기지 못하게 해 달라고 간구하고",
   "startMs": "648920",
   "endMs": "653880",
   "startTimeText": "10:48"
  },
  {
   "text": "있는 것입니다 어 이렇게 하나님을",
   "startMs": "651120",
   "endMs": "656880",
   "startTimeText": "10:51"
  },
  {
   "text": "의지하는 어 우리 모두에게 똑같은",
   "startMs": "653880",
   "endMs": "660079",
   "startTimeText": "10:53"
  },
  {
   "text": "은혜를 베풀어 주시기 어 간절히",
   "startMs": "656880",
   "endMs": "662480",
   "startTimeText": "10:56"
  },
  {
   "text": "기도합니다 하나님을 진심으로 의지하는",
   "startMs": "660079",
   "endMs": "665680",
   "startTimeText": "11:00"
  },
  {
   "text": "그런 성도분들에게 하나님은 반드시 어",
   "startMs": "662480",
   "endMs": "668800",
   "startTimeText": "11:02"
  },
  {
   "text": "그를 부끄럽지 않게 해 주실 것이고",
   "startMs": "665680",
   "endMs": "671440",
   "startTimeText": "11:05"
  },
  {
   "text": "어 그들의 원수들이 결코 이기지",
   "startMs": "668800",
   "endMs": "674320",
   "startTimeText": "11:08"
  },
  {
   "text": "못하도록 어 그분들을 붙들어 주실",
   "startMs": "671440",
   "endMs": "678519",
   "startTimeText": "11:11"
  },
  {
   "text": "거라고 믿습니다 아멘 성경에서는",
   "startMs": "674320",
   "endMs": "681720",
   "startTimeText": "11:14"
  },
  {
   "text": "안식에 대해서 어 두 가지 종류의",
   "startMs": "678519",
   "endMs": "683519",
   "startTimeText": "11:18"
  },
  {
   "text": "안식에 대해서 이야기하고 있습니다 첫",
   "startMs": "681720",
   "endMs": "687360",
   "startTimeText": "11:21"
  },
  {
   "text": "번째는 어 창조 이후의 안식이 두",
