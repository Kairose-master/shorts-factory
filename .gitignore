# Credentials — never commit.
.env
.env.local

# Timestamped research runs. Raw scrape output can be large and is
# reproducible from the source APIs, so it stays out of git.
youtube-research/*/
tiktok-research/*/
instagram-research/*/
x-research/*/
content-plans/*/
!**/.gitkeep

# Downloaded media used for transcript/hook analysis.
*.mp4
*.mov
*.mp3
*.wav
*.m4a

# ...but a finished video and the narration it was timed against are the
# record of what shipped, and a TTS endpoint is not guaranteed to return the
# same audio next month. Intermediate silent renders stay out; they rebuild
# from render.py in under a minute.
!projects/**/*.mp4
projects/**/silent.mp4
!projects/**/vo/*.wav

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node (only if you later add the Remotion composer)
node_modules/

# OS
.DS_Store
