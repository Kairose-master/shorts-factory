# Credentials — never commit.
.env
.env.local

# Timestamped research runs. Raw scrape output can be large and is
# reproducible from the source APIs, so it stays out of git.
youtube-research/*/
tiktok-research/*/
instagram-research/*/
x-research/*/
content-plans/*/
!**/.gitkeep

# Downloaded media used for transcript/hook analysis.
*.mp4
*.mov
*.mp3
*.wav
*.m4a

# The asset library is the exception. It is the Office's reusable media —
# an asset library that vanishes on clone is not a library. Small, and the
# licence for every file is recorded in a manifest beside it.
!office/asset-library/**/*.wav
!office/asset-library/**/*.mp3
!office/asset-library/**/*.mp4

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node (only if you later add the Remotion composer)
node_modules/

# OS
.DS_Store

# Vendored render engine — OpenMontage (AGPL-3.0), ~160MB, reproducible.
# Reinstall with: bash .claude/skills/openmontage/scripts/install.sh
vendor/

# Office renders. Plans, scripts and QC verdicts are committed; binaries are not.
office/production/*/renders/
office/production/*/refs/

# 설교 쇼츠 오피스. 렌더는 커밋하지 않는다 — 계획·대본·QC 판정만.
sermon-office/production/*/renders/
sermon-office/production/*/refs/
# sermons/*/transcript.json 은 의도적으로 커밋한다. 논리 지도와 대본의 모든
# 인용이 그 파일의 타임스탬프를 가리키므로, 사라지면 근거 추적이 끊긴다.
# 재수집은 편당 1 credit 이 든다. 코퍼스가 커지면 이 정책을 다시 본다.

# Piper 음성 모델 — 63MB 바이너리, HuggingFace rhasspy/piper-voices 에서 재취득 가능
sermon-office/production/_engine/voices/*.onnx
