# --- Instagram publishing (official Graph API) ------------------------------
# The Office's outbound social channel. All three unset = feature off; every
# surface degrades to a structured "instagram not configured" no-op, never an
# error. Long-lived token belongs in platform_secrets ('instagram_token');
# this env var is the local-dev fallback. NEVER commit a real value.
#
# INSTAGRAM_ACCESS_TOKEN   long-lived Page/System-User token with
#                          instagram_basic + instagram_content_publish
#                          (+ instagram_manage_insights for analytics)
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID     the IG professional account's ig-user-id
#                          (GET /me/accounts -> page -> instagram_business_account)
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_API_VERSION    optional Graph version pin, e.g. v21.0. Unset =
#                          Meta's default. Pin before relying on new fields.
INSTAGRAM_API_VERSION=
# INSTAGRAM_GRAPH_ORIGIN   tests/dev only: override the Graph origin. The
#                          e2e suite points this at a local http server.
# INSTAGRAM_GRAPH_ORIGIN=

# --- Instagram DM automation (comment-triggered Private Replies) ------------
# Comment-triggered only: the code has no path to DM a non-commenter. Opt-in
# kill-switch pair per repo convention; DISABLED always wins over ENABLED.
# Enabling is the standing approval for the MECHANISM; each campaign template
# is approved separately before it enters the campaigns source.
INSTAGRAM_DM_ENABLED=
INSTAGRAM_DM_DISABLED=
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN  any random string you also paste into the
#                                 Meta webhook subscription form
#                                 (openssl rand -hex 24)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET                 the Meta app's App Secret — used ONLY to
#                                 verify X-Hub-Signature-256 on webhooks.
META_APP_SECRET=
